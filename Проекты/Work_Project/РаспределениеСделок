// Бинарный поиск для быстрого выбора договора по кумулятивной вероятности
Функция НайтиИндексБинарно(КумМассив, Значение)

    Левый = 0;
    Правый = КумМассив.Количество() - 1;

    Пока Левый < Правый Цикл
        Средний = (Левый + Правый) / 2;
        Если КумМассив[Средний] < Значение Тогда
            Левый = Средний + 1;
        Иначе
            Правый = Средний;
        КонецЕсли;
    КонецЦикла;

    Возврат Левый;

КонецФункции
