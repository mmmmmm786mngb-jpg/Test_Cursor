// Сложные параметры (такие как ТаблицаЗначений) передаются в обертке XML, и читаются (обработно в ТаблицуЗначений) внутри фонового задания с помощью ДанныеИзXML

#Область ДополнительныеПроцедуры

// Процедура выполняет запрос в фоновом задании.
// Параметры:
//  ПИФ - СправочникСсылка.ПИФ - Ссылка на ПИФ для логирования.
//  СтруктураЗапроса - Структура - Содержит массив текстов запросов и сериализованные параметры.
//  АдресХранилища - Строка - Адрес временного хранилища для результата.
Процедура ВыполнитьЗапросВФоне(ПИФ, СтруктураЗапроса, АдресХранилища) Экспорт
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц; // Менеджер временных таблиц для всех частей запроса
	
	// Десериализация параметров из XML
	ПараметрыЗапроса = ДанныеИзXML(СтруктураЗапроса.ПараметрыXML);
	
	// Создаем объект запроса один раз
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ; // Привязываем МВТ
	
	// Установка параметров один раз перед циклом
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	// Выполняем все запросы, кроме последнего (финального SELECT)
	Для Сч = 0 По СтруктураЗапроса.МассивТекстов.ВГраница() - 1 Цикл
		Запрос.Текст = СтруктураЗапроса.МассивТекстов[Сч]; // Устанавливаем текст для текущей части
		ИдентификаторЛога = РегистрыСведений.d1t_Логирование.НачатьЛогирование(ПИФ, Неопределено, " ___ ____ Подзапрос.Контроль", 7, "№ : " + Сч, Ложь);
		Запрос.Выполнить(); // Выполняем часть запроса
		РегистрыСведений.d1t_Логирование.ЗавершитьЛогирование(ИдентификаторЛога);
	КонецЦикла;
	
	// Финальный запрос для выгрузки результатов
	Запрос.Текст = СтруктураЗапроса.МассивТекстов[СтруктураЗапроса.МассивТекстов.ВГраница()]; // Берем последний запрос из массива
	ИдентификаторЛога = РегистрыСведений.d1t_Логирование.НачатьЛогирование(ПИФ, Неопределено, " ___ ____ Подзапрос.Контроль", 7, "№ : Итоговый", Ложь);
	РезультатЗапроса = Запрос.Выполнить(); // Выполняем финальный SELECT
		РегистрыСведений.d1t_Логирование.ЗавершитьЛогирование(ИдентификаторЛога);
	ТаблицаОстатков = РезультатЗапроса.Выгрузить();
	
	ПоместитьВоВременноеХранилище(ТаблицаОстатков, АдресХранилища);
	
КонецПроцедуры

// Функция сериализует данные в XML-строку.
// Параметры:
//  Данные - Произвольный - Данные для сериализации (структура, массив и т.д.).
// Возвращаемое значение:
//  Строка - XML-строка с сериализованными данными.
Функция XML(Данные)
	
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Данные);
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

// Функция десериализует данные из XML-строки.
// Параметры:
//  Стр - Строка - XML-строка с данными.
// Возвращаемое значение:
//  Произвольный - Десериализованные данные (структура, массив и т.д.).
Функция ДанныеИзXML(Стр)
	
	ЧтениеXML = Новый ЧтениеXML();
	ЧтениеXML.УстановитьСтроку(Стр);
	
	Возврат СериализаторXDTO.ПрочитатьXML(ЧтениеXML); 
	
КонецФункции

// Выполняет запрос в фоновом задании с двумя попытками или синхронно.
// Если задание зависает, оно останавливается, и запускается новая попытка.
// Параметры:
// Запрос - Запрос - Объект запроса с текстом и параметрами.
// ПИФ - СправочникСсылка.ПИФ - Ссылка на ПИФ для логирования.
// Возвращаемое значение:
// ТаблицаЗначений - Результат выгрузки запроса.
Функция ВыполнитьЗапросСФоном_4129У_2_10(Запрос, ПИФ)
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("МассивТекстов", d1t_ТекстЗапроса_ПроверкаСуммКонтрагентовКредитныхОрганизаций_4129У_2_10()); // Изменено: вместо текста передаем массив текстов запросов
	СтруктураЗапроса.Вставить("ПараметрыXML", XML(Запрос.Параметры));
	
	ТаблицаОстатков = Неопределено;
	МаксимумПопыток = 2;
	НомерПопытки = 1;
	
	Пока НомерПопытки <= МаксимумПопыток И ТаблицаОстатков = Неопределено Цикл
		ИдентификаторЛога = РегистрыСведений.d1t_Логирование.НачатьЛогирование(ПИФ, Неопределено, " ___ Запрос.Контроль", 6, "№ попытки: " + НомерПопытки, Ложь);
		
		АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено);
		ПараметрыФона = Новый Массив;
		ПараметрыФона.Добавить(ПИФ);
		ПараметрыФона.Добавить(СтруктураЗапроса);
		ПараметрыФона.Добавить(АдресХранилища);
		
		Информация = "";
		Попытка
			ФоновоеЗадание = ФоновыеЗадания.Выполнить("Удалить_УчетНарушенийСтруктурыИСоставаАктивов.ВыполнитьЗапросВФоне",
				ПараметрыФона,
				Новый УникальныйИдентификатор,
				"Выполнение запроса для проверки 4129У_2_10 (попытка " + НомерПопытки + ")");
			ФоновоеЗаданиеРезультат = ФоновоеЗадание.ОжидатьЗавершенияВыполнения(300);
			
			Если ФоновоеЗаданиеРезультат.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
				ТаблицаОстатков = ПолучитьИзВременногоХранилища(АдресХранилища);
				Информация = "Успешно.";
			ИначеЕсли ФоновоеЗаданиеРезультат.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				ФоновоеЗаданиеРезультат.Отменить();
				Информация = "Отменено.";
			КонецЕсли;
		Исключение
			Информация = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		НомерПопытки = НомерПопытки + 1;
		
		РегистрыСведений.d1t_Логирование.ЗавершитьЛогирование(ИдентификаторЛога, "[" + Информация + "] ");
	КонецЦикла;
	
	Если ТаблицаОстатков = Неопределено Тогда
		ИдентификаторЛога = РегистрыСведений.d1t_Логирование.НачатьЛогирование(ПИФ, Неопределено, " ___ Запрос.Контроль", 6, "Запуск после неудачных попыток.", Ложь);
		РезультатЗапроса = Запрос.Выполнить();
		ТаблицаОстатков = РезультатЗапроса.Выгрузить();
		РегистрыСведений.d1t_Логирование.ЗавершитьЛогирование(ИдентификаторЛога);
	КонецЕсли;
	
	Возврат ТаблицаОстатков;
КонецФункции

#КонецОбласти
