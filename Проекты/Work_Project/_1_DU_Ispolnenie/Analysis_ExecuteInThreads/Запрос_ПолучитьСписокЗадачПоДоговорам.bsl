// Заглушка для имитации результата запроса получения списка задач по договорам
// Используется для тестирования алгоритма распределения при пустой базе данных
//
// Параметры функции:
//   ДатаИсполнения - Дата (не используется в заглушке, но сохраняется для совместимости)
//   РежимЗагрузки - Число (не используется в заглушке, но сохраняется для совместимости)
//   Пул - Неопределено/Массив (не используется в заглушке, но сохраняется для совместимости)
//
// Возвращает: ТаблицаЗначений с колонками:
//   КоличествоЗадач - Число (количество задач по договору)
//   ДоговорДУ - СправочникСсылка.ДоговорДУ (ссылка на договор ДУ)
//
// Примечание:
//   - Результат отсортирован по КоличествоЗадач УБЫВ (от большего к меньшему)
//   - Данные имитируют реальное распределение: 10% больших договоров + резкий спад
//   - Для тестирования создаются договоры с наименованием "ДоговорДУ_Номер"

// Описание: Находит договор ДУ по наименованию "ДоговорДУ_Номер", если не найден - создает новый
// Параметры:
//   Номер - Число - номер договора для формирования наименования
// Возвращаемое значение:
//   СправочникСсылка.ДоговорДУ - ссылка на найденный или созданный договор
Функция НайтиИлиСоздатьДоговорДУ(Номер)
	
	НаименованиеДоговора = "ДоговорДУ_" + Формат(Номер, "ЧГ=");
	
	// Ищем договор по наименованию
	СсылкаДоговора = Справочники.ДоговорДУ.НайтиПоНаименованию(НаименованиеДоговора, Истина);
	
	Если НЕ СсылкаДоговора.Пустая() Тогда
		// Договор найден - возвращаем ссылку
		Возврат СсылкаДоговора;
	Иначе
		// Договор не найден - создаем новый
		ДоговорОбъект = Справочники.ДоговорДУ.СоздатьЭлемент();
		ДоговорОбъект.Наименование = НаименованиеДоговора;
		ДоговорОбъект.Записать();
		
		Возврат ДоговорОбъект.Ссылка;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСписокЗадачПоДоговорам_Заглушка(ДатаИсполнения, РежимЗагрузки, Пул = Неопределено)
	
	// Создаем таблицу значений с тестовыми данными
	// Имитируем распределение: 10% больших договоров + резкий спад
	// Пример: 500, 300, 200, 150, 100, 100, 100, 100, 90, 90, 80, 50, 50, 30, 20, 10, 10, 5
	
	СписокЗадач = Новый ТаблицаЗначений;
	СписокЗадач.Колонки.Добавить("КоличествоЗадач", Новый ОписаниеТипов("Число"));
	СписокЗадач.Колонки.Добавить("ДоговорДУ", Новый ОписаниеТипов("СправочникСсылка.ДоговорДУ"));
	
	// Тестовые данные: веса договоров (от большего к меньшему)
	МассивВесов = Новый Массив;
	МассивВесов.Добавить(500); // Большой договор 1
	МассивВесов.Добавить(300); // Большой договор 2
	МассивВесов.Добавить(200); // Средний договор 1
	МассивВесов.Добавить(150); // Средний договор 2
	МассивВесов.Добавить(100); // Типичный договор 1
	МассивВесов.Добавить(100); // Типичный договор 2
	МассивВесов.Добавить(100); // Типичный договор 3
	МассивВесов.Добавить(100); // Типичный договор 4
	МассивВесов.Добавить(90); // Малый договор 1
	МассивВесов.Добавить(90); // Малый договор 2
	МассивВесов.Добавить(80); // Малый договор 3
	МассивВесов.Добавить(50); // Малый договор 4
	МассивВесов.Добавить(50); // Малый договор 5
	МассивВесов.Добавить(30); // Очень малый договор 1
	МассивВесов.Добавить(20); // Очень малый договор 2
	МассивВесов.Добавить(10); // Очень малый договор 3
	МассивВесов.Добавить(10); // Очень малый договор 4
	МассивВесов.Добавить(5); // Минимальный договор
	
	// Заполняем таблицу тестовыми данными
	НомерДоговора = 1;
	Для Каждого Вес Из МассивВесов Цикл
		НоваяСтрока = СписокЗадач.Добавить();
		НоваяСтрока.КоличествоЗадач = Вес;
		// Находим или создаем договор с наименованием "ДоговорДУ_Номер"
		НоваяСтрока.ДоговорДУ = НайтиИлиСоздатьДоговорДУ(НомерДоговора);
		НомерДоговора = НомерДоговора + 1;
	КонецЦикла;
	
	// Сортируем по убыванию (как в реальном запросе)
	СписокЗадач.Сортировать("КоличествоЗадач УБЫВ");
	
	Возврат СписокЗадач;
	
КонецФункции

