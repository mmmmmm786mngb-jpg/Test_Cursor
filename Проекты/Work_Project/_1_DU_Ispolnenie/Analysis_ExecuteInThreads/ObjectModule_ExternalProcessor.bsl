Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	// MPazhukov IMAPPS-11733
	//Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда Возврат; КонецЕсли;
	Если Найти(ИдентификаторКоманды, "ФоновоеВыполнение") = 0 Тогда Возврат; КонецЕсли;
	
	ДатаИсполнения = ТекущаяДата();
	
	// MPazhukov IMAPPS-12997
	Если ИдентификаторКоманды = "ФоновоеВыполнение_ПотоковоеИсполнениеСделок" Тогда
		ВыполнитьСделкиПотоки(ПараметрыВыполненияКоманды);
		Возврат;
	КонецЕсли;
	// MPazhukov IMAPPS-12997
	
	// IMAPPS-16444 -->
	Если ИдентификаторКоманды = "ФоновоеВыполнениеПотоковое_ТМинус1" Тогда
		ДатаИсполнения = ТекущаяДата() - 86400;
		ВыполнитьСделкиПотоки(ПараметрыВыполненияКоманды, "На Т-1");
		Возврат;
	КонецЕсли;
	// IMAPPS-16444 <-
	
	Если ИдентификаторКоманды = "ФоновоеВыполнение_ПотоковоеИсполнениеСделокПул" Тогда
		ДатаИсполнения = НачалоДня(ТекущаяДата());
		ВыполнитьСделкиПотоки(ПараметрыВыполненияКоманды, "Пул");
		Возврат;
	КонецЕсли;
	
	//// MPazhukov IMAPPS-11733
	//Если ИдентификаторКоманды = "ФоновоеВыполнение_ТМинус1" Тогда
	//	ДатаИсполнения = ТекущаяДата() - 86400;
	//КонецЕсли;
	//// MPazhukov IMAPPS-11733
	
	ВыполнитьСделки(Истина, , ПараметрыВыполненияКоманды);
КонецПроцедуры

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда Возврат "<Настройки не установлены>"; КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	
	ПредставлениеНастроек = "";
	
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
	
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек = "") Экспорт
	
	Если Настройки.Свойство("Значения") Тогда
		
		Почта = Неопределено;
		Если Настройки.Значения.Свойство("ПочтовыйЛогин", Почта) Тогда
			ПочтовыйЛогин = Почта;
			
			Ящики = XMLЗначение(Тип("ХранилищеЗначения"), Настройки.Значения.СписокРассылки);
			СписокРассылки.Загрузить(Ящики.Получить());
			
		КонецЕсли;
		
		Настройка = Неопределено;
		Если Настройки.Значения.Свойство("Пулы", Настройка) Тогда
			
			СписокПул = XMLЗначение(Тип("ХранилищеЗначения"), Настройки.Значения.Пулы);
			Пулы.Загрузить(СписокПул.Получить());
			
		КонецЕсли;
		
		РежимЗагрузки = Настройки.Значения.РежимЗагрузки;
		КоличествоПотоков = Настройки.Значения.КоличествоПотоков;
		
		ПредставлениеНастроек = "Период с:" + Формат(ДатаИсполнения, "ДФ=dd.MM.yyyy");
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПропискаРассылки(Знач НомерРассылки)
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции // ПропискаРассылки()

Процедура ВыполнитьСделкиВПотоках(ПроверкаВыполнения = Истина, Отказ = Ложь, Комментарий = "", Пул = Неопределено) Экспорт
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ДатаИсполнения", ДатаИсполнения);
	
	Потоки = Новый ТаблицаЗначений;
	Потоки = РаспределитьЗадачиПоПотокам(ДатаИсполнения, КоличествоПотоков, Пул);
	
	МассивЗаданий = Новый Массив;
	
	Для Сч = 0 По КоличествоПотоков - 1 Цикл
		
		СписокДоговоров = Потоки[Сч].МассивДоговоров;
		
		ПараметрыЗадания.Вставить("СписокДоговор", СписокДоговоров);
		Сообщить("Старт задания");
		ПараметрыФоновогоЗадания = Новый Массив;
		ПараметрыФоновогоЗадания.Добавить(ПараметрыЗадания);
		Задание = ФоновыеЗадания.Выполнить("VTB_ОбщийМодуль.ВыполнитьИсполнениеСделокПоСпискуДоговорДУ"
				, ПараметрыФоновогоЗадания
				, Новый УникальныйИдентификатор
				, "№ " + Строка(сч) + " Исполнение сделок за " + Формат(ДатаИсполнения, "ДФ=dd.MM.yyyy"));
		
		МассивЗаданий.Добавить(Задание.УникальныйИдентификатор);
		
	КонецЦикла;
	
	Если ПроверкаВыполнения Тогда
		
		ВсеЗаданияВыполнены = Ложь;
		МассивСообщенийИзЗадания = Новый Массив;
		
		Пока ВсеЗаданияВыполнены = Ложь Цикл
			
			МассивУдалить = Новый Массив;
			Для Каждого Элемент Из МассивЗаданий Цикл
				
				ТекущееЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Элемент);
				Если ТекущееЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
					Продолжить;
				Иначе
					МассивУдалить.Добавить(Элемент);
					СообщенияЗадания = ТекущееЗадание.ПолучитьСообщенияПользователю(Истина);
					тмпСообщенияЗадания = Новый Массив(СообщенияЗадания);
					Для Каждого Элемент Из тмпСообщенияЗадания Цикл
						// IMAPPS-14628 -->
						Если СтрНайти(Элемент.Текст, "Причина отказа") = 0 Тогда
							Продолжить;
						КонецЕсли;
						// IMAPPS-14628 <--
						МассивСообщенийИзЗадания.Добавить(Элемент.Текст);
					КонецЦикла;
				КонецЕсли;
				
			КонецЦикла;
			
			Для Каждого Элемент Из МассивУдалить Цикл
				Индекс = МассивЗаданий.Найти(Элемент);
				МассивЗаданий.Удалить(Индекс);
			КонецЦикла;
			
			ВсеЗаданияВыполнены = МассивЗаданий.Количество() = 0;
			
		КонецЦикла;
		
		Для Каждого Элемент Из МассивСообщенийИзЗадания Цикл
			Комментарий = Комментарий + Символы.ПС + Элемент;
		КонецЦикла;
		
		Отказ = МассивСообщенийИзЗадания.Количество() > 0;
		
		Комментарий = Комментарий + Символы.ПС + "Все фоновые задания выполнены";
		
	КонецЕсли;
	
КонецПроцедуры

Функция РасчетПродолжительности(Дата1, Дата2)
	
	Разность = Дата2 - Дата1;
	Часов = Цел(Разность / 3600);
	ВсегоМинут = Разность - Часов * 3600;
	Минут = Цел((ВсегоМинут) / 60);
	Секунд = ВсегоМинут - Минут * 60;
	
	ИтогоВремя = "" + Часов + ":" + Формат(Минут, "ЧЦ=2; ЧН=; ЧВН=") + ":" + Формат(Секунд, "ЧЦ=2; ЧН=; ЧВН=");
	
	Возврат Новый Структура("Начало, Конец, Продолжительность", Дата1, Дата2, ИтогоВремя);
	
КонецФункции

Процедура ВыполнитьСделкиПотоки(ПараметрыВыполненияКоманды, ОпределениеЗапуска = "")
	
	ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	// IMAPPS-16444 -->
	ЗамерВремениНачало = ТекущаяДата();
	// IMAPPS-16444 <--
	
	// MPazhukov IMDEV-4405
	Попытка
		РассчитатьКомиссиюОбороотовВБизнесПроцессах();
	Исключение
		Описание = ОписаниеОшибки();
		ОтправитьСообщениеОбОшибкеПриРасчетеКомиссии(Описание);
	КонецПопытки;
	// MPazhukov IMDEV-4405
	
	СписокПулов = Неопределено;
	Если ОпределениеЗапуска = "Пул" Тогда
		СписокПулов = Пулы.ВыгрузитьКолонку("Пул");
	КонецЕсли;
	
	Отказ = Ложь;
	КомментарийПотоки = "";
	ВыполнитьСделкиВПотоках(Истина, Отказ, КомментарийПотоки, СписокПулов);
	
	// IMAPPS-16444 -->
	ОтветПродолительность = РасчетПродолжительности(ЗамерВремениНачало, ТекущаяДата());
	// IMAPPS-16444 <--
	
	ДопОбработка = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка;
	Задача = Задачи.ЗадачаИнтеграции.СоздатьЗадачу();
	Задача.Дата = ТекущаяДата();
	Задача.ВидОбмена = ДопОбработка;
	Задача.ВерсияОбработки = ОбщегоНазначения.ПолучитьЗначениеРеквизита(ДопОбработка, "Версия");
	Задача.Наименование = "Исполнение сделок T+2 (потоки)";
	
	Если Отказ Тогда
		Уровень = УровеньЖурналаРегистрации.Ошибка;
		Комментарий = "Во время исполнения плановых позиций произошла ошибка: ";
	Иначе
		Уровень = УровеньЖурналаРегистрации.Информация;
		Комментарий = "Исполнение плановых позиций выполнено успешно";
	КонецЕсли;
	
	Если РежимЗагрузки = 1 Тогда
		Комментарий = Комментарий + Символы.ПС + Символы.ПС + "Загрузка только физ.лиц" + Символы.ПС;
	ИначеЕсли РежимЗагрузки = 2 Тогда
		Комментарий = Комментарий + Символы.ПС + Символы.ПС + "Загрузка только юр.лиц" + Символы.ПС;
	КонецЕсли;
	
	Комментарий = Комментарий + Символы.ПС +
		"Начало: " + ОтветПродолительность.Начало + Символы.ПС +
		"Конец: " + ОтветПродолительность.Конец + Символы.ПС +
		"Продолжительность: " + ОтветПродолительность.Продолжительность + Символы.ПС;
	
	Комментарий = Комментарий + Символы.ПС + КомментарийПотоки;
	
	Если СписокРассылки.Количество() > 0 И НЕ ПочтовыйЛогин.Пустая() Тогда
		Если НЕ ЗначениеЗаполнено(ОпределениеЗапуска) Тогда
			ОпределениеЗапуска = "На текущую дату";
			ПрипискаРассылки = "r2.1";
		ИначеЕсли ОпределениеЗапуска = "Пул" Тогда
			ОпределениеЗапуска = "Пулы";
			ПрипискаРассылки = "r2.3";
		Иначе
			ПрипискаРассылки = "r2.2";
		КонецЕсли;
		
		ТемаСообщения = "Аванкор ДУ: Фоновое исполнение сделок T+n (Потоковое выполнение) " + ОпределениеЗапуска + " (" + Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm:ss'; ДП=") + ")";
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, Вложения, Важность");
		ПараметрыПисьма.Тема = ?(Отказ, "{FAIL} ", "{OK} ") + ТемаСообщения + ПропискаРассылки(ПрипискаРассылки);
		
		Кому = Новый Массив;
		Для Каждого ТекЯщик Из СписокРассылки Цикл
			Кому.Добавить(Новый Структура("Адрес, Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
			// текстРассылки = текстРассылки+ТекЯщик.АдресЭлектроннойПочты;
		КонецЦикла;
		
		ПараметрыПисьма.Вложения = Новый Соответствие;
		ПараметрыПисьма.Кому = Кому;
		ПараметрыПисьма.Тело = Комментарий;
		ПараметрыПисьма.Важность = ?(Отказ, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
		
		Попытка
			РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
			ТекстРассылки = "Рассылка завершена";
		Исключение
			ТекстРассылки = "Рассылка не удалась: ";
			Сообщения = ПолучитьСообщенияПользователю(Истина);
			Для Каждого Элемент Из Сообщения Цикл
				// IMAPPS-14628 -->
				Если СтрНайти(Элемент.Текст, "Причина отказа") = 0 Тогда
					Продолжить;
				КонецЕсли;
				// IMAPPS-14628 <--
				ТекстРассылки = ТекстРассылки + Символы.ПС + Элемент.Текст;
			КонецЦикла;
		КонецПопытки;
	КонецЕсли;
	
	// Запись в журнал регистрации
	Комментарий = Комментарий + Символы.ПС + Комментарий;
	ЗаписьЖурналаРегистрации("Фоновое исполнение сделок Т+n (потоки)", Уровень, , , Комментарий);
	
	Задача.Описание = Задача.Описание + Символы.ПС + текстРассылки;
	Задача.ВыполнитьЗадачу();
	
	
КонецПроцедуры

