Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	// MPazhukov IMAPPS-11733
	//Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда Возврат; КонецЕсли;
	Если Найти(ИдентификаторКоманды, "ФоновоеВыполнение") = 0 Тогда Возврат; КонецЕсли;
	
	ДатаИсполнения = ТекущаяДата();
	
	// MPazhukov IMAPPS-12997
	Если ИдентификаторКоманды = "ФоновоеВыполнение_ПотоковоеИсполнениеСделок" Тогда
		ВыполнитьСделкиПотоки(ПараметрыВыполненияКоманды);
		Возврат;
	КонецЕсли;
	// MPazhukov IMAPPS-12997
	
	// IMAPPS-16444 -->
	Если ИдентификаторКоманды = "ФоновоеВыполнениеПотоковое_ТМинус1" Тогда
		ДатаИсполнения = ТекущаяДата() - 86400;
		ВыполнитьСделкиПотоки(ПараметрыВыполненияКоманды, "На Т-1");
		Возврат;
	КонецЕсли;
	// IMAPPS-16444 <-
	
	Если ИдентификаторКоманды = "ФоновоеВыполнение_ПотоковоеИсполнениеСделокПул" Тогда
		ДатаИсполнения = НачалоДня(ТекущаяДата());
		ВыполнитьСделкиПотоки(ПараметрыВыполненияКоманды, "Пул");
		Возврат;
	КонецЕсли;
	
	//// MPazhukov IMAPPS-11733
	//Если ИдентификаторКоманды = "ФоновоеВыполнение_ТМинус1" Тогда
	//	ДатаИсполнения = ТекущаяДата() - 86400;
	//КонецЕсли;
	//// MPazhukov IMAPPS-11733
	
	ВыполнитьСделки(Истина, , ПараметрыВыполненияКоманды);
КонецПроцедуры

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда Возврат "<Настройки не установлены>"; КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	
	ПредставлениеНастроек = "";
	
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
	
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек = "") Экспорт
	
	Если Настройки.Свойство("Значения") Тогда
		
		Почта = Неопределено;
		Если Настройки.Значения.Свойство("ПочтовыйЛогин", Почта) Тогда
			ПочтовыйЛогин = Почта;
			
			Ящики = XMLЗначение(Тип("ХранилищеЗначения"), Настройки.Значения.СписокРассылки);
			СписокРассылки.Загрузить(Ящики.Получить());
			
		КонецЕсли;
		
		Настройка = Неопределено;
		Если Настройки.Значения.Свойство("Пулы", Настройка) Тогда
			
			СписокПул = XMLЗначение(Тип("ХранилищеЗначения"), Настройки.Значения.Пулы);
			Пулы.Загрузить(СписокПул.Получить());
			
		КонецЕсли;
		
		РежимЗагрузки = Настройки.Значения.РежимЗагрузки;
		КоличествоПотоков = Настройки.Значения.КоличествоПотоков;
		
		ПредставлениеНастроек = "Период с:" + Формат(ДатаИсполнения, "ДФ=dd.MM.yyyy");
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПропискаРассылки(Знач НомерРассылки)
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
		// Ошибка получения параметров подключения - игнорируем
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции // ПропискаРассылки()

Процедура ВыполнитьСделки(ФоновоеИсполнение = Ложь, ЗначенияНастроек = Неопределено, ПараметрыВыполненияКоманды = Неопределено) Экспорт
	
	//ДатаИсполнения = ТекущаяДата();
	//Сообщить("Исполнение плановых позиций");
	
	Если ПолныеПрава.РежимОтладки() Тогда
		Сообщить("Исполнение плановых позиций");
	КонецЕсли;
	
	Отказ = Ложь;
	ТекстОтказа = "";
	
	БизнесПроцессы.СделкиTn.ИсполнениеПлановойПозиции(ДатаИсполнения, Отказ, ТекстОтказа);
	АвтоматическиВыполнитьЗадачиПоСделкеРЕПО(ДатаИсполнения, Отказ, ТекстОтказа);
	
	Если ФоновоеИсполнение <> Ложь Тогда
		ДопОбработка = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка;
		Задача = Задачи.ЗадачаИнтеграции.СоздатьЗадачу();
		Задача.Дата = ТекущаяДата();
		//
		Задача.ВидОбмена = ДопОбработка;
		Задача.ВерсияОбработки = ОбщегоНазначения.ПолучитьЗначениеРеквизита(ДопОбработка, "Версия");
		Задача.Наименование = "Исполнение сделок T+2";
	КонецЕсли;
	
	Если Отказ Тогда
		Уровень = УровеньЖурналаРегистрации.Ошибка;
		Комментарий = "Во время исполнения плановых позиций произошла ошибка: " + ТекстОтказа;
	Иначе
		Уровень = УровеньЖурналаРегистрации.Информация;
		Комментарий = "Исполнение плановых позиций выполнено успешно";
	КонецЕсли;
	
	Если НЕ ФоновоеИсполнение Тогда
		Сообщить(Комментарий);
	Иначе
		МассивСообщений = ПолучитьСообщенияПользователю(Истина);
		Для Каждого Сообщение Из МассивСообщений Цикл
			// IMAPPS-14628 -->
			Если СтрНайти(Сообщение.Текст, "Причина отказа") = 0 Тогда
				Продолжить;
			КонецЕсли;
			// IMAPPS-14628 <--
			Комментарий = Комментарий + Символы.ПС + Сообщение.Текст;
		КонецЦикла;
		ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
		
		Если СписокРассылки.Количество() > 0 И НЕ ПочтовыйЛогин.Пустая() Тогда
			ТемаСообщения = "Аванкор ДУ: Фоновое исполнение сделок T+n (" + Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm:ss'; ДП=") + ")";
			
			ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, Вложения, Важность");
			ПараметрыПисьма.Тема = ?(Отказ, "{FAIL} ", "{OK} ") + ТемаСообщения + ПропискаРассылки("r2.0");
			
			Кому = Новый Массив;
			Для Каждого ТекЯщик Из СписокРассылки Цикл
				Кому.Добавить(Новый Структура("Адрес, Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
				// текстРассылки = текстРассылки+ТекЯщик.АдресЭлектроннойПочты;
			КонецЦикла;
			
			ПараметрыПисьма.Вложения = Новый Соответствие;
			ПараметрыПисьма.Кому = Кому;
			ПараметрыПисьма.Тело = Комментарий;
			ПараметрыПисьма.Важность = ?(Отказ, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
			
			Попытка
				РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
				ТекстРассылки = "Рассылка завершена";
			Исключение
				ТекстРассылки = "Рассылка не удалась: ";
				Сообщения = ПолучитьСообщенияПользователю(Истина);
				Для Каждого Элемент Из Сообщения Цикл
					// IMAPPS-14628 -->
					Если СтрНайти(Элемент.Текст, "Причина отказа") = 0 Тогда
						Продолжить;
					КонецЕсли;
					// IMAPPS-14628 <--
					ТекстРассылки = ТекстРассылки + Символы.ПС + Элемент.Текст;
				КонецЦикла;
			КонецПопытки;
		КонецЕсли;
		
		// Запись в журнал регистрации
		Комментарий = Комментарий + Символы.ПС + Комментарий;
		ЗаписьЖурналаРегистрации("Фоновое исполнение сделок Т+n", Уровень, , , Комментарий);
		
	КонецЕсли;
	Если ФоновоеИсполнение <> Ложь Тогда
		Задача.Описание = Задача.Описание + Символы.ПС + текстРассылки;
		Задача.ВыполнитьЗадачу();
	КонецЕсли;
	
КонецПроцедуры

// ========== ИЗМЕНЕНА ПРОЦЕДУРА: ВыполнитьСделкиВПотоках ==========
// ИЗМЕНЕНИЯ: Динамическое управление запуском потоков вместо одновременного запуска всех
// УДАЛЕНО: Одновременный запуск всех N потоков
// УДАЛЕНО: Использование МассивЗаданий с УИД для поиска заданий
// ДОБАВЛЕНО: Использование Соответствия для хранения ссылок на фоновые задания (ключ: ИндексПотока)
// ДОБАВЛЕНО: Динамическое управление количеством одновременно работающих потоков (N до 2*N)
// ДОБАВЛЕНО: Адаптация на основе скорости выполнения
// ИЗМЕНЕНО: Использование ТекущаяДатаСеанса() вместо ТекущаяДата() (для измерения времени в цикле)
// ИЗМЕНЕНО: Динамическая пауза (от 0.1 до 1.0 секунды)
Процедура ВыполнитьСделкиВПотоках(ПроверкаВыполнения = Истина, Отказ = Ложь, Комментарий = "", Пул = Неопределено) Экспорт
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ДатаИсполнения", ДатаИсполнения);
	
	// 1. Создать все потоки заранее
	Потоки = РаспределитьЗадачиПоПотокам(ДатаИсполнения, КоличествоПотоков, Пул);
	// Потоков может быть 60+
	
	Если Потоки.Количество() = 0 Тогда
		Комментарий = Комментарий + Символы.ПС + "Нет задач для выполнения";
		Возврат;
	КонецЕсли;
	
	// 2. Создать структуру для управления потоками
	СтруктураПотоков = Новый Структура;
	СтруктураПотоков.Вставить("ВсеПотоки", Потоки);
	СтруктураПотоков.Вставить("АктивныеЗадания", Новый Соответствие); // Ключ: ИндексПотока, Значение: УникальныйИдентификатор
	СтруктураПотоков.Вставить("ИндексСледующегоПотока", 0);
	СтруктураПотоков.Вставить("ЦелевоеКоличествоАктивных", КоличествоПотоков); // Начальное = N
	СтруктураПотоков.Вставить("ВремяНачалаПериода", ТекущаяДатаСеанса());
	СтруктураПотоков.Вставить("КоличествоЗавершенныхВПериод", 0);
	СтруктураПотоков.Вставить("ПредыдущееКоличествоЗавершенных", 0);
	СтруктураПотоков.Вставить("ТекущаяПауза", 1.0); // Начальная пауза = 1 секунда
	
	МассивСообщенийИзЗадания = Новый Массив;
	
	// 3. Начальный запуск N потоков
	Для Сч = 0 По КоличествоПотоков - 1 Цикл
		Если Сч >= Потоки.Количество() Тогда
			Прервать; // Если потоков меньше чем N
		КонецЕсли;
		ЗапуститьПоток(СтруктураПотоков, Сч, ПараметрыЗадания, МассивСообщенийИзЗадания);
	КонецЦикла;
	
	// 4. Цикл ожидания с динамическим управлением
	Если ПроверкаВыполнения Тогда
		
		Пока СтруктураПотоков.ИндексСледующегоПотока < Потоки.Количество()
			ИЛИ СтруктураПотоков.АктивныеЗадания.Количество() > 0 Цикл
			
			// Проверка состояния активных потоков
			МассивЗавершенныхИндексов = Новый Массив;
			
			Для Каждого ЭлементСоответствия Из СтруктураПотоков.АктивныеЗадания Цикл
				
				ИндексПотока = ЭлементСоответствия.Ключ;
				УИДЗадания = ЭлементСоответствия.Значение;
				
				// Перечитываем задание по УИД для получения актуального статуса
				Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(УИДЗадания);
				
				Если Задание = Неопределено Тогда
					// Задание удалено или не найдено - считаем завершенным
					МассивЗавершенныхИндексов.Добавить(ИндексПотока);
					Продолжить;
				КонецЕсли;
				
				Если Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
					// Поток завершен
					МассивЗавершенныхИндексов.Добавить(ИндексПотока);
					ОбработатьЗавершенныйПоток(Задание, СтруктураПотоков, МассивСообщенийИзЗадания);
				КонецЕсли;
				
			КонецЦикла;
			
			// Удалить завершенные из активных
			Для Каждого ИндексПотока Из МассивЗавершенныхИндексов Цикл
				СтруктураПотоков.АктивныеЗадания.Удалить(ИндексПотока);
			КонецЦикла;
			
			// В КОНЦЕ ЦИКЛА: Принять решение о количестве одновременно работающих
			ПринятьРешениеОКоличествеПотоков(СтруктураПотоков, КоличествоПотоков);
			
			// Запустить новые потоки, если есть свободные слоты
			Пока СтруктураПотоков.АктивныеЗадания.Количество() < СтруктураПотоков.ЦелевоеКоличествоАктивных
				И СтруктураПотоков.ИндексСледующегоПотока < Потоки.Количество() Цикл
				
				ЗапуститьПоток(СтруктураПотоков, СтруктураПотоков.ИндексСледующегоПотока, ПараметрыЗадания, МассивСообщенийИзЗадания);
				СтруктураПотоков.ИндексСледующегоПотока = СтруктураПотоков.ИндексСледующегоПотока + 1;
				
			КонецЦикла;
			
			// Динамическая пауза (от 0.1 до текущего значения)
			VTB_ОбщийМодуль.Пауза(СтруктураПотоков.ТекущаяПауза);
			
		КонецЦикла;
		
		// Обработка финальных результатов
		Для Каждого Элемент Из МассивСообщенийИзЗадания Цикл
			Комментарий = Комментарий + Символы.ПС + Элемент;
		КонецЦикла;
		
		Отказ = МассивСообщенийИзЗадания.Количество() > 0;
		
		Комментарий = Комментарий + Символы.ПС + "Все фоновые задания выполнены";
		
	КонецЕсли;
	
КонецПроцедуры
// ========== КОНЕЦ ИЗМЕНЕННОЙ ПРОЦЕДУРЫ: ВыполнитьСделкиВПотоках ==========

// ========== НОВАЯ ПРОЦЕДУРА: ЗапуститьПоток ==========
// Описание: Запускает один поток из очереди
// Параметры:
//   СтруктураПотоков - Структура (изменяется внутри функции)
//   ИндексПотока - Число (индекс потока в таблице)
//   ПараметрыЗадания - Структура (параметры для фонового задания)
//   МассивСообщенийИзЗадания - Массив (для сбора сообщений об ошибках)
Процедура ЗапуститьПоток(СтруктураПотоков, ИндексПотока, ПараметрыЗадания, МассивСообщенийИзЗадания)
	
	Если ИндексПотока >= СтруктураПотоков.ВсеПотоки.Количество() Тогда
		Возврат; // Все потоки уже запущены
	КонецЕсли;
	
	ТекущийПоток = СтруктураПотоков.ВсеПотоки[ИндексПотока];
	СписокДоговоров = ТекущийПоток.МассивДоговоров;
	
	Если СписокДоговоров.Количество() = 0 Тогда
		Возврат; // Пустой поток
	КонецЕсли;
	
	// Создать копию параметров для этого потока
	ПараметрыПотока = Новый Структура;
	ПараметрыПотока.Вставить("ДатаИсполнения", ПараметрыЗадания.ДатаИсполнения);
	ПараметрыПотока.Вставить("СписокДоговор", СписокДоговоров);
	
	ПараметрыФоновогоЗадания = Новый Массив;
	ПараметрыФоновогоЗадания.Добавить(ПараметрыПотока);
	
	Задание = ФоновыеЗадания.Выполнить(
			"VTB_ОбщийМодуль.ВыполнитьИсполнениеСделокПоСпискуДоговорДУ",
			ПараметрыФоновогоЗадания,
			Новый УникальныйИдентификатор,
			"№ " + Строка(ИндексПотока) + " Исполнение сделок за " + Формат(ПараметрыЗадания.ДатаИсполнения, "ДФ=dd.MM.yyyy")
		);
	
	// Сохраняем УИД задания в Соответствии (ключ - индекс потока)
	СтруктураПотоков.АктивныеЗадания.Вставить(ИндексПотока, Задание.УникальныйИдентификатор);
	
КонецПроцедуры
// ========== КОНЕЦ НОВОЙ ПРОЦЕДУРЫ: ЗапуститьПоток ==========

// ========== НОВАЯ ПРОЦЕДУРА: ОбработатьЗавершенныйПоток ==========
// Описание: Обрабатывает завершенный поток и собирает сообщения об ошибках
// Параметры:
//   Задание - ФоновоеЗадание (ссылка на завершенное задание)
//   СтруктураПотоков - Структура (изменяется внутри функции)
//   МассивСообщенийИзЗадания - Массив (для сбора сообщений об ошибках)
Процедура ОбработатьЗавершенныйПоток(Задание, СтруктураПотоков, МассивСообщенийИзЗадания)
	
	СтруктураПотоков.КоличествоЗавершенныхВПериод = СтруктураПотоков.КоличествоЗавершенныхВПериод + 1;
	
	// Собрать сообщения об ошибках (как в текущей реализации)
	СообщенияЗадания = Задание.ПолучитьСообщенияПользователю(Истина);
	тмпСообщенияЗадания = Новый Массив(СообщенияЗадания);
	Для Каждого Элемент Из тмпСообщенияЗадания Цикл
		// IMAPPS-14628 -->
		Если СтрНайти(Элемент.Текст, "Причина отказа") = 0 Тогда
			Продолжить;
		КонецЕсли;
		// IMAPPS-14628 <--
		МассивСообщенийИзЗадания.Добавить(Элемент.Текст);
	КонецЦикла;
	
КонецПроцедуры
