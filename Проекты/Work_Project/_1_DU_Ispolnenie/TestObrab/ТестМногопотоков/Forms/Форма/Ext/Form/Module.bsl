	// Сортируем по убыванию (как в реальном запросе)
	СписокЗадач.Сортировать("КоличествоЗадач УБЫВ");
	
	Возврат СписокЗадач;
	
КонецФункции

Функция НайтиИлиСоздатьДоговорДУ(Номер)
	
	НаименованиеДоговора = "ДоговорДУ_" + Формат(Номер, "ЧГ=");
	
	// Ищем договор по наименованию
	СсылкаДоговора = Справочники.ДоговорДУ.НайтиПоНаименованию(НаименованиеДоговора, Истина);
	
	Если НЕ СсылкаДоговора.Пустая() Тогда
		// Договор найден - возвращаем ссылку
		Возврат СсылкаДоговора;
	Иначе
		// Договор не найден - создаем новый
		ДоговорОбъект = Справочники.ДоговорДУ.СоздатьЭлемент();
		ДоговорОбъект.Наименование = НаименованиеДоговора;
		ДоговорОбъект.Записать();
		
		Возврат ДоговорОбъект.Ссылка;
	КонецЕсли;
	
КонецФункции

