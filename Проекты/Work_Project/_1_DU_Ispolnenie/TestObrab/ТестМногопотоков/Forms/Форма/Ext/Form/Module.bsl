			// Скорость текущая
			Если ИзменениеПараметра.Свойство("СкоростьТекущая") Тогда
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИзменениеПараметра.СкоростьТекущая, "ЧГ=") + " пот/мин", 13, Истина) + " | ";
			Иначе
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку("-", 13, Истина) + " | ";
