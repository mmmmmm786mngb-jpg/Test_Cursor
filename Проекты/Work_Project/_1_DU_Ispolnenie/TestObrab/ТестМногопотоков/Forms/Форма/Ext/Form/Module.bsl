&НаСервере
Процедура TestНаСервере(ОпределениеЗапуска = "")
	СписокПулов = Неопределено;
	Если ОпределениеЗапуска = "Пул" Тогда
		СписокПулов = Объект.Пулы.ВыгрузитьКолонку("Пул");
	КонецЕсли;
	
	Отказ = Ложь;
	КомментарийПотоки = "";
	ВыполнитьСделкиВПотоках(Истина, Отказ, КомментарийПотоки, СписокПулов, Истина);
	Сообщить(КомментарийПотоки);
КонецПроцедуры

&НаКлиенте
Процедура Test(Команда)
	TestНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.КоличествоПотоков = 8;
	Объект.ДатаИсполнения = ТекущаяДатаСеанса();
КонецПроцедуры

#Область ОРИГИНАЛ

// Описание: Выполняет исполнение сделок в параллельных потоках с динамическим управлением нагрузкой.
//           Распределяет договоры по потокам на основе статистического анализа весов (Q1 + 1.5×IQR).
//           Автоматически регулирует количество одновременно работающих потоков в зависимости от скорости выполнения.
//
// Параметры:
//   ПроверкаВыполнения - Булево - Истина для ожидания завершения всех потоков (по умолчанию: Истина)
//   Отказ - Булево - возвращает Истина при наличии ошибок (изменяется внутри процедуры, по умолчанию: Ложь)
//   Комментарий - Строка - возвращает сообщения об ошибках и отчет (изменяется внутри процедуры, по умолчанию: "")
//   Пул - Массив - фильтр по пулам договоров (необязательный, по умолчанию: Неопределено)
//   ВключеноЛогирование - Булево - Истина для включения детального логирования работы потоков (по умолчанию: Ложь)
//
Процедура ВыполнитьСделкиВПотоках(ПроверкаВыполнения = Истина, Отказ = Ложь, Комментарий = "", Пул = Неопределено, ВключеноЛогирование = Ложь) Экспорт
	// !!! ВЫПИЛИТЬ ПЕРЕД ПЕРЕНОСОМ В КОНФИГУРАЦИЮ, НУЖЕН ИЗ_ЗА ТОГО ЧТО ЭТО МОДУЛЬ ФОРМЫ !!!
	ДатаИсполнения = Объект.ДатаИсполнения;
	КоличествоПотоков = Объект.КоличествоПотоков;
	// !!! ВЫПИЛИТЬ ПЕРЕД ПЕРЕНОСОМ В КОНФИГУРАЦИЮ, НУЖЕН ИЗ_ЗА ТОГО ЧТО ЭТО МОДУЛЬ ФОРМЫ !!!
	
	ЛогиРаботы = Неопределено;
	Если ВключеноЛогирование Тогда
		ЛогиРаботы = Новый Структура;
		ЛогиРаботы.Вставить("ВремяНачала", ТекущаяДатаСеанса());
		ЛогиРаботы.Вставить("ВремяОкончания", Неопределено);
		ЛогиРаботы.Вставить("ОбщаяИнформация", Новый Структура);
		ЛогиРаботы.Вставить("События", Новый Массив);
		ЛогиРаботы.Вставить("Потоки", Новый Массив);
		ЛогиРаботы.Вставить("ИзмененияПараметров", Новый Массив);
		
		ЛогиРаботы.ОбщаяИнформация.Вставить("БазовоеКоличествоПотоков", КоличествоПотоков);
		ЛогиРаботы.ОбщаяИнформация.Вставить("ДатаИсполнения", ДатаИсполнения);
		ЛогиРаботы.ОбщаяИнформация.Вставить("КоличествоЗапущенныхФоновыхЗаданий", 0);
	КонецЕсли;
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ДатаИсполнения", ДатаИсполнения);
	
	СтатистикаРаспределения = РаспределитьЗадачиПоПотокам(ДатаИсполнения, КоличествоПотоков, Пул);
	Потоки = СтатистикаРаспределения.Потоки;
	
	Если Потоки.Количество() = 0 Тогда
		Комментарий = Комментарий + Символы.ПС + "Нет задач для выполнения";
		Возврат;
	КонецЕсли;
	
	Если ВключеноЛогирование Тогда
		ЛогиРаботы.ОбщаяИнформация.Вставить("ОбщееКоличествоСозданныхПотоков", Потоки.Количество());
		ЛогиРаботы.ОбщаяИнформация.Вставить("ЦелевойВесПотока", СтатистикаРаспределения.ЦелевойВес);
		ЛогиРаботы.ОбщаяИнформация.Вставить("СреднийВесДоговоров", СтатистикаРаспределения.СреднийВес);
		ЛогиРаботы.ОбщаяИнформация.Вставить("ОбщееКоличествоДоговоров", СтатистикаРаспределения.КоличествоДоговоров);
		ЛогиРаботы.ОбщаяИнформация.Вставить("ОбщееКоличествоЗадач", СтатистикаРаспределения.КоличествоЗадач);
	КонецЕсли;
	
	СтруктураПотоков = Новый Структура;
	СтруктураПотоков.Вставить("ВсеПотоки", Потоки);
	СтруктураПотоков.Вставить("АктивныеЗадания", Новый Соответствие);
	СтруктураПотоков.Вставить("ИндексСледующегоПотока", 0);
	
	// "Спринт-старт": если очереди много, сразу разрешаем больше потоков для разгона
	НачальноеЦелевое = КоличествоПотоков;
	НачальнаяПауза = 2.0; // Всегда начинаем с 2 секунд, так как первые договоры тяжелые
	
	Если Потоки.Количество() > КоличествоПотоков * 3 Тогда
		НачальноеЦелевое = Цел(КоличествоПотоков * 1.5);
	КонецЕсли;
	
	СтруктураПотоков.Вставить("ЦелевоеКоличествоАктивных", НачальноеЦелевое);
	
	СтруктураПотоков.Вставить("ВремяНачалаПериода", ТекущаяДатаСеанса());
	СтруктураПотоков.Вставить("КоличествоЗавершенныхВПериод", 0);
	СтруктураПотоков.Вставить("ПредыдущееКоличествоЗавершенных", 0);
	СтруктураПотоков.Вставить("ТекущаяПауза", НачальнаяПауза);
	
	МассивСообщенийИзЗадания = Новый Массив;
	
	Для Сч = 0 По КоличествоПотоков - 1 Цикл
		Если Сч >= Потоки.Количество() Тогда
			Прервать;
		КонецЕсли;
		ЗапуститьПоток(СтруктураПотоков, Сч, ПараметрыЗадания, МассивСообщенийИзЗадания, ЛогиРаботы);
		// Обновляем индекс следующего потока, чтобы основной цикл продолжил с правильного места,
		// иначе будут запущены дубликаты первых потоков (потеря контроля над ними)
		СтруктураПотоков.ИндексСледующегоПотока = Сч + 1;
	КонецЦикла;
	
	Если ПроверкаВыполнения Тогда
		
		Пока СтруктураПотоков.ИндексСледующегоПотока < Потоки.Количество()
			ИЛИ СтруктураПотоков.АктивныеЗадания.Количество() > 0 Цикл
			
			МассивЗавершенныхИндексов = Новый Массив;
			КоличествоЗавершенныхВИтерации = 0;
			КоличествоЗапущенныхВИтерации = 0;
			
			Для Каждого ЭлементСоответствия Из СтруктураПотоков.АктивныеЗадания Цикл
				
				ИндексПотока = ЭлементСоответствия.Ключ;
				УИДЗадания = ЭлементСоответствия.Значение;
				
				Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(УИДЗадания);
				
				Если Задание = Неопределено Тогда
					МассивЗавершенныхИндексов.Добавить(ИндексПотока);
					КоличествоЗавершенныхВИтерации = КоличествоЗавершенныхВИтерации + 1;
					Продолжить;
				КонецЕсли;
				
				Если Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
					МассивЗавершенныхИндексов.Добавить(ИндексПотока);
					КоличествоЗавершенныхВИтерации = КоличествоЗавершенныхВИтерации + 1;
					ОбработатьЗавершенныйПоток(Задание, СтруктураПотоков, МассивСообщенийИзЗадания, ЛогиРаботы, ИндексПотока);
				КонецЕсли;
				
			КонецЦикла;
			
			Для Каждого ИндексПотока Из МассивЗавершенныхИндексов Цикл
				СтруктураПотоков.АктивныеЗадания.Удалить(ИндексПотока);
			КонецЦикла;
			
			ПринятьРешениеОКоличествеПотоков(СтруктураПотоков, КоличествоПотоков, ЛогиРаботы);
			
			СтруктураПотоков.ЦелевоеКоличествоАктивных = Мин(
					СтруктураПотоков.ЦелевоеКоличествоАктивных,
					КоличествоПотоков * 2
				);
			СтруктураПотоков.ЦелевоеКоличествоАктивных = Макс(
					СтруктураПотоков.ЦелевоеКоличествоАктивных,
					КоличествоПотоков
				);
			
			Пока СтруктураПотоков.АктивныеЗадания.Количество() < СтруктураПотоков.ЦелевоеКоличествоАктивных
				И СтруктураПотоков.ИндексСледующегоПотока < Потоки.Количество() Цикл
				
				ЗапуститьПоток(СтруктураПотоков, СтруктураПотоков.ИндексСледующегоПотока, ПараметрыЗадания, МассивСообщенийИзЗадания, ЛогиРаботы);
				СтруктураПотоков.ИндексСледующегоПотока = СтруктураПотоков.ИндексСледующегоПотока + 1;
				КоличествоЗапущенныхВИтерации = КоличествоЗапущенныхВИтерации + 1;
				
			КонецЦикла;
			
			Если ВключеноЛогирование Тогда
				Событие = Новый Структура;
				Событие.Вставить("Время", ТекущаяДатаСеанса());
				Событие.Вставить("ТипСобытия", "ПроверкаСостояния");
				ДанныеСобытия = Новый Структура;
				ДанныеСобытия.Вставить("КоличествоАктивныхПотоков", СтруктураПотоков.АктивныеЗадания.Количество());
				ДанныеСобытия.Вставить("КоличествоЗавершенныхВИтерации", КоличествоЗавершенныхВИтерации);
				ДанныеСобытия.Вставить("КоличествоЗапущенныхВИтерации", КоличествоЗапущенныхВИтерации);
				ДанныеСобытия.Вставить("ЦелевоеКоличествоАктивных", СтруктураПотоков.ЦелевоеКоличествоАктивных);
				ДанныеСобытия.Вставить("ТекущаяПауза", СтруктураПотоков.ТекущаяПауза);
				ДанныеСобытия.Вставить("СписокЗавершенныхПотоков", МассивЗавершенныхИндексов);
				Событие.Вставить("Данные", ДанныеСобытия);
				ЛогиРаботы.События.Добавить(Событие);
			КонецЕсли;
			
			VTB_ОбщийМодуль.Пауза(СтруктураПотоков.ТекущаяПауза);
			
		КонецЦикла;
		
		Для Каждого Элемент Из МассивСообщенийИзЗадания Цикл
			Комментарий = Комментарий + Символы.ПС + Элемент;
		КонецЦикла;
		
		Отказ = МассивСообщенийИзЗадания.Количество() > 0;
		
		Комментарий = Комментарий + Символы.ПС + "Все фоновые задания выполнены";
		
		Если ВключеноЛогирование Тогда
			ЛогиРаботы.ВремяОкончания = ТекущаяДатаСеанса();
			ТекстОтчета = СформироватьОтчетОРаботеПотоков(ЛогиРаботы);
			
			ЗаписьЖурналаРегистрации("Исполнение сделок в потоках", УровеньЖурналаРегистрации.Информация, , , Комментарий);
			
			Комментарий = Комментарий + Символы.ПС + Символы.ПС + ТекстОтчета;
			
			// Запись отчета в журнал регистрации
			ЗаписьЖурналаРегистрации("Отчет о работе параллельных потоков", УровеньЖурналаРегистрации.Информация, , , ТекстОтчета);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Описание: Записывает изменение параметра в лог работы потоков.
//           Универсальная процедура для логирования изменений количества потоков и паузы.
//
// Параметры:
//   ЛогиРаботы - Структура - структура для логирования работы потоков (может быть Неопределено)
//   ТипИзменения - Строка - тип изменения ("КоличествоПотоков" или "Пауза")
//   СтароеЗначение - Произвольный - старое значение параметра
//   НовоеЗначение - Произвольный - новое значение параметра
//   Причина - Строка - причина изменения (необязательный)
//   ДопДанные - Структура - дополнительные данные для логирования (необязательный)
//
Процедура ЗаписатьИзменениеПараметра(ЛогиРаботы, ТипИзменения, СтароеЗначение, НовоеЗначение, Причина = "", ДопДанные = Неопределено)
	
	Если ЛогиРаботы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запись = Новый Структура;
	Запись.Вставить("Время", ТекущаяДатаСеанса());
	Запись.Вставить("ТипИзменения", ТипИзменения);
	Запись.Вставить("СтароеЗначение", СтароеЗначение);
	Запись.Вставить("НовоеЗначение", НовоеЗначение);
	
	Если ТипИзменения = "КоличествоПотоков" Тогда
		Запись.Вставить("ИзменениеПотоков", НовоеЗначение - СтароеЗначение);
	ИначеЕсли ТипИзменения = "Пауза" Тогда
		Запись.Вставить("ИзменениеПаузы", НовоеЗначение - СтароеЗначение);
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Причина) Тогда
		Запись.Вставить("Причина", Причина);
	ИначеЕсли ТипИзменения = "КоличествоПотоков" Тогда
		Запись.Вставить("Причина", "Ограничение");
	КонецЕсли;
	
	Если ТипЗнч(ДопДанные) = Тип("Структура") Тогда
		Для Каждого КЗ Из ДопДанные Цикл
			Запись.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	
	ЛогиРаботы.ИзмененияПараметров.Добавить(Запись);
	
КонецПроцедуры

// Описание: Запускает один поток из очереди для выполнения сделок по списку договоров.
//           Создает фоновое задание и регистрирует его в структуре активных заданий.
//
// Параметры:
//   СтруктураПотоков - Структура - структура управления потоками (изменяется внутри процедуры)
//   ИндексПотока - Число - индекс потока в таблице потоков
//   ПараметрыЗадания - Структура - параметры для фонового задания (ДатаИсполнения)
//   МассивСообщенийИзЗадания - Массив - массив для сбора сообщений об ошибках (изменяется внутри процедуры)
//   ЛогиРаботы - Структура - структура для логирования работы потоков (необязательный, по умолчанию: Неопределено)
//
Процедура ЗапуститьПоток(СтруктураПотоков, ИндексПотока, ПараметрыЗадания, МассивСообщенийИзЗадания, ЛогиРаботы = Неопределено)
	
	ВсегоПотоков = СтруктураПотоков.ВсеПотоки.Количество();
	
	Если ИндексПотока >= ВсегоПотоков Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийПоток = СтруктураПотоков.ВсеПотоки[ИндексПотока];
	СписокДоговоров = ТекущийПоток.МассивДоговоров;
	
	Если СписокДоговоров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВремяЗапуска = ТекущаяДатаСеанса();
	
	ПараметрыПотока = Новый Структура;
	ПараметрыПотока.Вставить("ДатаИсполнения", ПараметрыЗадания.ДатаИсполнения);
	ПараметрыПотока.Вставить("СписокДоговор", СписокДоговоров);
	ПараметрыПотока.Вставить("ВесПотока", ТекущийПоток.ТекущаяЗагрузка);
	
	ПараметрыФоновогоЗадания = Новый Массив;
	ПараметрыФоновогоЗадания.Добавить(ПараметрыПотока);
	
	ПоследнийИндекс = ВсегоПотоков - 1;
	ОписаниеЗадания = "Поток " + Формат(ИндексПотока, "ЧГ=0") + " из " + Формат(ПоследнийИндекс, "ЧГ=0") + ", срок исп. " + Формат(ПараметрыЗадания.ДатаИсполнения, "ДФ=dd.MM.yyyy");
	
	Задание = ФоновыеЗадания.Выполнить(
			"tVTB_ОбщийМодуль.ВыполнитьИсполнениеСделокПоСпискуДоговорДУ",
			ПараметрыФоновогоЗадания,
			Новый УникальныйИдентификатор,
			ОписаниеЗадания
		);
	
	СтруктураПотоков.АктивныеЗадания.Вставить(ИндексПотока, Задание.УникальныйИдентификатор);
	
	Если ЛогиРаботы <> Неопределено Тогда
		
		Событие = Новый Структура;
		Событие.Вставить("Время", ВремяЗапуска);
		Событие.Вставить("ТипСобытия", "ЗапускПотока");
		ДанныеСобытия = Новый Структура;
		ДанныеСобытия.Вставить("НомерПотока", ИндексПотока);
		ДанныеСобытия.Вставить("ВесПотока", ТекущийПоток.ТекущаяЗагрузка);
		ДанныеСобытия.Вставить("КоличествоДоговоров", СписокДоговоров.Количество());
		Событие.Вставить("Данные", ДанныеСобытия);
		ЛогиРаботы.События.Добавить(Событие);
		
		ИнформацияОПотоке = Новый Структура;
		ИнформацияОПотоке.Вставить("НомерПотока", ИндексПотока);
		ИнформацияОПотоке.Вставить("ВесПотока", ТекущийПоток.ТекущаяЗагрузка);
		ИнформацияОПотоке.Вставить("КоличествоДоговоров", СписокДоговоров.Количество());
		ИнформацияОПотоке.Вставить("ВремяЗапуска", ВремяЗапуска);
		ИнформацияОПотоке.Вставить("ВремяЗавершения", Неопределено);
		ИнформацияОПотоке.Вставить("ДлительностьВыполнения", 0);
		ИнформацияОПотоке.Вставить("СтатусЗавершения", "Запущен");
		
		Пока ЛогиРаботы.Потоки.Количество() <= ИндексПотока Цикл
			ЛогиРаботы.Потоки.Добавить(Новый Структура);
		КонецЦикла;
		
		ЛогиРаботы.Потоки[ИндексПотока] = ИнформацияОПотоке;
		
		Если ЛогиРаботы.ОбщаяИнформация.Свойство("КоличествоЗапущенныхФоновыхЗаданий") Тогда
			ЛогиРаботы.ОбщаяИнформация.КоличествоЗапущенныхФоновыхЗаданий = ЛогиРаботы.ОбщаяИнформация.КоличествоЗапущенныхФоновыхЗаданий + 1;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Описание: Обрабатывает завершенный поток, собирает сообщения об ошибках и обновляет статистику.
//           Определяет статус завершения по состоянию фонового задания и логирует результат.
//
// Параметры:
//   Задание - ФоновоеЗадание - ссылка на завершенное фоновое задание
//   СтруктураПотоков - Структура - структура управления потоками (изменяется внутри процедуры)
//   МассивСообщенийИзЗадания - Массив - массив для сбора сообщений об ошибках (изменяется внутри процедуры)
//   ЛогиРаботы - Структура - структура для логирования работы потоков (необязательный, по умолчанию: Неопределено)
//   ИндексПотока - Число - номер потока для логирования (необязательный, по умолчанию: -1, определяется автоматически)
//
Процедура ОбработатьЗавершенныйПоток(Задание, СтруктураПотоков, МассивСообщенийИзЗадания, ЛогиРаботы = Неопределено, ИндексПотока = -1)
	
	СтруктураПотоков.КоличествоЗавершенныхВПериод = СтруктураПотоков.КоличествоЗавершенныхВПериод + 1;
	
	ВремяЗавершения = ТекущаяДатаСеанса();
	
	СтатусЗавершения = "Успешно";
	Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		СтатусЗавершения = "Ошибка";
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
		СтатусЗавершения = "Отменено";
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		СтатусЗавершения = "Успешно";
	КонецЕсли;
	
	СообщенияЗадания = Задание.ПолучитьСообщенияПользователю(Истина);
	ТмпСообщенияЗадания = Новый Массив(СообщенияЗадания);
	Для Каждого Элемент Из ТмпСообщенияЗадания Цикл
		// IMAPPS-14628 -->
		Если СтрНайти(Элемент.Текст, "Причина отказа") = 0 Тогда
			Продолжить;
		КонецЕсли;
		// IMAPPS-14628 <--
		МассивСообщенийИзЗадания.Добавить(Элемент.Текст);
		Если СтатусЗавершения = "Успешно" Тогда
			СтатусЗавершения = "Ошибка";
		КонецЕсли;
	КонецЦикла;
	
	Если ЛогиРаботы <> Неопределено Тогда
		
		Если ИндексПотока < 0 Тогда
			Для Каждого ЭлементСоответствия Из СтруктураПотоков.АктивныеЗадания Цикл
				Если ЭлементСоответствия.Значение = Задание.УникальныйИдентификатор Тогда
					ИндексПотока = ЭлементСоответствия.Ключ;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ИндексПотока >= 0 Тогда
			
			Событие = Новый Структура;
			Событие.Вставить("Время", ВремяЗавершения);
			Событие.Вставить("ТипСобытия", "ЗавершениеПотока");
			ДанныеСобытия = Новый Структура;
			ДанныеСобытия.Вставить("НомерПотока", ИндексПотока);
			ДанныеСобытия.Вставить("Статус", СтатусЗавершения);
			Событие.Вставить("Данные", ДанныеСобытия);
			ЛогиРаботы.События.Добавить(Событие);
			
			Если ИндексПотока < ЛогиРаботы.Потоки.Количество() Тогда
				ИнформацияОПотоке = ЛогиРаботы.Потоки[ИндексПотока];
				ИнформацияОПотоке.Вставить("ВремяЗавершения", ВремяЗавершения);
				ИнформацияОПотоке.Вставить("СтатусЗавершения", СтатусЗавершения);
				
				Если ИнформацияОПотоке.Свойство("ВремяЗапуска") И ИнформацияОПотоке.ВремяЗапуска <> Неопределено Тогда
					Длительность = ВремяЗавершения - ИнформацияОПотоке.ВремяЗапуска;
					ИнформацияОПотоке.Вставить("ДлительностьВыполнения", Длительность);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Описание: Принимает решение об изменении количества одновременно работающих потоков
//           на основе скорости закрытия договоров (накопительно за минуту).
//           Логика работы: в начале медленно (долгие договоры), потом быстрее (быстрые договоры).
//           Если скорость растет - увеличиваем потоки на 1 (до максимума 2*N).
//           Если скорость падает - уменьшаем потоки на 1 (до минимума N).
//           Период проверки: 60 секунд (1 минута).
//
// Параметры:
//   СтруктураПотоков - Структура - структура управления потоками (изменяется внутри процедуры)
//   БазовоеКоличество - Число - базовое количество потоков (N)
//   ЛогиРаботы - Структура - структура для логирования работы потоков (необязательный, по умолчанию: Неопределено)
//
Процедура ПринятьРешениеОКоличествеПотоков(СтруктураПотоков, БазовоеКоличество, ЛогиРаботы = Неопределено)
	
	ТекущееВремя = ТекущаяДатаСеанса();
	ПрошлоВремени = ТекущееВремя - СтруктураПотоков.ВремяНачалаПериода;
	
	Если ПрошлоВремени < 60 Тогда
		Возврат;
	КонецЕсли;
	
	СкоростьТекущая = СтруктураПотоков.КоличествоЗавершенныхВПериод;
	СкоростьПредыдущая = СтруктураПотоков.ПредыдущееКоличествоЗавершенных;
	
	СтароеЦелевоеКоличество = СтруктураПотоков.ЦелевоеКоличествоАктивных;
	ПричинаИзменения = "";
	ПричинаИзмененияПаузы = "";
	
	
	Если СкоростьТекущая > 0 И СкоростьПредыдущая > 0 Тогда
		
		Если СкоростьТекущая > СкоростьПредыдущая Тогда
			// Агрессивное увеличение: 1 поток за каждые 10% роста скорости (макс +5)
			ПроцентРоста = (СкоростьТекущая - СкоростьПредыдущая) / СкоростьПредыдущая * 100;
			ИзменениеПотоков = Макс(1, Цел(ПроцентРоста / 10));
			ИзменениеПотоков = Мин(ИзменениеПотоков, 5);
			
			МаксимальноеУвеличение = СтароеЦелевоеКоличество + 5;
			НовоеЗначение = СтароеЦелевоеКоличество + ИзменениеПотоков;
			
			// Ограничиваем сверху
			НовоеЗначение = Мин(НовоеЗначение, БазовоеКоличество * 2);
			НовоеЗначение = Мин(НовоеЗначение, МаксимальноеУвеличение);
			
			СтруктураПотоков.ЦелевоеКоличествоАктивных = НовоеЗначение;
			ПричинаИзменения = "СкоростьРастет";
			
			Ускорение = (СкоростьТекущая - СкоростьПредыдущая) / СкоростьПредыдущая;
			
			// Более плавное снижение паузы
			Если Ускорение > 0.5 Тогда
				КоэффициентИзмененияПаузы = 0.5; // Было 0.1 - слишком агрессивно, теперь более плавно
			ИначеЕсли Ускорение > 0.2 Тогда
				КоэффициентИзмененияПаузы = 0.7; // Было 0.5 - более плавное снижение
			Иначе
				КоэффициентИзмененияПаузы = 0.9; // Было 0.8 - еще более плавное снижение
			КонецЕсли;
			
			// Адаптивный минимум паузы в зависимости от скорости и количества активных потоков
			КоличествоАктивных = СтруктураПотоков.АктивныеЗадания.Количество();
			
			Если СкоростьТекущая > 50 Тогда
				МинимальнаяПауза = 0.05; // Очень высокая скорость - можно меньше паузы
			ИначеЕсли СкоростьТекущая > 20 Тогда
				МинимальнаяПауза = 0.1; // Высокая скорость - стандартный минимум
			Иначе
				МинимальнаяПауза = 0.2; // Низкая скорость - больше паузы для стабильности
			КонецЕсли;
			
			// Если много активных потоков, увеличиваем минимальную паузу для стабильности
			Если КоличествоАктивных > 10 Тогда
				МинимальнаяПауза = Макс(МинимальнаяПауза, 0.15); // Больше потоков - больше пауза
			КонецЕсли;
			
			СтараяПауза = СтруктураПотоков.ТекущаяПауза;
			ВычисленнаяПауза = СтруктураПотоков.ТекущаяПауза * КоэффициентИзмененияПаузы;
			НоваяПауза = Макс(МинимальнаяПауза, ВычисленнаяПауза);
			
			Если НоваяПауза <> СтруктураПотоков.ТекущаяПауза Тогда
				СтруктураПотоков.ТекущаяПауза = НоваяПауза;
				ПричинаИзмененияПаузы = "СкоростьРастет";
			ИначеЕсли ВычисленнаяПауза < МинимальнаяПауза И СтруктураПотоков.ТекущаяПауза = МинимальнаяПауза Тогда
				ПричинаИзмененияПаузы = "СкоростьРастет_НаМинимуме";
			КонецЕсли;
			
		ИначеЕсли СкоростьТекущая < СкоростьПредыдущая Тогда
			// Агрессивное уменьшение: 1 поток за каждые 10% падения скорости (макс -5)
			ПроцентПадения = (СкоростьПредыдущая - СкоростьТекущая) / СкоростьПредыдущая * 100;
			ИзменениеПотоков = Макс(1, Цел(ПроцентПадения / 10));
			ИзменениеПотоков = Мин(ИзменениеПотоков, 5);
			
			НовоеЗначение = СтруктураПотоков.ЦелевоеКоличествоАктивных - ИзменениеПотоков;
			НовоеЗначение = Макс(НовоеЗначение, БазовоеКоличество);
			
			СтруктураПотоков.ЦелевоеКоличествоАктивных = НовоеЗначение;
			ПричинаИзменения = "СкоростьПадает";
			
			Замедление = (СкоростьПредыдущая - СкоростьТекущая) / СкоростьПредыдущая;
			Если Замедление > 0.5 Тогда
				КоэффициентИзмененияПаузы = 1.6;
			ИначеЕсли Замедление > 0.2 Тогда
				КоэффициентИзмененияПаузы = 1.4;
			Иначе
				КоэффициентИзмененияПаузы = 1.2;
			КонецЕсли;
			
			СтараяПауза = СтруктураПотоков.ТекущаяПауза;
			ВычисленнаяПауза = СтруктураПотоков.ТекущаяПауза * КоэффициентИзмененияПаузы;
			НоваяПауза = Мин(2.0, ВычисленнаяПауза);
			Если НоваяПауза <> СтруктураПотоков.ТекущаяПауза Тогда
				СтруктураПотоков.ТекущаяПауза = НоваяПауза;
				ПричинаИзмененияПаузы = "СкоростьПадает";
			ИначеЕсли ВычисленнаяПауза > 2.0 И СтруктураПотоков.ТекущаяПауза = 2.0 Тогда
				ПричинаИзмененияПаузы = "СкоростьПадает_НаМаксимуме";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураПотоков.ЦелевоеКоличествоАктивных = Мин(СтруктураПотоков.ЦелевоеКоличествоАктивных, БазовоеКоличество * 2);
	СтруктураПотоков.ЦелевоеКоличествоАктивных = Макс(СтруктураПотоков.ЦелевоеКоличествоАктивных, БазовоеКоличество);
	
	Если ЛогиРаботы <> Неопределено Тогда
		
		ПроцентИзмененияСкорости = 0;
		Если СкоростьПредыдущая > 0 Тогда
			ПроцентИзмененияСкорости = (СкоростьТекущая - СкоростьПредыдущая) / СкоростьПредыдущая * 100;
		КонецЕсли;
		
		Если СтруктураПотоков.ЦелевоеКоличествоАктивных <> СтароеЦелевоеКоличество Тогда
			ДопДанные = Новый Структура;
			ДопДанные.Вставить("СкоростьТекущая", СкоростьТекущая);
			ДопДанные.Вставить("СкоростьПредыдущая", СкоростьПредыдущая);
			ДопДанные.Вставить("ПроцентИзмененияСкорости", ПроцентИзмененияСкорости);
			ЗаписатьИзменениеПараметра(ЛогиРаботы, "КоличествоПотоков", СтароеЦелевоеКоличество, СтруктураПотоков.ЦелевоеКоличествоАктивных, ПричинаИзменения, ДопДанные);
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ПричинаИзмененияПаузы) Тогда
			ДопДанные = Новый Структура;
			ДопДанные.Вставить("СкоростьТекущая", СкоростьТекущая);
			ДопДанные.Вставить("СкоростьПредыдущая", СкоростьПредыдущая);
			ДопДанные.Вставить("ПроцентИзмененияСкорости", ПроцентИзмененияСкорости);
			ЗаписатьИзменениеПараметра(ЛогиРаботы, "Пауза", СтараяПауза, СтруктураПотоков.ТекущаяПауза, ПричинаИзмененияПаузы, ДопДанные);
		КонецЕсли;
		
		Событие = Новый Структура;
		Событие.Вставить("Время", ТекущееВремя);
		Событие.Вставить("ТипСобытия", "ПринятиеРешения");
		ДанныеСобытия = Новый Структура;
		ДанныеСобытия.Вставить("СкоростьТекущая", СкоростьТекущая);
		ДанныеСобытия.Вставить("СкоростьПредыдущая", СкоростьПредыдущая);
		Если СкоростьТекущая > 0 И СкоростьПредыдущая > 0 Тогда
			Если СкоростьТекущая > СкоростьПредыдущая Тогда
				ДанныеСобытия.Вставить("Решение", "Увеличить");
			ИначеЕсли СкоростьТекущая < СкоростьПредыдущая Тогда
				ДанныеСобытия.Вставить("Решение", "Уменьшить");
			Иначе
				ДанныеСобытия.Вставить("Решение", "Оставить");
			КонецЕсли;
		Иначе
			ДанныеСобытия.Вставить("Решение", "Пропущено");
		КонецЕсли;
		ДанныеСобытия.Вставить("НовоеЦелевоеКоличество", СтруктураПотоков.ЦелевоеКоличествоАктивных);
		Событие.Вставить("Данные", ДанныеСобытия);
		ЛогиРаботы.События.Добавить(Событие);
		
	КонецЕсли;
	
	Если СкоростьТекущая > 0 Тогда
		СтруктураПотоков.ПредыдущееКоличествоЗавершенных = СкоростьТекущая;
	КонецЕсли;
	
	СтруктураПотоков.КоличествоЗавершенныхВПериод = 0;
	СтруктураПотоков.ВремяНачалаПериода = ТекущееВремя;
	
КонецПроцедуры

// Описание: Вычисляет целевой вес потока на основе адаптивного статистического метода.
//           Использует максимум из (Q1 + 1.5×IQR, Медиана, 70% от среднего арифметического).
//           Гарантирует минимум 30 задач на поток для стабильности распределения.
//           Договоры с весом выше этого значения считаются "большими" и не объединяются в один поток.
//
// Параметры:
//   СписокЗадач - ТаблицаЗначений - таблица с колонками: КоличествоЗадач, ДоговорДУ
//
// Возвращаемое значение:
//   Число - целевой вес потока (порог для решения объединять ли договоры)
//
Функция ВычислитьСреднийВесДоговоров(СписокЗадач) Экспорт
	
	Если СписокЗадач.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ТаблицаВесов = Новый ТаблицаЗначений;
	ТаблицаВесов.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число"));
	
	ОбщееКоличествоЗадач = 0;
	Для Каждого Задача Из СписокЗадач Цикл
		НоваяСтрока = ТаблицаВесов.Добавить();
		НоваяСтрока.Вес = Задача.КоличествоЗадач;
		ОбщееКоличествоЗадач = ОбщееКоличествоЗадач + Задача.КоличествоЗадач;
	КонецЦикла;
	
	ТаблицаВесов.Сортировать("Вес Возр");
	
	Всего = ТаблицаВесов.Количество();
	
	// Вычисление Q1 (25-й процентиль)
	ИндексQ1 = Цел((Всего - 1) * 0.25);
	Если ИндексQ1 >= Всего Тогда
		ИндексQ1 = Всего - 1;
	КонецЕсли;
	Q1 = ТаблицаВесов[ИндексQ1].Вес;
	Если ИндексQ1 + 1 < Всего Тогда
		Q1 = (ТаблицаВесов[ИндексQ1].Вес + ТаблицаВесов[ИндексQ1 + 1].Вес) / 2;
	КонецЕсли;
	
	// Вычисление Q3 (75-й процентиль)
	ИндексQ3 = Цел((Всего - 1) * 0.75);
	Если ИндексQ3 >= Всего Тогда
		ИндексQ3 = Всего - 1;
	КонецЕсли;
	Q3 = ТаблицаВесов[ИндексQ3].Вес;
	Если ИндексQ3 + 1 < Всего Тогда
		Q3 = (ТаблицаВесов[ИндексQ3].Вес + ТаблицаВесов[ИндексQ3 + 1].Вес) / 2;
	КонецЕсли;
	
	IQR = Q3 - Q1;
	
	// Базовый расчет (Q1 + 1.5×IQR)
	ЦелевойВес_Базовый = Q1 + 1.5 * IQR;
	
	// Вычисление медианы (50-й процентиль)
	ИндексМедианы = Цел((Всего - 1) * 0.5);
	Если ИндексМедианы >= Всего Тогда
		ИндексМедианы = Всего - 1;
	КонецЕсли;
	Медиана = ТаблицаВесов[ИндексМедианы].Вес;
	Если ИндексМедианы + 1 < Всего Тогда
		Медиана = (ТаблицаВесов[ИндексМедианы].Вес + ТаблицаВесов[ИндексМедианы + 1].Вес) / 2;
	КонецЕсли;
	
	// Вычисление среднего арифметического
	СреднееАрифметическое = ОбщееКоличествоЗадач / Всего;
	
	// 70% от среднего арифметического
	ЦелевойВес_ОтСреднего = СреднееАрифметическое * 0.7;
	
	// Берем максимум из трех значений
	ЦелевойВес_Промежуточный = Макс(ЦелевойВес_Базовый, Медиана, ЦелевойВес_ОтСреднего);
	
	// Ограничение снизу для стабильности (минимум 30 задач на поток)
	ЦелевойВес = Макс(ЦелевойВес_Промежуточный, 30);
	
	Возврат ЦелевойВес;
	
КонецФункции

// Описание: Распределяет задачи по потокам на основе статистического анализа весов договоров.
//           Большие договоры (вес >= среднего) размещаются по одному в потоке.
//           Малые договоры объединяются в потоки до достижения целевого веса.
//           После распределения удаляются все пустые потоки и выполняется перенумерация.
//
// Параметры:
//   ДатаИсполнения - Дата - дата исполнения сделок для фильтрации задач
//   ЧислоПотоков - Число - базовое количество потоков (используется для логирования)
//   Пул - Массив - фильтр по пулам договоров (необязательный, по умолчанию: Неопределено)
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица потоков с колонками: НомерПотока, ТекущаяЗагрузка, МассивДоговоров
//
Функция РаспределитьЗадачиПоПотокам(ДатаИсполнения, ЧислоПотоков, Пул = Неопределено)
	
	// !!! ВЫПИЛИТЬ ПЕРЕД ПЕРЕНОСОМ В КОНФИГУРАЦИЮ, НУЖЕН ИЗ_ЗА ТОГО ЧТО ЭТО МОДУЛЬ ФОРМЫ !!!
	РежимЗагрузки = Объект.РежимЗагрузки;
	// !!! ВЫПИЛИТЬ ПЕРЕД ПЕРЕНОСОМ В КОНФИГУРАЦИЮ, НУЖЕН ИЗ_ЗА ТОГО ЧТО ЭТО МОДУЛЬ ФОРМЫ !!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВнебиржеваяСделка.Ссылка) КАК КоличествоЗадач,
		|	ВнебиржеваяСделка.БизнесПроцесс.ДоговорДУ КАК ДоговорДУ
		|ИЗ
		|	Задача.ВнебиржеваяСделка КАК ВнебиржеваяСделка
		|ГДЕ
		|	НЕ ВнебиржеваяСделка.ПометкаУдаления
		|	И НЕ ВнебиржеваяСделка.БизнесПроцесс.ПометкаУдаления
		|	И ВнебиржеваяСделка.БизнесПроцесс.АвтоматическоеВыполнениеЗадач
		|	И НЕ ВнебиржеваяСделка.Выполнена
		|	И ВнебиржеваяСделка.СрокИсполнения МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И (ВнебиржеваяСделка.БизнесПроцесс ССЫЛКА БизнесПроцесс.СделкиTn
		|			ИЛИ ВнебиржеваяСделка.БизнесПроцесс ССЫЛКА БизнесПроцесс.СделкиРЕПО)
		|	И ВЫБОР
		|			КОГДА &РежимЗагрузки = 1
		|				ТОГДА ВнебиржеваяСделка.БизнесПроцесс.ДоговорДУ.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.ФизическиеЛица)
		|			КОГДА &РежимЗагрузки = 2
		|				ТОГДА НЕ ВнебиржеваяСделка.БизнесПроцесс.ДоговорДУ.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.ФизическиеЛица)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА ВнебиржеваяСделка.БизнесПроцесс ССЫЛКА БизнесПроцесс.СделкиTn
		|				ТОГДА 1 = 1 
		|			КОГДА ВнебиржеваяСделка.БизнесПроцесс ССЫЛКА БизнесПроцесс.СделкиРЕПО
		|				ТОГДА 1 = 1
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВнебиржеваяСделка.БизнесПроцесс.ДоговорДУ
		|
		|УПОРЯДОЧИТЬ ПО
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВнебиржеваяСделка.Ссылка) УБЫВ";
	
	Запрос.УстановитьПараметр("РежимЗагрузки", РежимЗагрузки);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаИсполнения));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаИсполнения));
	Если ЗначениеЗаполнено(Пул) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "ВнебиржеваяСделка.БизнесПроцесс.ДоговорДУ.Пул В (&Пул)");
		Запрос.УстановитьПараметр("Пул", Пул);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "ВнебиржеваяСделка.БизнесПроцесс.ДоговорДУ.Пул = ЗНАЧЕНИЕ(Справочник.Пул.ПустаяССылка)");
	КонецЕсли;
	
	СписокЗадач = Запрос.Выполнить().Выгрузить();
	
	// !!! ВЫПИЛИТЬ ПЕРЕД ПЕРЕНОСОМ В КОНФИГУРАЦИЮ, НУЖЕН ИЗ_ЗА ТОГО ЧТО ЭТО МОДУЛЬ ФОРМЫ !!!
	СписокЗадач = ПолучитьСписокЗадачПоДоговорам_Заглушка2(Объект.ДатаИсполнения, Объект.РежимЗагрузки, Пул);
	// !!! ВЫПИЛИТЬ ПЕРЕД ПЕРЕНОСОМ В КОНФИГУРАЦИЮ, НУЖЕН ИЗ_ЗА ТОГО ЧТО ЭТО МОДУЛЬ ФОРМЫ !!!
	
	Потоки = Новый ТаблицаЗначений;
	Потоки.Колонки.Добавить("НомерПотока", Новый ОписаниеТипов("Число"));
	Потоки.Колонки.Добавить("ТекущаяЗагрузка", Новый ОписаниеТипов("Число"));
	Потоки.Колонки.Добавить("МассивДоговоров", Новый ОписаниеТипов("Массив"));
	
	Если СписокЗадач.Количество() = 0 Тогда
		Результат = Новый Структура;
		Результат.Вставить("Потоки", Потоки);
		Результат.Вставить("ЦелевойВес", 0);
		Результат.Вставить("СреднийВес", 0);
		Результат.Вставить("КоличествоДоговоров", 0);
		Результат.Вставить("КоличествоЗадач", 0);
		Возврат Результат;
	КонецЕсли;
	
	СреднийВес = ВычислитьСреднийВесДоговоров(СписокЗадач);
	
	ОбщееКоличествоДоговоров = СписокЗадач.Количество();
	ОбщееКоличествоЗадач = 0;
	
	НомерПотока = 0;
	ТекущийПоток = Потоки.Добавить();
	ТекущийПоток.НомерПотока = НомерПотока;
	ТекущийПоток.ТекущаяЗагрузка = 0;
	ТекущийПоток.МассивДоговоров = Новый Массив;
	
	// Порог для "больших" договоров (1.5 × целевой вес)
	ПорогБольшихДоговоров = СреднийВес * 1.5;
	// Максимальный вес потока при объединении (1.2 × целевой вес)
	МаксимальныйВесПотока = СреднийВес * 1.2;
	
	Для Каждого СтрокаЗадачи Из СписокЗадач Цикл
		
		ВесДоговора = СтрокаЗадачи.КоличествоЗадач;
		ОбщееКоличествоЗадач = ОбщееКоличествоЗадач + ВесДоговора;
		
		Если ВесДоговора >= ПорогБольшихДоговоров Тогда
			// Действительно большой договор - всегда отдельный поток
			Если ТекущийПоток.МассивДоговоров.Количество() > 0 Тогда
				НомерПотока = НомерПотока + 1;
				ТекущийПоток = Потоки.Добавить();
				ТекущийПоток.НомерПотока = НомерПотока;
				ТекущийПоток.ТекущаяЗагрузка = 0;
				ТекущийПоток.МассивДоговоров = Новый Массив;
			КонецЕсли;
			
			ТекущийПоток.МассивДоговоров.Добавить(СтрокаЗадачи.ДоговорДУ);
			ТекущийПоток.ТекущаяЗагрузка = ВесДоговора;
			
			НомерПотока = НомерПотока + 1;
			ТекущийПоток = Потоки.Добавить();
			ТекущийПоток.НомерПотока = НомерПотока;
			ТекущийПоток.ТекущаяЗагрузка = 0;
			ТекущийПоток.МассивДоговоров = Новый Массив;
			
		ИначеЕсли ВесДоговора >= СреднийВес Тогда
			// Средний договор - можно объединить с маленькими, если есть место
			Если ТекущийПоток.ТекущаяЗагрузка + ВесДоговора <= МаксимальныйВесПотока Тогда
				// Есть место - добавляем в текущий поток
				ТекущийПоток.МассивДоговоров.Добавить(СтрокаЗадачи.ДоговорДУ);
				ТекущийПоток.ТекущаяЗагрузка = ТекущийПоток.ТекущаяЗагрузка + ВесДоговора;
			Иначе
				// Нет места - отдельный поток
				Если ТекущийПоток.МассивДоговоров.Количество() > 0 Тогда
					НомерПотока = НомерПотока + 1;
					ТекущийПоток = Потоки.Добавить();
					ТекущийПоток.НомерПотока = НомерПотока;
					ТекущийПоток.ТекущаяЗагрузка = 0;
					ТекущийПоток.МассивДоговоров = Новый Массив;
				КонецЕсли;
				
				ТекущийПоток.МассивДоговоров.Добавить(СтрокаЗадачи.ДоговорДУ);
				ТекущийПоток.ТекущаяЗагрузка = ВесДоговора;
				
				НомерПотока = НомерПотока + 1;
				ТекущийПоток = Потоки.Добавить();
				ТекущийПоток.НомерПотока = НомерПотока;
				ТекущийПоток.ТекущаяЗагрузка = 0;
				ТекущийПоток.МассивДоговоров = Новый Массив;
			КонецЕсли;
			
		Иначе
			// Маленький договор - объединяем до достижения целевого веса
			Если ТекущийПоток.ТекущаяЗагрузка + ВесДоговора <= СреднийВес Тогда
				ТекущийПоток.МассивДоговоров.Добавить(СтрокаЗадачи.ДоговорДУ);
				ТекущийПоток.ТекущаяЗагрузка = ТекущийПоток.ТекущаяЗагрузка + ВесДоговора;
			Иначе
				НомерПотока = НомерПотока + 1;
				ТекущийПоток = Потоки.Добавить();
				ТекущийПоток.НомерПотока = НомерПотока;
				ТекущийПоток.ТекущаяЗагрузка = ВесДоговора;
				ТекущийПоток.МассивДоговоров = Новый Массив;
				ТекущийПоток.МассивДоговоров.Добавить(СтрокаЗадачи.ДоговорДУ);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Индекс = Потоки.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Потоки[Индекс].МассивДоговоров.Количество() = 0 Тогда
			Потоки.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Для Инд = 0 По Потоки.Количество() - 1 Цикл
		Потоки[Инд].НомерПотока = Инд;
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Потоки", Потоки);
	Результат.Вставить("ЦелевойВес", СреднийВес);
	Результат.Вставить("СреднийВес", ОбщееКоличествоЗадач / Макс(1, ОбщееКоличествоДоговоров));
	Результат.Вставить("КоличествоДоговоров", ОбщееКоличествоДоговоров);
	Результат.Вставить("КоличествоЗадач", ОбщееКоличествоЗадач);
	
	Возврат Результат;
КонецФункции

// Описание: Форматирует значение колонки с фиксированной шириной для вывода в текстовом отчете.
//           Обрезает длинные значения или дополняет короткие пробелами до указанной ширины.
//
// Параметры:
//   Значение - Произвольный - значение для форматирования (преобразуется в строку)
//   Ширина - Число - ширина колонки в символах
//   ВыравниваниеПравое - Булево - Истина для выравнивания по правому краю (для чисел), по умолчанию: Ложь
//
// Возвращаемое значение:
//   Строка - отформатированное значение с фиксированной шириной
//
Функция ФорматироватьКолонку(Значение, Ширина, ВыравниваниеПравое = Ложь)
	
	СтрокаЗначения = Строка(Значение);
	ДлинаЗначения = СтрДлина(СтрокаЗначения);
	
	Если ДлинаЗначения >= Ширина Тогда
		Возврат Лев(СтрокаЗначения, Ширина); // обрезаем, если не влезает
	КонецЕсли;
	
	КоличествоПробелов = Ширина - ДлинаЗначения;
	Пробелы = СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов(" ", КоличествоПробелов);
	
	Если ВыравниваниеПравое Тогда
		Возврат Пробелы + СтрокаЗначения;
	Иначе
		Возврат СтрокаЗначения + Пробелы;
	КонецЕсли;
	
КонецФункции

// Описание: Формирует структурированный текстовый отчет о работе параллельных потоков.
//           Включает общую информацию, распределение потоков, динамику изменений параметров и статистику.
//
// Параметры:
//   ЛогиРаботы - Структура - структура с данными логирования работы потоков
//
// Возвращаемое значение:
//   Строка - текстовый отчет о работе потоков
//
Функция СформироватьОтчетОРаботеПотоков(ЛогиРаботы) Экспорт
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("=== ОТЧЕТ О РАБОТЕ ПАРАЛЛЕЛЬНЫХ ПОТОКОВ ===");
	МассивСтрок.Добавить("");
	
	// 1. ОБЩАЯ ИНФОРМАЦИЯ
	МассивСтрок.Добавить("1. ОБЩАЯ ИНФОРМАЦИЯ");
	
	Длительность = 0;
	Если ЛогиРаботы.ВремяОкончания <> Неопределено И ЛогиРаботы.ВремяНачала <> Неопределено Тогда
		Длительность = ЛогиРаботы.ВремяОкончания - ЛогиРаботы.ВремяНачала;
	КонецЕсли;
	
	МассивСтрок.Добавить("   - Дата и время начала: " + Формат(ЛогиРаботы.ВремяНачала, "ДФ=""dd.MM.yyyy HH:mm:ss"""));
	Если ЛогиРаботы.ВремяОкончания <> Неопределено Тогда
		МассивСтрок.Добавить("   - Дата и время окончания: " + Формат(ЛогиРаботы.ВремяОкончания, "ДФ=""dd.MM.yyyy HH:mm:ss"""));
	КонецЕсли;
	МассивСтрок.Добавить("   - Общая длительность: " + Формат(Длительность, "ЧДЦ=2") + " сек");
	
	// Расчет эффективности: сравнение с теоретическим временем старого алгоритма
	// Теоретическое время старого алгоритма (идеальное) = Сумма всех длительностей / Базовое количество потоков (N)
	// Эффективность = Теоретическое время / Реальное время
	СуммаДлительностейПотоков = 0;
	Для Каждого ИнформацияОПотоке Из ЛогиРаботы.Потоки Цикл
		Если ИнформацияОПотоке.ДлительностьВыполнения > 0 Тогда
			СуммаДлительностейПотоков = СуммаДлительностейПотоков + ИнформацияОПотоке.ДлительностьВыполнения;
		КонецЕсли;
	КонецЦикла;
	
	БазовоеКоличество = ЛогиРаботы.ОбщаяИнформация.БазовоеКоличествоПотоков;
	ТеоретическоеВремяСтарогоАлгоритма = 0;
	Если БазовоеКоличество > 0 Тогда
		ТеоретическоеВремяСтарогоАлгоритма = СуммаДлительностейПотоков / БазовоеКоличество;
	КонецЕсли;
	
	Эффективность = 0;
	Если Длительность > 0 Тогда
		Эффективность = ТеоретическоеВремяСтарогоАлгоритма / Длительность;
	КонецЕсли;
	
	КоличествоПотоков = ЛогиРаботы.ОбщаяИнформация.ОбщееКоличествоСозданныхПотоков;
	
	МассивСтрок.Добавить("   - Базовое количество потоков (N): " + Формат(БазовоеКоличество, "ЧГ="));
	МассивСтрок.Добавить("   - Общее количество созданных потоков: " + Формат(КоличествоПотоков, "ЧГ="));
	Если ЛогиРаботы.ОбщаяИнформация.Свойство("КоличествоЗапущенныхФоновыхЗаданий") Тогда
		МассивСтрок.Добавить("   - Количество запущенных фоновых заданий: " + Формат(ЛогиРаботы.ОбщаяИнформация.КоличествоЗапущенныхФоновыхЗаданий, "ЧГ="));
	КонецЕсли;
	МассивСтрок.Добавить("   - Сумма длительностей потоков: " + Формат(СуммаДлительностейПотоков, "ЧДЦ=2") + " сек");
	МассивСтрок.Добавить("   - Теоретическое время при N фиксированных потоках (идеальное): " + Формат(ТеоретическоеВремяСтарогоАлгоритма, "ЧДЦ=2") + " сек");
	МассивСтрок.Добавить("   - Эффективность (Теор. время / Реальное время): " + Формат(Эффективность, "ЧДЦ=2") + " (чем больше 1, тем лучше)");
	МассивСтрок.Добавить("   - Средний вес договоров: " + Формат(ЛогиРаботы.ОбщаяИнформация.СреднийВесДоговоров, "ЧДЦ=2"));
	Если ЛогиРаботы.ОбщаяИнформация.Свойство("ЦелевойВесПотока") Тогда
		МассивСтрок.Добавить("   - Целевой вес потока (Q1 + 1.5×IQR): " + Формат(ЛогиРаботы.ОбщаяИнформация.ЦелевойВесПотока, "ЧДЦ=2"));
	КонецЕсли;
	МассивСтрок.Добавить("   - Общее количество договоров: " + Формат(ЛогиРаботы.ОбщаяИнформация.ОбщееКоличествоДоговоров, "ЧГ="));
	МассивСтрок.Добавить("   - Общее количество задач: " + Формат(ЛогиРаботы.ОбщаяИнформация.ОбщееКоличествоЗадач, "ЧГ="));
	МассивСтрок.Добавить("");
	
	// 2. РАСПРЕДЕЛЕНИЕ ПОТОКОВ
	МассивСтрок.Добавить("2. РАСПРЕДЕЛЕНИЕ ПОТОКОВ");
	МассивСтрок.Добавить("   " + ФорматироватьКолонку("Номер", 5, Истина) + " | " + ФорматироватьКолонку("Вес", 5, Истина) + " | " + ФорматироватьКолонку("Кол-во", 7, Истина) + " | " + ФорматироватьКолонку("Время запуска", 12) + " | " + ФорматироватьКолонку("Время завершения", 15) + " | " + ФорматироватьКолонку("Длительность", 12, Истина) + " | " + ФорматироватьКолонку("Статус", 10));
	СтрокаРазделителя = СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("-", 120);
	МассивСтрок.Добавить("   " + СтрокаРазделителя);
	
	Для Каждого ИнформацияОПотоке Из ЛогиРаботы.Потоки Цикл
		СтрокаОтчета = "   ";
		СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Строка(ИнформацияОПотоке.НомерПотока), 5, Истина) + " | ";
		СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИнформацияОПотоке.ВесПотока, "ЧГ="), 5, Истина) + " | ";
		СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИнформацияОПотоке.КоличествоДоговоров, "ЧГ="), 7, Истина) + " | ";
		
		Если ИнформацияОПотоке.ВремяЗапуска <> Неопределено Тогда
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИнформацияОПотоке.ВремяЗапуска, "ДФ=""HH:mm:ss"""), 12) + " | ";
		Иначе
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку("Не запущен", 12) + " | ";
		КонецЕсли;
		
		Если ИнформацияОПотоке.ВремяЗавершения <> Неопределено Тогда
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИнформацияОПотоке.ВремяЗавершения, "ДФ=""HH:mm:ss"""), 15) + " | ";
		Иначе
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку("Не завершен", 15) + " | ";
		КонецЕсли;
		
		Если ИнформацияОПотоке.ДлительностьВыполнения > 0 Тогда
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИнформацияОПотоке.ДлительностьВыполнения, "ЧДЦ=2") + " сек", 12, Истина) + " | ";
		Иначе
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку("< 1 сек", 12, Истина) + " | ";
		КонецЕсли;
		
		СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(ИнформацияОПотоке.СтатусЗавершения, 10);
		
		МассивСтрок.Добавить(СтрокаОтчета);
	КонецЦикла;
	МассивСтрок.Добавить("");
	
	// 3. ДИНАМИКА ИЗМЕНЕНИЙ
	МассивСтрок.Добавить("3. ДИНАМИКА ИЗМЕНЕНИЙ");
	
	// 3.1. Изменения целевого количества активных потоков
	МассивСтрок.Добавить("   3.1. Изменения целевого количества активных потоков");
	МассивСтрок.Добавить("   " + ФорматироватьКолонку("Время", 8) + " | " + ФорматироватьКолонку("Старое", 6, Истина) + " | " + ФорматироватьКолонку("Новое", 5, Истина) + " | " + ФорматироватьКолонку("Изменение", 10, Истина) + " | " + ФорматироватьКолонку("Скорость тек.", 13, Истина) + " | " + ФорматироватьКолонку("Скорость пред.", 14, Истина) + " | " + ФорматироватьКолонку("% изменения", 12, Истина) + " | " + ФорматироватьКолонку("Причина", 15));
	СтрокаРазделителя = СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("-", 150);
	МассивСтрок.Добавить("   " + СтрокаРазделителя);
	
	Для Каждого ИзменениеПараметра Из ЛогиРаботы.ИзмененияПараметров Цикл
		Если ИзменениеПараметра.ТипИзменения = "КоличествоПотоков" Тогда
			СтрокаОтчета = "   ";
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИзменениеПараметра.Время, "ДФ=""HH:mm:ss"""), 8) + " | ";
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИзменениеПараметра.СтароеЗначение, "ЧГ="), 6, Истина) + " | ";
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИзменениеПараметра.НовоеЗначение, "ЧГ="), 5, Истина) + " | ";
			
			// Показываем изменение потоков (может быть положительным или отрицательным)
			Если ИзменениеПараметра.Свойство("ИзменениеПотоков") Тогда
				ЗнакИзменения = "";
				Если ИзменениеПараметра.ИзменениеПотоков > 0 Тогда
					ЗнакИзменения = "+";
				КонецЕсли;
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(ЗнакИзменения + Формат(ИзменениеПараметра.ИзменениеПотоков, "ЧГ="), 10, Истина) + " | ";
			Иначе
				Изменение = ИзменениеПараметра.НовоеЗначение - ИзменениеПараметра.СтароеЗначение;
				ЗнакИзменения = "";
				Если Изменение > 0 Тогда
					ЗнакИзменения = "+";
				КонецЕсли;
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(ЗнакИзменения + Формат(Изменение, "ЧГ="), 10, Истина) + " | ";
			КонецЕсли;
			
			// Скорость текущая
			Если ИзменениеПараметра.Свойство("СкоростьТекущая") Тогда
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИзменениеПараметра.СкоростьТекущая, "ЧГ=") + " пот/мин", 13, Истина) + " | ";
			Иначе
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку("-", 13, Истина) + " | ";
			КонецЕсли;
			
			// Скорость предыдущая
			Если ИзменениеПараметра.Свойство("СкоростьПредыдущая") Тогда
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИзменениеПараметра.СкоростьПредыдущая, "ЧГ=") + " пот/мин", 14, Истина) + " | ";
			Иначе
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку("-", 14, Истина) + " | ";
			КонецЕсли;
			
			// Процент изменения скорости
			Если ИзменениеПараметра.Свойство("ПроцентИзмененияСкорости") Тогда
				ЗнакПроцента = "";
				Если ИзменениеПараметра.ПроцентИзмененияСкорости > 0 Тогда
					ЗнакПроцента = "+";
				КонецЕсли;
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(ЗнакПроцента + Формат(ИзменениеПараметра.ПроцентИзмененияСкорости, "ЧДЦ=1") + "%", 12, Истина) + " | ";
			Иначе
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку("-", 12, Истина) + " | ";
			КонецЕсли;
			
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(ИзменениеПараметра.Причина, 15);
			
			МассивСтрок.Добавить(СтрокаОтчета);
		КонецЕсли;
	КонецЦикла;
	МассивСтрок.Добавить("");
	
	// 3.2. Изменения паузы
	МассивСтрок.Добавить("   3.2. Изменения паузы");
	МассивСтрок.Добавить("   " + ФорматироватьКолонку("Время", 8) + " | " + ФорматироватьКолонку("Старое", 8, Истина) + " | " + ФорматироватьКолонку("Новое", 8, Истина) + " | " + ФорматироватьКолонку("Изменение", 10, Истина) + " | " + ФорматироватьКолонку("Скорость тек.", 13, Истина) + " | " + ФорматироватьКолонку("Скорость пред.", 14, Истина) + " | " + ФорматироватьКолонку("% изменения", 12, Истина) + " | " + ФорматироватьКолонку("Причина", 25));
	СтрокаРазделителя = СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("-", 150);
	МассивСтрок.Добавить("   " + СтрокаРазделителя);
	
	Для Каждого ИзменениеПараметра Из ЛогиРаботы.ИзмененияПараметров Цикл
		Если ИзменениеПараметра.ТипИзменения = "Пауза" Тогда
			СтрокаОтчета = "   ";
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИзменениеПараметра.Время, "ДФ=""HH:mm:ss"""), 8) + " | ";
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИзменениеПараметра.СтароеЗначение, "ЧДЦ=2"), 8, Истина) + " | ";
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИзменениеПараметра.НовоеЗначение, "ЧДЦ=2"), 8, Истина) + " | ";
			
			// Изменение паузы
			ЗнакИзменения = "";
			ЗначениеИзменения = 0;
			Если ИзменениеПараметра.Свойство("ИзменениеПаузы") Тогда
				ЗначениеИзменения = ИзменениеПараметра.ИзменениеПаузы;
			Иначе
				ЗначениеИзменения = ИзменениеПараметра.НовоеЗначение - ИзменениеПараметра.СтароеЗначение;
			КонецЕсли;
			
			Если ЗначениеИзменения > 0 Тогда
				ЗнакИзменения = "+";
			КонецЕсли;
			
			Если ЗначениеИзменения <> 0 Тогда
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(ЗнакИзменения + Формат(ЗначениеИзменения, "ЧДЦ=2"), 10, Истина) + " | ";
			Иначе
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку("-", 10, Истина) + " | ";
			КонецЕсли;
			
			// Скорость текущая
			Если ИзменениеПараметра.Свойство("СкоростьТекущая") Тогда
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИзменениеПараметра.СкоростьТекущая, "ЧГ=") + " пот/мин", 13, Истина) + " | ";
			Иначе
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку("-", 13, Истина) + " | ";
			КонецЕсли;
			
			// Скорость предыдущая
			Если ИзменениеПараметра.Свойство("СкоростьПредыдущая") Тогда
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(Формат(ИзменениеПараметра.СкоростьПредыдущая, "ЧГ=") + " пот/мин", 14, Истина) + " | ";
			Иначе
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку("-", 14, Истина) + " | ";
			КонецЕсли;
			
			// Процент изменения скорости
			Если ИзменениеПараметра.Свойство("ПроцентИзмененияСкорости") Тогда
				ЗнакПроцента = "";
				Если ИзменениеПараметра.ПроцентИзмененияСкорости > 0 Тогда
					ЗнакПроцента = "+";
				КонецЕсли;
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(ЗнакПроцента + Формат(ИзменениеПараметра.ПроцентИзмененияСкорости, "ЧДЦ=1") + "%", 12, Истина) + " | ";
			Иначе
				СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку("-", 12, Истина) + " | ";
			КонецЕсли;
			
			СтрокаОтчета = СтрокаОтчета + ФорматироватьКолонку(ИзменениеПараметра.Причина, 25);
			
			МассивСтрок.Добавить(СтрокаОтчета);
		КонецЕсли;
	КонецЦикла;
	МассивСтрок.Добавить("");
	
	// 4. СТАТИСТИКА
	МассивСтрок.Добавить("4. СТАТИСТИКА");
	
	// Расчет статистики
	КоличествоУспешных = 0;
	КоличествоОшибок = 0;
	СуммаДлительностей = 0;
	КоличествоПотоковСДлительностью = 0; // Счетчик потоков с измеренной длительностью
	МинимальнаяДлительность = 0;
	МаксимальнаяДлительность = 0;
	МаксимальноеКоличествоАктивных = 0;
	МаксимальноеЦелевоеКоличествоАктивных = 0;
	
	Для Каждого ИнформацияОПотоке Из ЛогиРаботы.Потоки Цикл
		Если ИнформацияОПотоке.СтатусЗавершения = "Успешно" Тогда
			КоличествоУспешных = КоличествоУспешных + 1;
		ИначеЕсли ИнформацияОПотоке.СтатусЗавершения = "Ошибка" Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
		
		Если ИнформацияОПотоке.ДлительностьВыполнения > 0 Тогда
			СуммаДлительностей = СуммаДлительностей + ИнформацияОПотоке.ДлительностьВыполнения;
			КоличествоПотоковСДлительностью = КоличествоПотоковСДлительностью + 1;
			Если МинимальнаяДлительность = 0 ИЛИ ИнформацияОПотоке.ДлительностьВыполнения < МинимальнаяДлительность Тогда
				МинимальнаяДлительность = ИнформацияОПотоке.ДлительностьВыполнения;
			КонецЕсли;
			Если ИнформацияОПотоке.ДлительностьВыполнения > МаксимальнаяДлительность Тогда
				МаксимальнаяДлительность = ИнформацияОПотоке.ДлительностьВыполнения;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Поиск максимального и минимального количества активных потоков
	Для Каждого Событие Из ЛогиРаботы.События Цикл
		Если Событие.ТипСобытия = "ПроверкаСостояния" Тогда
			КоличествоАктивных = Событие.Данные.КоличествоАктивныхПотоков;
			Если КоличествоАктивных > МаксимальноеКоличествоАктивных Тогда
				МаксимальноеКоличествоАктивных = КоличествоАктивных;
			КонецЕсли;
			
			// Поиск максимального целевого количества активных потоков
			Если Событие.Данные.Свойство("ЦелевоеКоличествоАктивных") Тогда
				ЦелевоеКоличество = Событие.Данные.ЦелевоеКоличествоАктивных;
				Если ЦелевоеКоличество > МаксимальноеЦелевоеКоличествоАктивных Тогда
					МаксимальноеЦелевоеКоличествоАктивных = ЦелевоеКоличество;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	КоличествоЗавершенныхПотоков = 0;
	Для Каждого ИнформацияОПотоке Из ЛогиРаботы.Потоки Цикл
		Если ИнформацияОПотоке.ВремяЗавершения <> Неопределено Тогда
			КоличествоЗавершенныхПотоков = КоличествоЗавершенныхПотоков + 1;
		КонецЕсли;
	КонецЦикла;
	
	СредняяДлительность = 0;
	Если КоличествоПотоковСДлительностью > 0 Тогда
		СредняяДлительность = СуммаДлительностей / КоличествоПотоковСДлительностью;
	КонецЕсли;
	
	СредняяСкорость = 0;
	Если Длительность > 0 Тогда
		СредняяСкорость = КоличествоЗавершенныхПотоков / Длительность;
	КонецЕсли;
	
	МассивСтрок.Добавить("   - Средняя длительность выполнения потока: " + Формат(СредняяДлительность, "ЧДЦ=2") + " сек");
	МассивСтрок.Добавить("   - Минимальная длительность: " + Формат(МинимальнаяДлительность, "ЧДЦ=2") + " сек");
	МассивСтрок.Добавить("   - Максимальная длительность: " + Формат(МаксимальнаяДлительность, "ЧДЦ=2") + " сек");
	МассивСтрок.Добавить("   - Количество успешно завершенных потоков: " + Строка(КоличествоУспешных));
	МассивСтрок.Добавить("   - Количество потоков с ошибками: " + Строка(КоличествоОшибок));
	МассивСтрок.Добавить("   - Средняя скорость выполнения: " + Формат(СредняяСкорость, "ЧДЦ=2") + " потоков/сек");
	МассивСтрок.Добавить("   - Максимальное количество одновременно активных потоков: " + Строка(МаксимальноеКоличествоАктивных));
	Если МаксимальноеЦелевоеКоличествоАктивных > 0 Тогда
		МассивСтрок.Добавить("   - Максимальное целевое количество активных потоков: " + Строка(МаксимальноеЦелевоеКоличествоАктивных));
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область ТЕСТИРОВАНИЕ

Функция ПолучитьСписокЗадачПоДоговорам_Заглушка(ДатаИсполнения, РежимЗагрузки, Пул = Неопределено)
	
	// Создаем таблицу значений с тестовыми данными
	// Имитируем распределение: 10% больших договоров + резкий спад
	// Всего 100 договоров
	
	СписокЗадач = Новый ТаблицаЗначений;
