	МассивСтрок.Добавить("");
	
	// 4. СТАТИСТИКА
	МассивСтрок.Добавить("4. СТАТИСТИКА");
	
	// Расчет статистики
	КоличествоУспешных = 0;
	КоличествоОшибок = 0;
	СуммаДлительностей = 0;
	КоличествоПотоковСДлительностью = 0; // Счетчик потоков с измеренной длительностью
	МинимальнаяДлительность = 0;
	МаксимальнаяДлительность = 0;
	МаксимальноеКоличествоАктивных = 0;
	МинимальноеКоличествоАктивных = 999999;
	МаксимальноеЦелевоеКоличествоАктивных = 0;
	
	Для Каждого ИнформацияОПотоке Из ЛогиРаботы.Потоки Цикл
		Если ИнформацияОПотоке.СтатусЗавершения = "Успешно" Тогда
			КоличествоУспешных = КоличествоУспешных + 1;
		ИначеЕсли ИнформацияОПотоке.СтатусЗавершения = "Ошибка" Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
		
		Если ИнформацияОПотоке.ДлительностьВыполнения > 0 Тогда
			СуммаДлительностей = СуммаДлительностей + ИнформацияОПотоке.ДлительностьВыполнения;
			КоличествоПотоковСДлительностью = КоличествоПотоковСДлительностью + 1;
			Если МинимальнаяДлительность = 0 ИЛИ ИнформацияОПотоке.ДлительностьВыполнения < МинимальнаяДлительность Тогда
				МинимальнаяДлительность = ИнформацияОПотоке.ДлительностьВыполнения;
			КонецЕсли;
			Если ИнформацияОПотоке.ДлительностьВыполнения > МаксимальнаяДлительность Тогда
				МаксимальнаяДлительность = ИнформацияОПотоке.ДлительностьВыполнения;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Поиск максимального и минимального количества активных потоков
	Для Каждого Событие Из ЛогиРаботы.События Цикл
		Если Событие.ТипСобытия = "ПроверкаСостояния" Тогда
			КоличествоАктивных = Событие.Данные.КоличествоАктивныхПотоков;
			Если КоличествоАктивных > МаксимальноеКоличествоАктивных Тогда
				МаксимальноеКоличествоАктивных = КоличествоАктивных;
			КонецЕсли;
			Если КоличествоАктивных < МинимальноеКоличествоАктивных Тогда
				МинимальноеКоличествоАктивных = КоличествоАктивных;
			КонецЕсли;
			
			// Поиск максимального целевого количества активных потоков
			Если Событие.Данные.Свойство("ЦелевоеКоличествоАктивных") Тогда
				ЦелевоеКоличество = Событие.Данные.ЦелевоеКоличествоАктивных;
				Если ЦелевоеКоличество > МаксимальноеЦелевоеКоличествоАктивных Тогда
					МаксимальноеЦелевоеКоличествоАктивных = ЦелевоеКоличество;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	КоличествоЗавершенныхПотоков = 0;
	Для Каждого ИнформацияОПотоке Из ЛогиРаботы.Потоки Цикл
		Если ИнформацияОПотоке.ВремяЗавершения <> Неопределено Тогда
			КоличествоЗавершенныхПотоков = КоличествоЗавершенныхПотоков + 1;
		КонецЕсли;
	КонецЦикла;
	
	СредняяДлительность = 0;
	Если КоличествоПотоковСДлительностью > 0 Тогда
		СредняяДлительность = СуммаДлительностей / КоличествоПотоковСДлительностью;
	КонецЕсли;
	
	СредняяСкорость = 0;
	Если Длительность > 0 Тогда
		СредняяСкорость = КоличествоЗавершенныхПотоков / Длительность;
	КонецЕсли;
	
	МассивСтрок.Добавить("   - Средняя длительность выполнения потока: " + Формат(СредняяДлительность, "ЧДЦ=2") + " сек");
	МассивСтрок.Добавить("   - Минимальная длительность: " + Формат(МинимальнаяДлительность, "ЧДЦ=2") + " сек");
	МассивСтрок.Добавить("   - Максимальная длительность: " + Формат(МаксимальнаяДлительность, "ЧДЦ=2") + " сек");
	МассивСтрок.Добавить("   - Количество успешно завершенных потоков: " + Строка(КоличествоУспешных));
	МассивСтрок.Добавить("   - Количество потоков с ошибками: " + Строка(КоличествоОшибок));
	МассивСтрок.Добавить("   - Средняя скорость выполнения: " + Формат(СредняяСкорость, "ЧДЦ=2") + " потоков/сек");
	МассивСтрок.Добавить("   - Максимальное количество одновременно активных потоков: " + Строка(МаксимальноеКоличествоАктивных));
	Если МинимальноеКоличествоАктивных <> 999999 Тогда
		МассивСтрок.Добавить("   - Минимальное количество одновременно активных потоков: " + Строка(МинимальноеКоличествоАктивных));
	Иначе
		МассивСтрок.Добавить("   - Минимальное количество одновременно активных потоков: 0");
	КонецЕсли;
	Если МаксимальноеЦелевоеКоличествоАктивных > 0 Тогда
		МассивСтрок.Добавить("   - Максимальное целевое количество активных потоков: " + Строка(МаксимальноеЦелевоеКоличествоАктивных));
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции
