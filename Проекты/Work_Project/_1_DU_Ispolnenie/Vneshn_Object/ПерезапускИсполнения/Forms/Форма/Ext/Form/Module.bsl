// Описание: Выполняет очистку флага "Выполнена" у задач на сервере
//           Клиентская обертка для серверной процедуры
//
// Параметры:
//   Команда - Произвольный - стандартный параметр команды формы
//
&НаКлиенте
Процедура ОчиститьФлагВыполненоУЗадач(Команда)
	ОчиститьФлагВыполненоУЗадачНаСервере();
КонецПроцедуры

// Описание: Инициализация формы при создании на сервере
//           Устанавливает значения по умолчанию для параметров обработки
//
// Параметры:
//   Отказ - Булево - флаг отказа от создания формы
//   СтандартнаяОбработка - Булево - флаг использования стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.НачалоПериода = Дата("20251117");
	Объект.ОкончаниеПериода = КонецДня(Объект.НачалоПериода);
	Объект.КоличествоБПДляОбработки = 1;
КонецПроцедуры

// Описание: Точка входа для очистки флагов выполнения.
//           Выбирает режим работы: синхронный (отладка) или фоновый (основной)
//           в зависимости от настройки КоличествоБПДляОбработки.
//
&НаСервере
Процедура ОчиститьФлагВыполненоУЗадачНаСервере()
	
	Если Объект.КоличествоБПДляОбработки > 0 И Объект.КоличествоБПДляОбработки < 10 Тогда
		// Синхронный режим (для отладки и малого количества: от 1 до 9 БП)
		ОчиститьФлагВыполненоУЗадачСинхронно();
	Иначе
		// Фоновый режим (основной, многопоточный по договорам)
		// Используется при КоличествоБПДляОбработки = 0 (все БП) или >= 10
		ОчиститьФлагВыполненоУЗадачВФоновомРежиме();
	КонецЕсли;
	
КонецПроцедуры

// Описание: Запускает обработку в фоновом режиме с разбивкой по договорам
//           Управляет очередью заданий: максимум 10 одновременно
//
&НаСервере
Процедура ОчиститьФлагВыполненоУЗадачВФоновомРежиме()
	
	Сообщить("Запуск фонового режима обработки...");
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	// Вычисляем лимит для запроса (если установлен): N = 3 * КоличествоБПДляОбработки
	// Если КоличествоБПДляОбработки = 0, то лимит не применяется
	ЛимитЗапроса = 0;
	Если Объект.КоличествоБПДляОбработки > 0 Тогда
		ЛимитЗапроса = 3 * Объект.КоличествоБПДляОбработки;
	КонецЕсли;
	
	// Формируем текст запроса динамически с подстановкой лимита (если установлен)
	Если ЛимитЗапроса > 0 Тогда
		ПрефиксПЕРВЫЕ = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(ЛимитЗапроса, "ЧГ=0");
	Иначе
		ПрефиксПЕРВЫЕ = "ВЫБРАТЬ";
	КонецЕсли;
	
	ТекстЗапроса = ПрефиксПЕРВЫЕ + "
		|	ВТ.ДоговорДУ КАК ДоговорДУ,
		|	ВТ.БизнесПроцесс КАК БизнесПроцесс,
		|	ВТ.ЗадачаКОтмене КАК ЗадачаКОтмене
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		СделкиTn.ДоговорДУ КАК ДоговорДУ,
		|		СделкиTn.Ссылка КАК БизнесПроцесс,
		|		ЗадачаTn.Ссылка КАК ЗадачаКОтмене
		|	ИЗ
		|		Задача.ВнебиржеваяСделка КАК ЗадачаTn
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ БизнесПроцесс.СделкиTn КАК СделкиTn
		|			ПО ЗадачаTn.БизнесПроцесс = СделкиTn.Ссылка
		|				И (НЕ ЗадачаTn.ПометкаУдаления)
		|				И (НЕ СделкиTn.ПометкаУдаления)
		|				И (СделкиTn.АвтоматическоеВыполнениеЗадач)
		|				И (ЗадачаTn.Выполнена)
		|				И (ЗадачаTn.СрокИсполнения МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|				И (ВЫБОР
		|					КОГДА &РежимЗагрузки = 1
		|						ТОГДА СделкиTn.ДоговорДУ.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.ФизическиеЛица)
		|					КОГДА &РежимЗагрузки = 2
		|						ТОГДА НЕ СделкиTn.ДоговорДУ.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.ФизическиеЛица)
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ)
		|				И (СделкиTn.ДоговорДУ.Пул = ЗНАЧЕНИЕ(Справочник.Пул.ПустаяССылка))
		|				И (СделкиTn.ДоговорДУ <> ЗНАЧЕНИЕ(Справочник.ДоговорДУ.ПустаяССылка))
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		СделкиРЕПО.ДоговорДУ КАК ДоговорДУ,
		|		СделкиРЕПО.Ссылка КАК БизнесПроцесс,
		|		ЗадачаРЕПО.Ссылка КАК ЗадачаКОтмене
		|	ИЗ
		|		Задача.ВнебиржеваяСделка КАК ЗадачаРЕПО
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ БизнесПроцесс.СделкиРЕПО КАК СделкиРЕПО
		|			ПО ЗадачаРЕПО.БизнесПроцесс = СделкиРЕПО.Ссылка
		|				И (НЕ ЗадачаРЕПО.ПометкаУдаления)
		|				И (НЕ СделкиРЕПО.ПометкаУдаления)
		|				И (СделкиРЕПО.АвтоматическоеВыполнениеЗадач)
		|				И (ЗадачаРЕПО.Выполнена)
		|				И (ЗадачаРЕПО.СрокИсполнения МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|				И (ВЫБОР
		|					КОГДА &РежимЗагрузки = 1
		|						ТОГДА СделкиРЕПО.ДоговорДУ.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.ФизическиеЛица)
		|					КОГДА &РежимЗагрузки = 2
		|						ТОГДА НЕ СделкиРЕПО.ДоговорДУ.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.ФизическиеЛица)
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ)
		|				И (СделкиРЕПО.ДоговорДУ.Пул = ЗНАЧЕНИЕ(Справочник.Пул.ПустаяССылка))
		|				И (СделкиРЕПО.ДоговорДУ <> ЗНАЧЕНИЕ(Справочник.ДоговорДУ.ПустаяССылка))) КАК ВТ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДоговорДУ,
		|	БизнесПроцесс";
	
	// ШАГ 1: Выполнить запрос и сгруппировать по договорам
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("РежимЗагрузки", 0);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Объект.НачалоПериода));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Объект.ОкончаниеПериода));
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	// Оптимизированное разделение по договорам (Single Pass O(N))
	ДанныеПоДоговорам = Новый Соответствие;
	
	// Кэшируем структуру колонок для быстрого создания таблиц
	СтруктураКолонок = РезультатЗапроса.СкопироватьКолонки("БизнесПроцесс, ЗадачаКОтмене");
	
	Для Каждого Строка Из РезультатЗапроса Цикл
		ДоговорДУ = Строка.ДоговорДУ;
		
		ТаблицаДоговора = ДанныеПоДоговорам[ДоговорДУ];
		Если ТаблицаДоговора = Неопределено Тогда
			ТаблицаДоговора = СтруктураКолонок.Скопировать();
			ДанныеПоДоговорам.Вставить(ДоговорДУ, ТаблицаДоговора);
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ТаблицаДоговора.Добавить(), Строка);
	КонецЦикла;
	
	Сообщить("Найдено договоров для обработки: " + ДанныеПоДоговорам.Количество());
	
	// ШАГ 2: Создать очередь договоров
	ОчередьДоговоров = Новый Массив;
	Для Каждого ЭлементДанных Из ДанныеПоДоговорам Цикл
		ОчередьДоговоров.Добавить(ЭлементДанных.Ключ);
	КонецЦикла;
	
	// ШАГ 3: Инициализация структур для управления заданиями
	АктивныеЗадания = Новый Соответствие; // GUID -> Структура с информацией
	ИндексОчереди = 0;
	МаксимумОдновременныхЗаданий = 10;
	
	// Счетчики для статистики
	ВсегоБПОбработано = 0;
	ВсегоЗадачОтменено = 0;
	ВсегоЗадачПропущено = 0;
	ВсегоПотоковЗапущено = 0;
	ВсеОшибки = Новый Массив;
	
	// ШАГ 4: Основной цикл управления пулом заданий
	Пока ИндексОчереди < ОчередьДоговоров.Количество() ИЛИ АктивныеЗадания.Количество() > 0 Цикл
		
		// ШАГ 4.1: Проверить завершенные задания (неблокирующая проверка)
		МассивЗавершенныхGUID = Новый Массив;
		
		Для Каждого ЭлементЗадания Из АктивныеЗадания Цикл
			GUIDЗадания = ЭлементЗадания.Ключ;
			ИнформацияОЗадании = ЭлементЗадания.Значение;
			
			Попытка
				// Находим задание заново по GUID для получения актуального состояния
				ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(GUIDЗадания);
				
				Если ФоновоеЗадание = Неопределено Тогда
					МассивЗавершенныхGUID.Добавить(GUIDЗадания);
					Продолжить;
				КонецЕсли;
				
				СостояниеЗадания = ФоновоеЗадание.Состояние;
				
				Если СостояниеЗадания = СостояниеФоновогоЗадания.Завершено Тогда
					Попытка
						РезультатЗадания = ПолучитьИзВременногоХранилища(ИнформацияОЗадании.АдресХранилищаРезультата);
						
						ВсегоБПОбработано = ВсегоБПОбработано + РезультатЗадания.КоличествоБПОбработано;
						ВсегоЗадачОтменено = ВсегоЗадачОтменено + РезультатЗадания.КоличествоЗадачОтменено;
						ВсегоЗадачПропущено = ВсегоЗадачПропущено + РезультатЗадания.КоличествоЗадачПропущено;
						
						Для Каждого Ошибка Из РезультатЗадания.Ошибки Цикл
							ВсеОшибки.Добавить(Ошибка);
						КонецЦикла;
					Исключение
						СтруктураОшибки = Новый Структура;
						СтруктураОшибки.Вставить("ДоговорДУ", ИнформацияОЗадании.ДоговорДУ);
						СтруктураОшибки.Вставить("ТекстОшибки", "Ошибка чтения результатов: " + ОписаниеОшибки());
						ВсеОшибки.Добавить(СтруктураОшибки);
					КонецПопытки;
					
					МассивЗавершенныхGUID.Добавить(GUIDЗадания);
					
				ИначеЕсли СостояниеЗадания = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
					СтруктураОшибки = Новый Структура;
					СтруктураОшибки.Вставить("ДоговорДУ", ИнформацияОЗадании.ДоговорДУ);
					СтруктураОшибки.Вставить("ТекстОшибки", "Задание завершилось с ошибкой");
					ВсеОшибки.Добавить(СтруктураОшибки);
					МассивЗавершенныхGUID.Добавить(GUIDЗадания);
					
				ИначеЕсли СостояниеЗадания = СостояниеФоновогоЗадания.Отменено Тогда
					МассивЗавершенныхGUID.Добавить(GUIDЗадания);
				КонецЕсли;
				
			Исключение
				СтруктураОшибки = Новый Структура;
				СтруктураОшибки.Вставить("ДоговорДУ", ИнформацияОЗадании.ДоговорДУ);
				СтруктураОшибки.Вставить("ТекстОшибки", "Ошибка проверки задания: " + ОписаниеОшибки());
				ВсеОшибки.Добавить(СтруктураОшибки);
				МассивЗавершенныхGUID.Добавить(GUIDЗадания);
			КонецПопытки;
			
		КонецЦикла;
		
		// Удалить завершенные из активных
		Для Каждого ЗавершенныйGUID Из МассивЗавершенныхGUID Цикл
			АктивныеЗадания.Удалить(ЗавершенныйGUID);
		КонецЦикла;
		
		// ШАГ 4.2: Запустить новые задания
		Пока АктивныеЗадания.Количество() < МаксимумОдновременныхЗаданий
			И ИндексОчереди < ОчередьДоговоров.Количество() Цикл
			
			ДоговорДУ = ОчередьДоговоров[ИндексОчереди];
			ТаблицаДанныхДоговора = ДанныеПоДоговорам[ДоговорДУ];
			
			АдресХранилищаРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
			
			ПараметрыФона = Новый Массив;
			ПараметрыФона.Добавить(XML(ТаблицаДанныхДоговора));
			ПараметрыФона.Добавить(Ложь);
			ПараметрыФона.Добавить(АдресХранилищаРезультата);
			ПараметрыФона.Добавить(ДоговорДУ);
			
			// Генерируем уникальный ключ задания (строка)
			КлючФоновогоЗадания = Строка(Новый УникальныйИдентификатор);
			
			Попытка
				// Запускаем фоновое задание
				ЗапущенноеЗадание = ФоновыеЗадания.Выполнить(
						"РаботаВФоновомРежиме.ВыполнитьПерезапускИсполненияПоДоговору",
						ПараметрыФона,
						КлючФоновогоЗадания,
						"Перезапуск по договору: " + Строка(ДоговорДУ)
					);
				
				// Получаем реальный идентификатор задания для отслеживания
				ИдентификаторЗадания = ЗапущенноеЗадание.УникальныйИдентификатор;
				
				ИнформацияОЗадании = Новый Структура;
				ИнформацияОЗадании.Вставить("ДоговорДУ", ДоговорДУ);
				ИнформацияОЗадании.Вставить("АдресХранилищаРезультата", АдресХранилищаРезультата);
				
				АктивныеЗадания.Вставить(ИдентификаторЗадания, ИнформацияОЗадании);
				ВсегоПотоковЗапущено = ВсегоПотоковЗапущено + 1;
				
			Исключение
				СтруктураОшибки = Новый Структура;
				СтруктураОшибки.Вставить("ДоговорДУ", ДоговорДУ);
				СтруктураОшибки.Вставить("ТекстОшибки", "Ошибка запуска задания: " + ОписаниеОшибки());
				ВсеОшибки.Добавить(СтруктураОшибки);
			КонецПопытки;
			
			ИндексОчереди = ИндексОчереди + 1;
		КонецЦикла;
		
		// ШАГ 4.3: Пауза
		Если АктивныеЗадания.Количество() > 0 Тогда
			VTB_ОбщийМодуль.Пауза(1); // 1 секунда
		КонецЕсли;
		
	КонецЦикла;
	
	// ШАГ 5: Вывод статистики
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВремяВыполненияМс = ВремяОкончания - ВремяНачала;
	ВремяВыполненияСек = ВремяВыполненияМс / 1000;
	
	// Форматируем время выполнения (упрощенно)
	ВремяВыполненияСтрокой = Строка(ВремяВыполненияСек) + " сек";
	
	Сообщить("=== ЗАВЕРШЕНО В ФОНОВОМ РЕЖИМЕ ===");
	Сообщить("Запущено потоков: " + ВсегоПотоковЗапущено);
	Сообщить("Обработано БП: " + ВсегоБПОбработано);
	Сообщить("Отменено задач: " + ВсегоЗадачОтменено);
	Сообщить("Пропущено задач: " + ВсегоЗадачПропущено);
	Сообщить("Время выполнения: " + ВремяВыполненияСтрокой);
	
	Если ВсеОшибки.Количество() > 0 Тогда
		Сообщить("!!! ОБНАРУЖЕНЫ ОШИБКИ: " + ВсеОшибки.Количество() + " !!!");
		Для Каждого Ошибка Из ВсеОшибки Цикл
			Сообщить("  - Договор: " + Ошибка.ДоговорДУ + ", Ошибка: " + Ошибка.ТекстОшибки);
		КонецЦикла;
	Иначе
		Сообщить("Ошибок не обнаружено.");
	КонецЕсли;
	
КонецПроцедуры

// Описание: Синхронный режим (для отладки и малого количества: от 1 до 9 БП)
//
&НаСервере
Процедура ОчиститьФлагВыполненоУЗадачСинхронно()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВТ.БизнесПроцесс КАК БизнесПроцесс,
		|	ВТ.ЗадачаКОтмене КАК ЗадачаКОтмене
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		СделкиTn.Ссылка КАК БизнесПроцесс,
		|		ЗадачаTn.Ссылка КАК ЗадачаКОтмене
		|	ИЗ
		|		Задача.ВнебиржеваяСделка КАК ЗадачаTn
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ БизнесПроцесс.СделкиTn КАК СделкиTn
		|			ПО ЗадачаTn.БизнесПроцесс = СделкиTn.Ссылка
		|				И (НЕ ЗадачаTn.ПометкаУдаления)
		|				И (НЕ СделкиTn.ПометкаУдаления)
		|				И (СделкиTn.АвтоматическоеВыполнениеЗадач)
		|				И (ЗадачаTn.Выполнена)
		|				И (ЗадачаTn.СрокИсполнения МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|				И (ВЫБОР
		|					КОГДА &РежимЗагрузки = 1
		|						ТОГДА СделкиTn.ДоговорДУ.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.ФизическиеЛица)
		|					КОГДА &РежимЗагрузки = 2
		|						ТОГДА НЕ СделкиTn.ДоговорДУ.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.ФизическиеЛица)
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ)
		|				И (СделкиTn.ДоговорДУ.Пул = ЗНАЧЕНИЕ(Справочник.Пул.ПустаяССылка))
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		СделкиРЕПО.Ссылка,
		|		ЗадачаРЕПО.Ссылка
		|	ИЗ
		|		Задача.ВнебиржеваяСделка КАК ЗадачаРЕПО
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ БизнесПроцесс.СделкиРЕПО КАК СделкиРЕПО
		|			ПО ЗадачаРЕПО.БизнесПроцесс = СделкиРЕПО.Ссылка
		|				И (НЕ ЗадачаРЕПО.ПометкаУдаления)
		|				И (НЕ СделкиРЕПО.ПометкаУдаления)
		|				И (СделкиРЕПО.АвтоматическоеВыполнениеЗадач)
		|				И (ЗадачаРЕПО.Выполнена)
		|				И (ЗадачаРЕПО.СрокИсполнения МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|				И (ВЫБОР
		|					КОГДА &РежимЗагрузки = 1
		|						ТОГДА СделкиРЕПО.ДоговорДУ.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.ФизическиеЛица)
		|					КОГДА &РежимЗагрузки = 2
		|						ТОГДА НЕ СделкиРЕПО.ДоговорДУ.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.ФизическиеЛица)
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ)
		|				И (СделкиРЕПО.ДоговорДУ.Пул = ЗНАЧЕНИЕ(Справочник.Пул.ПустаяССылка))) КАК ВТ
		|
		|УПОРЯДОЧИТЬ ПО
		|	БизнесПроцесс";
	
	Запрос.УстановитьПараметр("РежимЗагрузки", 0);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Объект.НачалоПериода));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Объект.ОкончаниеПериода));
	
	СписокБП = Запрос.Выполнить().Выгрузить();
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВыводитьПодробныйЛог = (Объект.КоличествоБПДляОбработки > 0 И Объект.КоличествоБПДляОбработки <= 10);
	
	КоличествоБПОбработано = 0;
	ВременныйБП = Неопределено;
	ЦиклПрерван = Ложь;
	
	Для Каждого ТекущийБП Из СписокБП Цикл
		
		Если ВременныйБП <> ТекущийБП.БизнесПроцесс Тогда
			
			Если ВременныйБП <> Неопределено Тогда
				КоличествоБПОбработано = КоличествоБПОбработано + 1;
			КонецЕсли;
			
			Если Объект.КоличествоБПДляОбработки > 0 И КоличествоБПОбработано >= Объект.КоличествоБПДляОбработки Тогда
				ЦиклПрерван = Истина;
				Прервать;
			КонецЕсли;
			
			ВременныйБП = ТекущийБП.БизнесПроцесс;
			Если ВыводитьПодробныйЛог Тогда
				Сообщить("БП " + (КоличествоБПОбработано + 1) + ": " + ТекущийБП.БизнесПроцесс);
			КонецЕсли;
			
			ПереоткрытьБизнесПроцессЕслиЗакрыт(ВременныйБП, ВыводитьПодробныйЛог);
			
		КонецЕсли;
		
		ОтменитьЗадачуБизнесПроцесса(ТекущийБП.БизнесПроцесс, ТекущийБП.ЗадачаКОтмене, ВыводитьПодробныйЛог);
		
	КонецЦикла;
	
	Если ВременныйБП <> Неопределено И НЕ ЦиклПрерван Тогда
		КоличествоБПОбработано = КоличествоБПОбработано + 1;
	КонецЕсли;
	
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВремяВыполненияМс = ВремяОкончания - ВремяНачала;
	ВремяВыполненияСек = ВремяВыполненияМс / 1000;
	
	Сообщить("Обработано БП: " + КоличествоБПОбработано + " | Время: " + ВремяВыполненияСек + " сек");
	
КонецПроцедуры

// Описание: Переоткрывает бизнес-процесс, если он закрыт
//           ОСТАВЛЕНО ДЛЯ СИНХРОННОГО РЕЖИМА
//
&НаСервере
Процедура ПереоткрытьБизнесПроцессЕслиЗакрыт(БизнесПроцесс, ВыводитьПодробныйЛог = Ложь)
	// Используем ту же логику, что и в общем модуле, но локально для синхронного режима
	// В идеале вызывать общий модуль: РаботаВФоновомРежиме.ПереоткрытьБизнесПроцессЕслиЗакрыт(...)
	// Но оставляем локальную копию для автономности при отладке без обновления конфигурации БД
	
	Если БизнесПроцесс.Завершен Тогда
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			ОбъектБП = БизнесПроцесс.ПолучитьОбъект();
			Если ОбъектБП.Завершен = Истина Тогда
				ОбъектБП.Завершен = Ложь;
				ОбъектБП.ДатаЗавершения = '00010101';
				Попытка
					ОбъектБП.Записать();
					Если ВыводитьПодробныйЛог Тогда Сообщить("  БП переоткрыт"); КонецЕсли;
				Исключение
					Сообщить("Не удалось переоткрыть БП: " + БизнесПроцесс);
				КонецПопытки;
			КонецЕсли;
		Исключение
			Сообщить("Ошибка при переоткрытии БП: " + БизнесПроцесс + " | " + ОписаниеОшибки());
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
КонецПроцедуры

// Описание: Отменяет конкретную задачу бизнес-процесса
//           ОСТАВЛЕНО ДЛЯ СИНХРОННОГО РЕЖИМА
//
&НаСервере
Процедура ОтменитьЗадачуБизнесПроцесса(БизнесПроцесс, ЗадачаКОтмене, ВыводитьПодробныйЛог = Ложь)
	// Локальная копия для синхронного режима
	
	ТочкаМаршрутаУстановкаНастроек = Неопределено;
	Если ТипЗнч(БизнесПроцесс) = Тип("БизнесПроцессСсылка.СделкиTn") Тогда
		ТочкаМаршрутаУстановкаНастроек = БизнесПроцессы.СделкиTn.ТочкиМаршрута.УстановкаНастроекБП;
	ИначеЕсли ТипЗнч(БизнесПроцесс) = Тип("БизнесПроцессСсылка.СделкиРЕПО") Тогда
		ТочкаМаршрутаУстановкаНастроек = БизнесПроцессы.СделкиРЕПО.ТочкиМаршрута.УстановкаНастроекБП;
	Иначе
		Сообщить("Такой БП не поддерживается: " + БизнесПроцесс);
		Возврат;
	КонецЕсли;
	
	Если ЗадачаКОтмене.ТочкаМаршрута <> ТочкаМаршрутаУстановкаНастроек Тогда
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			ТекЗадача = ЗадачаКОтмене.ПолучитьОбъект();
			ТекЗадача.Выполнена = Ложь;
			ТекЗадача.СинхронизоватьПредметПоЗадаче = Истина;
			ТекЗадача.Записать();
			Если ВыводитьПодробныйЛог Тогда Сообщить("  Задача отменена: " + ЗадачаКОтмене.ТочкаМаршрута); КонецЕсли;
		Исключение
			Сообщить("Не удалось отменить задачу: " + ЗадачаКОтмене + " | " + ОписаниеОшибки());
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);
	Иначе
		Если ВыводитьПодробныйЛог Тогда Сообщить("  Задача пропущена (УстановкаНастроекБП)"); КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Функция сериализует данные в XML-строку.
// Для передачи в фоновое задание
&НаСервере
Функция XML(Данные)
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Данные);
	Возврат ЗаписьXML.Закрыть();
КонецФункции