// Описание: Выполняет перезапуск исполнения для списка БП и задач по одному договору ДУ
//           Вызывается в фоновом задании
//
// Параметры:
//   ТаблицаБПИЗадачXML - Строка - XML-строка с сериализованной таблицей БП и задач для обработки
//   ВыводитьПодробныйЛог - Булево - флаг подробного логирования
//   АдресХранилищаРезультата - Строка - адрес временного хранилища для возврата результатов
//   ДоговорДУ - СправочникСсылка.ДоговорДУ - договор доверительного управления для обработки
//
Процедура ВыполнитьПерезапускИсполненияПоДоговору(ТаблицаБПИЗадачXML, ВыводитьПодробныйЛог, АдресХранилищаРезультата, ДоговорДУ) Экспорт
	
	// Десериализация таблицы данных
	ТаблицаДанных = ДанныеИзXML(ТаблицаБПИЗадачXML);
	
	КоличествоБПОбработано = 0;
	КоличествоЗадачОтменено = 0;
	КоличествоЗадачПропущено = 0;
	Ошибки = Новый Массив;
	
	ВременныйБП = Неопределено;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		
		ТекущийБП = СтрокаДанных.БизнесПроцесс;
		ЗадачаКОтмене = СтрокаДанных.ЗадачаКОтмене;
		
		// Проверяем, новый ли это БП
		Если ВременныйБП <> ТекущийБП Тогда
			
			// Если это новый БП, учитываем предыдущий БП ПОСЛЕ обработки всех его задач
			Если ВременныйБП <> Неопределено Тогда
				КоличествоБПОбработано = КоличествоБПОбработано + 1;
			КонецЕсли;
			
			ВременныйБП = ТекущийБП;
			
			// Переоткрываем БП один раз при обнаружении нового БП (если он закрыт)
			Попытка
				ПереоткрытьБизнесПроцессЕслиЗакрыт(ВременныйБП, ВыводитьПодробныйЛог);
			Исключение
				СтруктураОшибки = Новый Структура;
				СтруктураОшибки.Вставить("БизнесПроцесс", ВременныйБП);
				СтруктураОшибки.Вставить("ТекстОшибки", "Ошибка переоткрытия БП: " + ОписаниеОшибки());
				Ошибки.Добавить(СтруктураОшибки);
			КонецПопытки;
			
		КонецЕсли;
		
		// Отменяем конкретную задачу
		Попытка
			РезультатОтмены = ОтменитьЗадачуБизнесПроцесса(ТекущийБП, ЗадачаКОтмене, ВыводитьПодробныйЛог);
			Если РезультатОтмены = "Отменена" Тогда
				КоличествоЗадачОтменено = КоличествоЗадачОтменено + 1;
			ИначеЕсли РезультатОтмены = "Пропущена" Тогда
				КоличествоЗадачПропущено = КоличествоЗадачПропущено + 1;
			КонецЕсли;
		Исключение
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("БизнесПроцесс", ТекущийБП);
			СтруктураОшибки.Вставить("Задача", ЗадачаКОтмене);
			СтруктураОшибки.Вставить("ТекстОшибки", "Ошибка отмены задачи: " + ОписаниеОшибки());
			Ошибки.Добавить(СтруктураОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	// Учитываем последний обработанный БП
	Если ВременныйБП <> Неопределено Тогда
		КоличествоБПОбработано = КоличествоБПОбработано + 1;
	КонецЕсли;
	
	// Формируем результат
	Результат = Новый Структура;
	Результат.Вставить("КоличествоБПОбработано", КоличествоБПОбработано);
	Результат.Вставить("КоличествоЗадачОтменено", КоличествоЗадачОтменено);
	Результат.Вставить("КоличествоЗадачПропущено", КоличествоЗадачПропущено);
	Результат.Вставить("Ошибки", Ошибки);
	
	// Логирование в журнал регистрации
	Если ДоговорДУ <> Неопределено Тогда
		
		ТекстСообщения = "Договор ДУ переоткрыт: " + Строка(ДоговорДУ) +
			". Обработано БП: " + Формат(КоличествоБПОбработано, "ЧГ=0") +
			", отменено задач: " + Формат(КоличествоЗадачОтменено, "ЧГ=0") +
			", пропущено задач: " + Формат(КоличествоЗадачПропущено, "ЧГ=0");
		
		Если Ошибки.Количество() > 0 Тогда
			ТекстСообщения = ТекстСообщения + ", ошибок: " + Формат(Ошибки.Количество(), "ЧГ=0");
		КонецЕсли;
		
		УровеньЖурнала = ?(Ошибки.Количество() > 0, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация);
		
		ЗаписьЖурналаРегистрации(
			"ПерезапускИсполнения.ОбработкаДоговора",
			УровеньЖурнала,
			Метаданные.Справочники.ДоговорДУ,
			ДоговорДУ,
			ТекстСообщения
		);
		
	КонецЕсли;
	
	// Помещаем результат во временное хранилище
	ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультата);
	
КонецПроцедуры

// Описание: Переоткрывает бизнес-процесс, если он закрыт
//
Процедура ПереоткрытьБизнесПроцессЕслиЗакрыт(БизнесПроцесс, ВыводитьПодробныйЛог = Ложь) Экспорт
	
	Если БизнесПроцесс.Завершен Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Попытка
			ОбъектБП = БизнесПроцесс.ПолучитьОбъект();
			Если ОбъектБП.Завершен = Истина Тогда
				ОбъектБП.Завершен = Ложь;
				ОбъектБП.ДатаЗавершения = '00010101';
				ОбъектБП.Записать();
			КонецЕсли;
		Исключение
			ВызватьИсключение; // Пробрасываем исключение наверх
		КонецПопытки;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

// Описание: Отменяет конкретную задачу бизнес-процесса
// Возвращаемое значение: Строка - "Отменена", "Пропущена" или вызывает исключение
//
Функция ОтменитьЗадачуБизнесПроцесса(БизнесПроцесс, ЗадачаКОтмене, ВыводитьПодробныйЛог = Ложь) Экспорт
	
	// Определяем точку маршрута "УстановкаНастроекБП" для данного типа БП
	ТочкаМаршрутаУстановкаНастроек = Неопределено;
	Если ТипЗнч(БизнесПроцесс) = Тип("БизнесПроцессСсылка.СделкиTn") Тогда
		ТочкаМаршрутаУстановкаНастроек = БизнесПроцессы.СделкиTn.ТочкиМаршрута.УстановкаНастроекБП;
	ИначеЕсли ТипЗнч(БизнесПроцесс) = Тип("БизнесПроцессСсылка.СделкиРЕПО") Тогда
		ТочкаМаршрутаУстановкаНастроек = БизнесПроцессы.СделкиРЕПО.ТочкиМаршрута.УстановкаНастроекБП;
	Иначе
		ВызватьИсключение "Неподдерживаемый тип БП: " + БизнесПроцесс;
	КонецЕсли;
	
	// Отменяем задачу (кроме точки маршрута "УстановкаНастроекБП")
	Если ЗадачаКОтмене.ТочкаМаршрута <> ТочкаМаршрутаУстановкаНастроек Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Попытка
			ТекЗадача = ЗадачаКОтмене.ПолучитьОбъект();
			ТекЗадача.Выполнена = Ложь;
			ТекЗадача.СинхронизоватьПредметПоЗадаче = Истина;
			ТекЗадача.Записать();
			
			УстановитьПривилегированныйРежим(Ложь);
			Возврат "Отменена";
		Исключение
			УстановитьПривилегированныйРежим(Ложь);
			ВызватьИсключение; // Пробрасываем исключение
		КонецПопытки;
		
	Иначе
		Возврат "Пропущена";
	КонецЕсли;
	
КонецФункции

#Область СлужебныеПроцедурыИФункции

// Функция сериализует данные в XML-строку.
Функция XML(Данные) Экспорт
	
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Данные);
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

// Функция десериализует данные из XML-строки.
Функция ДанныеИзXML(Стр) Экспорт
	
	ЧтениеXML = Новый ЧтениеXML();
	ЧтениеXML.УстановитьСтроку(Стр);
	
	Возврат СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	
КонецФункции

#КонецОбласти