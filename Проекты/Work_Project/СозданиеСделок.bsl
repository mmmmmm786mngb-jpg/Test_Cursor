// Описание: Алгоритм создания N документов Сделка с соблюдением пропорций
//           Распределяет сделки между договорами по степенному закону,
//           соблюдает пропорции по типам активов и видам операций
//
// Требования:
//   - Минимум 10 сделок на каждый договор (3 поступления, 7 списаний)
//   - Не может быть договоров с 0 сделок
//   - Общее количество сделок строго равно N
//   - Пропорция Акции:Облигации:Паи = 15:25:10 по всем сделкам (включая списания)
//   - Пропорция Поступление:Списание = 30:70 для каждого договора
//   - Списания используют активы из поступлений по тому же договору
//   - Количество актива: 100 для поступлений, 2 для списаний
//
// Параметры основной процедуры:
//   МассивДоговоров - Массив - массив ссылок на ДоговорДУ (от 1 до 1100)
//   N - Число - общее количество сделок для создания (минимум = количеств_договоров * 10)
//   МассивАкций - Массив - массив из 15 ссылок на Активы (тип: Акции)
//   МассивОблигаций - Массив - массив из 25 ссылок на Активы (тип: Облигации)
//   МассивПаев - Массив - массив из 10 ссылок на Активы (тип: Паи)
//
// Пример:
//   СоздатьСделки(МассивДоговоров, 100, МассивАкций, МассивОблигаций, МассивПаев);

#Область РаспределениеСделок

// Описание: Распределяет N сделок между договорами по степенному закону
//           Создает эффект "несколько больших, средние, много мелких"
//           Гарантирует минимум 10 сделок на каждый договор
//
// Параметры:
//   МассивДоговоров - Массив - массив ссылок на ДоговорДУ
//   N - Число - общее количество сделок
//
// Возвращаемое значение:
//   Соответствие - соответствие ДоговорДУ → количество сделок
//
Функция РаспределитьСделкиПоДоговорам(МассивДоговоров, N)
	
	КоличествоДоговоров = МассивДоговоров.Количество();
	Результат = Новый Соответствие;
	
	Если КоличествоДоговоров = 0 ИЛИ N = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Минимальное количество сделок на договор = 10
	МинимумСделокНаДоговор = 10;
	МинимумВсегоСделок = КоличествоДоговоров * МинимумСделокНаДоговор;
	
	Если N < МинимумВсегоСделок Тогда
		ВызватьИсключение "Недостаточно сделок для распределения. Требуется минимум " +
		Строка(МинимумВсегоСделок) + " сделок для " + Строка(КоличествоДоговоров) + " договоров";
	КонецЕсли;
	
	// Сначала каждому договору даем минимум
	ОстатокСделок = N - МинимумВсегоСделок;
	
	// Вычисляем среднее количество сделок на договор
	СреднееСделокНаДоговор = N / КоличествоДоговоров;
	
	// Максимальное количество сделок на договор (ограничение для более равномерного распределения)
	// При среднем 100, максимум = 2000 (20x среднего)
	МаксимумСделокНаДоговор = Окр(СреднееСделокНаДоговор * 20);
	Если МаксимумСделокНаДоговор < МинимумСделокНаДоговор + 100 Тогда
		МаксимумСделокНаДоговор = МинимумСделокНаДоговор + 100;
	КонецЕсли;
	
	// Вычисляем веса для более плавного степенного распределения остатка
	// Используем формулу: вес[i] = 1 / (i+1)^alpha, где alpha = 0.7 (более плавное распределение)
	// Но применяем веса только к первым договорам, чтобы последние остались на минимуме
	МассивВесов = Новый Массив;
	СуммаВесов = 0;
	
	// Определяем количество договоров, которые получат дополнительные сделки
	// Остальные останутся на минимуме
	КоличествоДоговоровСДополнительными = Окр(КоличествоДоговоров * 0.7); // 70% договоров получат дополнительные сделки
	Если КоличествоДоговоровСДополнительными < 1 Тогда
		КоличествоДоговоровСДополнительными = 1;
	КонецЕсли;
	
	Для i = 0 По КоличествоДоговоровСДополнительными - 1 Цикл
		Вес = 1 / Pow(i + 1, 0.7);
		МассивВесов.Добавить(Вес);
		СуммаВесов = СуммаВесов + Вес;
	КонецЦикла;
	
	// Распределяем остаток по степенному закону только среди первых договоров
	// Последние договоры остаются на минимуме
	ОбщийИзлишек = 0;
	
	Для i = 0 По КоличествоДоговоров - 1 Цикл
		
		Если i < КоличествоДоговоровСДополнительными Тогда
			// Первые договоры получают дополнительные сделки по степенному закону
			Если i = КоличествоДоговоровСДополнительными - 1 Тогда
				// Последнему договору с дополнительными отдаем весь остаток
				ДополнительноСделок = ОстатокСделок;
			Иначе
				ДополнительноСделок = Окр(ОстатокСделок * МассивВесов[i] / СуммаВесов);
				ОстатокСделок = ОстатокСделок - ДополнительноСделок;
			КонецЕсли;
			
			КоличествоСделок = МинимумСделокНаДоговор + ДополнительноСделок;
			
			// Применяем ограничение максимума
			Если КоличествоСделок > МаксимумСделокНаДоговор Тогда
				Излишек = КоличествоСделок - МаксимумСделокНаДоговор;
				КоличествоСделок = МаксимумСделокНаДоговор;
				ОбщийИзлишек = ОбщийИзлишек + Излишек;
			КонецЕсли;
		Иначе
			// Последние договоры остаются на минимуме
			КоличествоСделок = МинимумСделокНаДоговор;
		КонецЕсли;
		
		Результат.Вставить(МассивДоговоров[i], КоличествоСделок);
		
	КонецЦикла;
	
	// Перераспределяем излишек среди договоров, которые не достигли максимума
	// При этом стараемся сохранить последние договоры на минимуме
	Если ОбщийИзлишек > 0 Тогда
		
		// Собираем договоры, которые могут получить дополнительные сделки
		// Исключаем договоры, которые уже на минимуме (чтобы сохранить их на минимуме)
		МассивДоговоровДляДобавления = Новый Массив;
		
		Для Каждого ЭлементРаспределения Из Результат Цикл
			Если ЭлементРаспределения.Значение < МаксимумСделокНаДоговор
				И ЭлементРаспределения.Значение > МинимумСделокНаДоговор Тогда
				МассивДоговоровДляДобавления.Добавить(ЭлементРаспределения);
			КонецЕсли;
		КонецЦикла;
		
		// Если есть договоры для добавления, распределяем излишек среди них
		Если МассивДоговоровДляДобавления.Количество() > 0 Тогда
			
			// Распределяем излишек равномерно среди договоров, которые не на минимуме
			ДобавитьНаДоговор = Окр(ОбщийИзлишек / МассивДоговоровДляДобавления.Количество());
			
			Для Каждого ЭлементРаспределения Из МассивДоговоровДляДобавления Цикл
				МожноДобавить = МаксимумСделокНаДоговор - ЭлементРаспределения.Значение;
				Добавить = Мин(ДобавитьНаДоговор, МожноДобавить);
				ЭлементРаспределения.Значение = ЭлементРаспределения.Значение + Добавить;
				ОбщийИзлишек = ОбщийИзлишек - Добавить;
			КонецЦикла;
			
			// Если остался остаток, распределяем его по одному
			Для Каждого ЭлементРаспределения Из МассивДоговоровДляДобавления Цикл
				Если ОбщийИзлишек <= 0 Тогда
					Прервать;
				КонецЕсли;
				
				Если ЭлементРаспределения.Значение < МаксимумСделокНаДоговор Тогда
					ЭлементРаспределения.Значение = ЭлементРаспределения.Значение + 1;
					ОбщийИзлишек = ОбщийИзлишек - 1;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// Если все еще остался излишек, распределяем его только среди договоров,
		// которые не на минимуме и не на максимуме (чтобы сохранить минимум для последних договоров)
		Если ОбщийИзлишек > 0 Тогда
			
			// Собираем договоры, которые не на минимуме и не на максимуме
			МассивДоговоровДляДобавления = Новый Массив;
			Для Каждого ЭлементРаспределения Из Результат Цикл
				Если ЭлементРаспределения.Значение > МинимумСделокНаДоговор
					И ЭлементРаспределения.Значение < МаксимумСделокНаДоговор Тогда
					МассивДоговоровДляДобавления.Добавить(ЭлементРаспределения);
				КонецЕсли;
			КонецЦикла;
			
			Если МассивДоговоровДляДобавления.Количество() > 0 Тогда
				// Распределяем по одному
				Пока ОбщийИзлишек > 0 Цикл
					ИзмененоЧтоТо = Ложь;
					Для Каждого ЭлементРаспределения Из МассивДоговоровДляДобавления Цикл
						Если ОбщийИзлишек <= 0 Тогда
							Прервать;
						КонецЕсли;
						
						Если ЭлементРаспределения.Значение < МаксимумСделокНаДоговор Тогда
							ЭлементРаспределения.Значение = ЭлементРаспределения.Значение + 1;
							ОбщийИзлишек = ОбщийИзлишек - 1;
							ИзмененоЧтоТо = Истина;
						КонецЕсли;
					КонецЦикла;
					
					Если НЕ ИзмененоЧтоТо Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// Финальная проверка и корректировка суммы до N (выполняется всегда)
	ТекущаяСумма = 0;
	Для Каждого ЭлементРаспределения Из Результат Цикл
		ТекущаяСумма = ТекущаяСумма + ЭлементРаспределения.Значение;
	КонецЦикла;
	
	Разница = N - ТекущаяСумма;
	
	Если Разница <> 0 Тогда
		// Корректируем последний договор с дополнительными (если есть)
		// или последний договор вообще
		Если КоличествоДоговоровСДополнительными > 0 Тогда
			ПоследнийДоговор = МассивДоговоров[КоличествоДоговоровСДополнительными - 1];
		Иначе
			ПоследнийДоговор = МассивДоговоров[КоличествоДоговоров - 1];
		КонецЕсли;
		
		Результат.Получить(ПоследнийДоговор).Значение = Результат.Получить(ПоследнийДоговор).Значение + Разница;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Описание: Распределяет количество сделок по типам активов в пропорции 15:25:10
//
// Параметры:
//   КоличествоСделок - Число - количество сделок для распределения
//
// Возвращаемое значение:
//   Структура - структура с полями: Акции, Облигации, Паи
//
Функция РаспределитьПоТипамАктивов(КоличествоСделок)
	
	// Пропорция: Акции:Облигации:Паи = 15:25:10
	// Сумма пропорций = 50
	СуммаПропорций = 50;
	
	КоличествоАкций = Окр(КоличествоСделок * 15 / СуммаПропорций);
	КоличествоОблигаций = Окр(КоличествоСделок * 25 / СуммаПропорций);
	КоличествоПаев = КоличествоСделок - КоличествоАкций - КоличествоОблигаций;
	
	Возврат Новый Структура("Акции, Облигации, Паи",
		КоличествоАкций, КоличествоОблигаций, КоличествоПаев);
	
КонецФункции

// Описание: Распределяет количество сделок по видам операций в пропорции 30:70
//
// Параметры:
//   КоличествоСделок - Число - количество сделок для распределения
//
// Возвращаемое значение:
//   Структура - структура с полями: Поступление, Списание
//
Функция РаспределитьПоВидамОпераций(КоличествоСделок)
	
	КоличествоПоступлений = Окр(КоличествоСделок * 30 / 100);
	КоличествоСписаний = КоличествоСделок - КоличествоПоступлений;
	
	Возврат Новый Структура("Поступление, Списание",
		КоличествоПоступлений, КоличествоСписаний);
	
КонецФункции

#КонецОбласти

#Область СозданиеПоступленийИСписаний

// Описание: Создает поступления с случайным выбором активов
//           Сохраняет активы с типами в структуру для последующего использования в списаниях
//
// Параметры:
//   ДоговорДУ - СправочникСсылка.ДоговорДУ - договор для создания поступлений
//   РаспределениеАктивов - Структура - структура с полями: Акции, Облигации, Паи
//   МассивАкций - Массив - массив ссылок на Активы (тип: Акции)
//   МассивОблигаций - Массив - массив ссылок на Активы (тип: Облигации)
//   МассивПаев - Массив - массив ссылок на Активы (тип: Паи)
//   ПоступленияПоДоговорам - Соответствие - соответствие ДоговорДУ → структура с массивами активов по типам
//   СписокСделок - Массив - массив структур с данными для создания сделок
//
Процедура СоздатьПоступления(ДоговорДУ, РаспределениеАктивов,
		МассивАкций, МассивОблигаций, МассивПаев,
		ПоступленияПоДоговорам, СписокСделок)
	
	СтруктураПоступлений = ПоступленияПоДоговорам.Получить(ДоговорДУ);
	
	// Создаем поступления с Акциями
	Счетчик = 0;
	Пока Счетчик < РаспределениеАктивов.Акции Цикл
		
		Если МассивАкций.Количество() = 0 Тогда
			Счетчик = Счетчик + 1;
			Продолжить;
		КонецЕсли;
		
		СлучайныйИндекс = Цел(СлучайноеЧисло() * МассивАкций.Количество());
		Если СлучайныйИндекс >= МассивАкций.Количество() Тогда
			СлучайныйИндекс = МассивАкций.Количество() - 1;
		КонецЕсли;
		
		Актив = МассивАкций[СлучайныйИндекс];
		
		ДанныеСделки = Новый Структура;
		ДанныеСделки.Вставить("ДоговорДУ", ДоговорДУ);
		ДанныеСделки.Вставить("ВидОперации", Перечисления.ВидыОперацийСделка.Поступление);
		ДанныеСделки.Вставить("Актив", Актив);
		ДанныеСделки.Вставить("КоличествоАктива", 100);
		
		СписокСделок.Добавить(ДанныеСделки);
		СтруктураПоступлений.Акции.Добавить(Актив);
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	// Создаем поступления с Облигациями
	Счетчик = 0;
	Пока Счетчик < РаспределениеАктивов.Облигации Цикл
		
		Если МассивОблигаций.Количество() = 0 Тогда
			Счетчик = Счетчик + 1;
			Продолжить;
		КонецЕсли;
		
		СлучайныйИндекс = Цел(СлучайноеЧисло() * МассивОблигаций.Количество());
		Если СлучайныйИндекс >= МассивОблигаций.Количество() Тогда
			СлучайныйИндекс = МассивОблигаций.Количество() - 1;
		КонецЕсли;
		
		Актив = МассивОблигаций[СлучайныйИндекс];
		
		ДанныеСделки = Новый Структура;
		ДанныеСделки.Вставить("ДоговорДУ", ДоговорДУ);
		ДанныеСделки.Вставить("ВидОперации", Перечисления.ВидыОперацийСделка.Поступление);
		ДанныеСделки.Вставить("Актив", Актив);
		ДанныеСделки.Вставить("КоличествоАктива", 100);
		
		СписокСделок.Добавить(ДанныеСделки);
		СтруктураПоступлений.Облигации.Добавить(Актив);
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	// Создаем поступления с Паями
	Счетчик = 0;
	Пока Счетчик < РаспределениеАктивов.Паи Цикл
		
		Если МассивПаев.Количество() = 0 Тогда
			Счетчик = Счетчик + 1;
			Продолжить;
		КонецЕсли;
		
		СлучайныйИндекс = Цел(СлучайноеЧисло() * МассивПаев.Количество());
		Если СлучайныйИндекс >= МассивПаев.Количество() Тогда
			СлучайныйИндекс = МассивПаев.Количество() - 1;
		КонецЕсли;
		
		Актив = МассивПаев[СлучайныйИндекс];
		
		ДанныеСделки = Новый Структура;
		ДанныеСделки.Вставить("ДоговорДУ", ДоговорДУ);
		ДанныеСделки.Вставить("ВидОперации", Перечисления.ВидыОперацийСделка.Поступление);
		ДанныеСделки.Вставить("Актив", Актив);
		ДанныеСделки.Вставить("КоличествоАктива", 100);
		
		СписокСделок.Добавить(ДанныеСделки);
		СтруктураПоступлений.Паи.Добавить(Актив);
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
КонецПроцедуры

// Описание: Создает списания с соблюдением пропорции 15:25:10
//           Выбирает активы из поступлений по тому же договору
//           Может использовать один и тот же актив несколько раз
//
// Параметры:
//   ДоговорДУ - СправочникСсылка.ДоговорДУ - договор для создания списаний
//   КоличествоСписаний - Число - количество списаний для создания
//   ПоступленияПоДоговорам - Соответствие - соответствие ДоговорДУ → структура с массивами активов по типам
//   СписокСделок - Массив - массив структур с данными для создания сделок
//
Процедура СоздатьСписания(ДоговорДУ, КоличествоСписаний,
		ПоступленияПоДоговорам, СписокСделок)
	
	СтруктураПоступлений = ПоступленияПоДоговорам.Получить(ДоговорДУ);
	
	// Проверяем наличие поступлений
	ВсегоПоступлений = СтруктураПоступлений.Акции.Количество() +
		СтруктураПоступлений.Облигации.Количество() +
		СтруктураПоступлений.Паи.Количество();
	
	Если ВсегоПоступлений = 0 Тогда
		// Если нет поступлений, пропускаем списания
		Возврат;
	КонецЕсли;
	
	// Распределяем списания по типам активов в пропорции 15:25:10
	РаспределениеСписаний = РаспределитьПоТипамАктивов(КоличествоСписаний);
	
	// Создаем общий массив всех доступных активов для использования при отсутствии нужного типа
	МассивВсехАктивов = Новый Массив;
	
	Для Каждого Актив Из СтруктураПоступлений.Акции Цикл
		МассивВсехАктивов.Добавить(Актив);
	КонецЦикла;
	
	Для Каждого Актив Из СтруктураПоступлений.Облигации Цикл
