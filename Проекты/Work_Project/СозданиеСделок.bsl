		МассивВсехАктивов.Добавить(Актив);
	КонецЦикла;
	
	// Создаем списания с Акциями
	Счетчик = 0;
	Пока Счетчик < РаспределениеСписаний.Акции Цикл
		
		Если СтруктураПоступлений.Акции.Количество() > 0 Тогда
			// Если есть акции в поступлениях, используем их
			СлучайныйИндекс = Цел(СлучайноеЧисло() * СтруктураПоступлений.Акции.Количество());
			Если СлучайныйИндекс >= СтруктураПоступлений.Акции.Количество() Тогда
				СлучайныйИндекс = СтруктураПоступлений.Акции.Количество() - 1;
			КонецЕсли;
			Актив = СтруктураПоступлений.Акции[СлучайныйИндекс];
		Иначе
			// Если нет акций, используем любой доступный актив из поступлений
			Если МассивВсехАктивов.Количество() = 0 Тогда
				Счетчик = Счетчик + 1;
				Продолжить;
			КонецЕсли;
			СлучайныйИндекс = Цел(СлучайноеЧисло() * МассивВсехАктивов.Количество());
			Если СлучайныйИндекс >= МассивВсехАктивов.Количество() Тогда
				СлучайныйИндекс = МассивВсехАктивов.Количество() - 1;
			КонецЕсли;
			Актив = МассивВсехАктивов[СлучайныйИндекс];
		КонецЕсли;
		
		ДанныеСделки = Новый Структура;
		ДанныеСделки.Вставить("ДоговорДУ", ДоговорДУ);
		ДанныеСделки.Вставить("ВидОперации", Перечисления.ВидыОперацийСделка.Списание);
		ДанныеСделки.Вставить("Актив", Актив);
		ДанныеСделки.Вставить("КоличествоАктива", 2);
		
		СписокСделок.Добавить(ДанныеСделки);
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	// Создаем списания с Облигациями
	Счетчик = 0;
	Пока Счетчик < РаспределениеСписаний.Облигации Цикл
		
		Если СтруктураПоступлений.Облигации.Количество() > 0 Тогда
			// Если есть облигации в поступлениях, используем их
			СлучайныйИндекс = Цел(СлучайноеЧисло() * СтруктураПоступлений.Облигации.Количество());
			Если СлучайныйИндекс >= СтруктураПоступлений.Облигации.Количество() Тогда
				СлучайныйИндекс = СтруктураПоступлений.Облигации.Количество() - 1;
			КонецЕсли;
			Актив = СтруктураПоступлений.Облигации[СлучайныйИндекс];
		Иначе
			// Если нет облигаций, используем любой доступный актив из поступлений
			Если МассивВсехАктивов.Количество() = 0 Тогда
				Счетчик = Счетчик + 1;
				Продолжить;
			КонецЕсли;
			СлучайныйИндекс = Цел(СлучайноеЧисло() * МассивВсехАктивов.Количество());
			Если СлучайныйИндекс >= МассивВсехАктивов.Количество() Тогда
				СлучайныйИндекс = МассивВсехАктивов.Количество() - 1;
			КонецЕсли;
			Актив = МассивВсехАктивов[СлучайныйИндекс];
		КонецЕсли;
		
		ДанныеСделки = Новый Структура;
		ДанныеСделки.Вставить("ДоговорДУ", ДоговорДУ);
		ДанныеСделки.Вставить("ВидОперации", Перечисления.ВидыОперацийСделка.Списание);
		ДанныеСделки.Вставить("Актив", Актив);
		ДанныеСделки.Вставить("КоличествоАктива", 2);
		
		СписокСделок.Добавить(ДанныеСделки);
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	// Создаем списания с Паями
	Счетчик = 0;
	Пока Счетчик < РаспределениеСписаний.Паи Цикл
		
		Если СтруктураПоступлений.Паи.Количество() > 0 Тогда
			// Если есть паи в поступлениях, используем их
			СлучайныйИндекс = Цел(СлучайноеЧисло() * СтруктураПоступлений.Паи.Количество());
			Если СлучайныйИндекс >= СтруктураПоступлений.Паи.Количество() Тогда
				СлучайныйИндекс = СтруктураПоступлений.Паи.Количество() - 1;
			КонецЕсли;
			Актив = СтруктураПоступлений.Паи[СлучайныйИндекс];
		Иначе
			// Если нет паев, используем любой доступный актив из поступлений
			Если МассивВсехАктивов.Количество() = 0 Тогда
				Счетчик = Счетчик + 1;
				Продолжить;
			КонецЕсли;
			СлучайныйИндекс = Цел(СлучайноеЧисло() * МассивВсехАктивов.Количество());
			Если СлучайныйИндекс >= МассивВсехАктивов.Количество() Тогда
				СлучайныйИндекс = МассивВсехАктивов.Количество() - 1;
			КонецЕсли;
			Актив = МассивВсехАктивов[СлучайныйИндекс];
		КонецЕсли;
		
		ДанныеСделки = Новый Структура;
		ДанныеСделки.Вставить("ДоговорДУ", ДоговорДУ);
		ДанныеСделки.Вставить("ВидОперации", Перечисления.ВидыОперацийСделка.Списание);
		ДанныеСделки.Вставить("Актив", Актив);
		ДанныеСделки.Вставить("КоличествоАктива", 2);
		
		СписокСделок.Добавить(ДанныеСделки);
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
КонецПроцедуры

