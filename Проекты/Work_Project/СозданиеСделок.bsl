#Область СозданиеДокументов

// Описание: Создает документ Сделка в базе данных
//
// Параметры:
//   ДанныеСделки - Структура - структура с полями:
//     ДоговорДУ - СправочникСсылка.ДоговорДУ
//     ВидОперации - ПеречислениеСсылка.ВидыОперацийСделка
//     Актив - СправочникСсылка.Активы
//     КоличествоАктива - Число
//
Процедура СоздатьДокументСделка(ДанныеСделки)
	
	МенеджерСделок = Документы.Сделка;
	НовыйДокумент = МенеджерСделок.СоздатьДокумент();
	
	НовыйДокумент.ДоговорДУ = ДанныеСделки.ДоговорДУ;
	НовыйДокумент.ВидОперации = ДанныеСделки.ВидОперации;
	НовыйДокумент.Актив = ДанныеСделки.Актив;
	
	// Устанавливаем количество актива
	// Примечание: если поле называется иначе (например, Количество),
	// необходимо скорректировать имя поля
	Попытка
		НовыйДокумент.КоличествоАктива = ДанныеСделки.КоличествоАктива;
	Исключение
		// Если поле КоличествоАктива не существует, пробуем Количество
		Попытка
			НовыйДокумент.Количество = ДанныеСделки.КоличествоАктива;
		Исключение
			// Поле может отсутствовать или иметь другое имя
			// В этом случае необходимо уточнить структуру документа
			ТекстОшибки = "Не удалось установить количество актива для документа Сделка";
			ЗаписьЖурналаРегистрации("СозданиеСделок", УровеньЖурналаРегистрации.Предупреждение, , , ТекстОшибки);
		КонецПопытки;
	КонецПопытки;
	
	// Заполнение обязательных полей (если требуется)
	// Дата документа устанавливается автоматически при создании
	НовыйДокумент.Дата = ТекущаяДатаСеанса();
	
	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		// Если проведение не требуется, записываем без проведения
		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			ТекстОшибки = "Ошибка создания документа Сделка: " + ОписаниеОшибки();
			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область ОсновнойАлгоритм

// Описание: Основная процедура создания N сделок с соблюдением всех пропорций
//           Распределяет сделки между договорами по степенному закону,
//           соблюдает пропорции по типам активов (15:25:10) и видам операций (30:70)
//
// Параметры:
//   МассивДоговоров - Массив - массив ссылок на ДоговорДУ
//   N - Число - общее количество сделок для создания
//   МассивАкций - Массив - массив из 15 ссылок на Активы (тип: Акции)
//   МассивОблигаций - Массив - массив из 25 ссылок на Активы (тип: Облигации)
//   МассивПаев - Массив - массив из 10 ссылок на Активы (тип: Паи)
//
// Пример:
//   СоздатьСделки(МассивДоговоров, 100, МассивАкций, МассивОблигаций, МассивПаев);
//
Процедура СоздатьСделки(МассивДоговоров, N, МассивАкций, МассивОблигаций, МассивПаев)
	
	// Шаг 1: Распределяем сделки между договорами
	РаспределениеПоДоговорам = РаспределитьСделкиПоДоговорам(МассивДоговоров, N);
	
	// Шаг 2: Для каждого договора создаем структуру для хранения поступлений по типам
	ПоступленияПоДоговорам = Новый Соответствие;
	
	Для Каждого ДоговорДУ Из МассивДоговоров Цикл
		СтруктураПоступлений = Новый Структура;
		СтруктураПоступлений.Вставить("Акции", Новый Массив);
		СтруктураПоступлений.Вставить("Облигации", Новый Массив);
		СтруктураПоступлений.Вставить("Паи", Новый Массив);
		ПоступленияПоДоговорам.Вставить(ДоговорДУ, СтруктураПоступлений);
	КонецЦикла;
	
	// Шаг 3: Создаем список всех сделок для создания
	СписокСделок = Новый Массив;
	
	// Шаг 4: Обрабатываем каждый договор
	// Примечание: все договоры гарантированно имеют минимум 10 сделок
	Для Каждого ЭлементРаспределения Из РаспределениеПоДоговорам Цикл
		
		ДоговорДУ = ЭлементРаспределения.Ключ;
		КоличествоСделокПоДоговору = ЭлементРаспределения.Значение;
		
		// Распределяем по видам операций
		РаспределениеПоОперациям = РаспределитьПоВидамОпераций(КоличествоСделокПоДоговору);
		КоличествоПоступлений = РаспределениеПоОперациям.Поступление;
		КоличествоСписаний = РаспределениеПоОперациям.Списание;
		
		// Распределяем поступления по типам активов
		РаспределениеАктивов = РаспределитьПоТипамАктивов(КоличествоПоступлений);
		
		// Создаем поступления
		СоздатьПоступления(ДоговорДУ, РаспределениеАктивов,
			МассивАкций, МассивОблигаций, МассивПаев,
			ПоступленияПоДоговорам, СписокСделок);
		
		// Создаем списания из поступлений
		СоздатьСписания(ДоговорДУ, КоличествоСписаний,
			ПоступленияПоДоговорам, СписокСделок);
		
	КонецЦикла;
	
	// Шаг 5: Создаем документы
	Для Каждого ДанныеСделки Из СписокСделок Цикл
		СоздатьДокументСделка(ДанныеСделки);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти