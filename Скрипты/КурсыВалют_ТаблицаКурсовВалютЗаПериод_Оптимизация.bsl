// КОПИЯ ДЛЯ ОПТИМИЗАЦИИ. Оригинал: КурсыВалют_ТаблицаКурсовВалютЗаПериод.bsl
// Источник: базовая конфигурация 1С
// C:\1c\Cursor_1c\WORK\Wim_Du\SRC\CF\InformationRegisters\КурсыВалют\Ext\ManagerModule.bsl
//
// ВЕРСИЯ: с merge по валюте и без двойного цикла с НайтиСтроки.
// Сложность: O(Дней + Сумма по валютам(записей курсов)) вместо O(Дней * Валют) поисков.
//
// Эквивалентность оригиналу:
// - Запрос тот же: СрезПоследних(МинимальнаяДата) + записи за период, СГРУППИРОВАТЬ ПО Период, Валюта, МАКСИМУМ(Курс).
//   В ТаблицаКурсов уже одна строка на (день, валюта) с макс. курсом за день.
// - ТаблицаВалют строится так же: из ТаблицаКурсов.Свернуть("Валюта") — набор валют идентичен.
// - Merge по каждой валюте даёт тот же forward fill. Сравнение: НачалоДня(Период) <= День.
//   В базовой конфигурации у регистра КурсыВалют периодичность Day — период всегда 00:00, НачалоДня не меняет результат.
//
// Формирует таблицу курсов за каждый день в кэше вызова сервера
//
// Параметры:
//  БазоваяВалюта   - СправочникСсылка.Валюты - базовая валюта для курсов (если Неопределено - RUB)
//  ДатаНачала      - Дата - дата начала получения курсов
//  ДатаОкончания   - Дата - дата окончания получения курсов
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица курсов на каждый день по всем валютам (колонки: Период, Валюта, Курс, Кратность)
//

Функция ТаблицаКурсовВалютЗаПериод(БазоваяВалюта, ДатаНачала, ДатаОкончания) Экспорт

	Если БазоваяВалюта = Неопределено Тогда
		БазоваяВалюта = Справочники.Валюты.RUB;
	КонецЕсли;

	Запрос = Новый Запрос;

#Область ТекстЗапроса

	Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(&МинимальнаяДата, ДЕНЬ) КАК НачалоИнтервала
		|
		|УПОРЯДОЧИТЬ ПО
		|	НачалоИнтервала
		|ИТОГИ ПО
		|	НачалоИнтервала ПЕРИОДАМИ(ДЕНЬ, &МинимальнаяДата, &ДатаОкончания)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КурсыВалют.Период КАК Период,
		|	КурсыВалют.Валюта,
		|	МАКСИМУМ(КурсыВалют.Курс) КАК Курс,
		|	МАКСИМУМ(КурсыВалют.Кратность) КАК Кратность
		|ИЗ
		|	(ВЫБРАТЬ
		|		&МинимальнаяДата КАК Период,
		|		КурсыВалютСрезПоследних.Валюта КАК Валюта,
		|		КурсыВалютСрезПоследних.Курс КАК Курс,
		|		КурсыВалютСрезПоследних.Кратность КАК Кратность
		|	ИЗ
		|		РегистрСведений.КурсыВалют.СрезПоследних(&МинимальнаяДата, БазоваяВалюта = &БазоваяВалюта) КАК КурсыВалютСрезПоследних
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		КурсыВалют.Период,
		|		КурсыВалют.Валюта,
		|		КурсыВалют.Курс,
		|		КурсыВалют.Кратность
		|	ИЗ
		|		РегистрСведений.КурсыВалют КАК КурсыВалют
		|	ГДЕ
		|		КурсыВалют.Период МЕЖДУ &МинимальнаяДата И &ДатаОкончания
		|		И КурсыВалют.БазоваяВалюта = &БазоваяВалюта) КАК КурсыВалют
		|
		|СГРУППИРОВАТЬ ПО
		|	КурсыВалют.Период,
		|	КурсыВалют.Валюта
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";


#КонецОбласти

	Запрос.УстановитьПараметр("МинимальнаяДата", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", НачалоДня(ДатаОкончания));
	Запрос.УстановитьПараметр("БазоваяВалюта", БазоваяВалюта);

	Результат = Запрос.ВыполнитьПакет();

	// Отличие от базы: без вызова ОбщегоНазначенияДУ.ДобавитьВЛогОтладки (закомментирован и в базе).
	// Таблица периодов (дни) по порядку — как в базе, из Результат[0] по группировкам.
	ТаблицаПериодов = Новый ТаблицаЗначений;
	ТаблицаПериодов.Колонки.Добавить("НачалоИнтервала", Новый ОписаниеТипов("Дата"));
	ВыборкаПериодов = Результат[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "НачалоИнтервала", "ВСЕ");
	Пока ВыборкаПериодов.Следующий() Цикл
		НоваяСтрока = ТаблицаПериодов.Добавить();
		НоваяСтрока.НачалоИнтервала = ВыборкаПериодов.НачалоИнтервала;
	КонецЦикла;

	ТаблицаКурсов = Результат[1].Выгрузить();
	// Отличие от базы: сортировка по (Валюта, Период) для merge по валюте; в базе — индексы при > 300 строк.
	ТаблицаКурсов.Сортировать("Валюта, Период");

	// Как в базе: уникальные валюты из ТаблицаКурсов.Свернуть("Валюта").
	ТаблицаВалют = ТаблицаКурсов.Скопировать();
	ТаблицаВалют.Свернуть("Валюта");

	// Отличие от базы: результирующая таблица создаётся с явными колонками; в базе — ТаблицаКурсов.Скопировать(); Очистить().
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	ТаблицаРезультат.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаРезультат.Колонки.Добавить("Курс", Новый ОписаниеТипов("Число"));
	ТаблицаРезультат.Колонки.Добавить("Кратность", Новый ОписаниеТипов("Число"));

	КоличествоДней = ТаблицаПериодов.Количество();

	// Отличие от базы: порядок циклов — внешний по валютам, внутренний по дням (merge).
	// В базе: внешний по дням, внутренний по валютам; на каждую пару (день, валюта) — НайтиСтроки(Период, Валюта) и НайтиСтроки(Валюта) по ТаблицаПредыдущегоКурса.
	// Здесь: одна НайтиСтроки(Валюта) на валюту, затем линейный проход по дням с указателем по курсам (forward fill без таблицы «предыдущий курс»).
	Для каждого СтрокаВалюты Из ТаблицаВалют Цикл

		Валюта = СтрокаВалюты.Валюта;

		// Как в базе: RUB — курс 1, кратность 1 на каждый день; порядок обработки другой (сначала все дни по RUB), результат тот же.
		Если Валюта = Справочники.Валюты.RUB Тогда
			Для каждого СтрокаПериода Из ТаблицаПериодов Цикл
				НоваяСтрока = ТаблицаРезультат.Добавить();
				НоваяСтрока.Период = СтрокаПериода.НачалоИнтервала;
				НоваяСтрока.Валюта = Валюта;
				НоваяСтрока.Курс = 1;
				НоваяСтрока.Кратность = 1;
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		// Отличие от базы: один поиск по валюте на всю валюту (в базе — на каждую пару день+валюта).
		СтрокиКурсовВалюты = ТаблицаКурсов.НайтиСтроки(Новый Структура("Валюта", Валюта));
		КоличествоКурсовВалюты = СтрокиКурсовВалюты.Количество();

		// Merge: аналог forward fill из базы. В базе «предыдущий курс» хранится в ТаблицаПредыдущегоКурса (НайтиСтроки по Валюта); здесь — в переменной ТекущийКурсКратность.
		// Регистр КурсыВалют в базе имеет периодичность Day (период 00:00); НачалоДня(Период) оставлен для единообразия.
		ИндексКурса = 0;
		ТекущийКурсКратность = Неопределено;

		Для каждого СтрокаПериода Из ТаблицаПериодов Цикл

			День = СтрокаПериода.НачалоИнтервала;

			// Эквивалент базы: «есть курс на дату» = найден курс с Период для этого дня. В базе — НайтиСтроки(Период, Валюта); здесь — последняя строка с НачалоДня(Период) <= День.
			Пока ИндексКурса < КоличествоКурсовВалюты
				И НачалоДня(СтрокиКурсовВалюты[ИндексКурса].Период) <= День Цикл
				ТекущийКурсКратность = Новый Структура("Курс, Кратность",
					СтрокиКурсовВалюты[ИндексКурса].Курс,
					СтрокиКурсовВалюты[ИндексКурса].Кратность);
				ИндексКурса = ИндексКурса + 1;
			КонецЦикла;

			// Как в базе: строка на каждый (день, валюта); если курса нет — пустые Курс/Кратность (в базе — из СтрокиПредыдущегоКурса или пусто).
			НоваяСтрока = ТаблицаРезультат.Добавить();
			НоваяСтрока.Период = День;
			НоваяСтрока.Валюта = Валюта;
			Если ТекущийКурсКратность <> Неопределено Тогда
				НоваяСтрока.Курс = ТекущийКурсКратность.Курс;
				НоваяСтрока.Кратность = ТекущийКурсКратность.Кратность;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	// Отличие от базы: результат собирается в порядке (валюта, день), поэтому нужна финальная сортировка; в базе порядок (день, валюта) получается из двойного цикла.
	ТаблицаРезультат.Сортировать("Период, Валюта");

	Возврат ТаблицаРезультат;

КонецФункции
