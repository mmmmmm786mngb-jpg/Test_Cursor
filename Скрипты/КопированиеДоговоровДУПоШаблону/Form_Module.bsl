////////////////////////////////////////////////////////////////////////////////
// Модуль формы внешней обработки "Копирование договоров ДУ по шаблону"
//
// Реквизиты формы (Объект):
//   ДоговорДУ_Шаблон          - СправочникСсылка.ДоговорДУ
//   УчетнаяПолитика_Шаблон    - ДокументСсылка.УчетнаяПолитика (подставляется при изменении договора)
//   КоличествоКопий           - Число
//   ДатаУстановкиДоговоров   - Дата — дата создания документов и период для периодических регистров
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

// При изменении договора-шаблона ищем документ Учетная политика по этому договору
// и подставляем в реквизит формы УчетнаяПолитика_Шаблон.
//
// Параметры:
//   Элемент - ЭлементФормы - поле ввода ДоговорДУ_Шаблон
//
Процедура ДоговорДУ_ШаблонПриИзменении(Элемент)
	ПодставитьУчетнуюПолитикуПоДоговору();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Выполняет копирование договоров ДУ и документов Учетная политика по шаблону.
// Количество копий задается реквизитом КоличествоКопий.
// Код договора устанавливается автоматически, в Наименование добавляется номер копии.
//
// Параметры:
//   Команда - КомандаФормы - команда кнопки КопироватьПоШаблону
//
Процедура КопироватьПоШаблону(Команда)
	ВыполнитьКопированиеНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подставляет в УчетнаяПолитика_Шаблон документ Учетная политика,
// найденный по текущему значению ДоговорДУ_Шаблон (последний по дате проведенный).
//
&НаСервере
Процедура ПодставитьУчетнуюПолитикуПоДоговору()
	// Очищаем реквизит формы, затем заполняем по результату запроса
	УчетнаяПолитика_Шаблон = Неопределено; // Реквизит формы
	Если Не ЗначениеЗаполнено(ДоговорДУ_Шаблон) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УчетнаяПолитика.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УчетнаяПолитика КАК УчетнаяПолитика
		|ГДЕ
		|	УчетнаяПолитика.ДоговорДУ = &ДоговорДУ
		|	И УчетнаяПолитика.Проведен = ИСТИНА
		|	И УчетнаяПолитика.Дата <= &ТекущаяДата
		|УПОРЯДОЧИТЬ ПО
		|	УчетнаяПолитика.Дата УБЫВ";
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ_Шаблон);
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		УчетнаяПолитика_Шаблон = Выборка.Ссылка;
	КонецЕсли;
КонецПроцедуры

// Создает копии договора ДУ и документов Учетная политика по шаблону.
// Код договора - авто, Наименование = шаблон + " " + номер копии.
//
&НаСервере
Процедура ВыполнитьКопированиеНаСервере()
	Если Не ЗначениеЗаполнено(ДоговорДУ_Шаблон) Тогда
		ОбщегоНазначения.СообщитьПользователю("Укажите договор ДУ - шаблон.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(УчетнаяПолитика_Шаблон) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найден документ Учетная политика по выбранному договору. Укажите шаблон или выберите договор с проведенной учетной политикой.");
		Возврат;
	КонецЕсли;
	ДатаУстановки = ?(ЗначениеЗаполнено(ДатаУстановкиДоговоров), НачалоДня(ДатаУстановкиДоговоров), НачалоДня(ТекущаяДатаСеанса()));
	КолКопий = ?(КоличествоКопий > 0, КоличествоКопий, 1);
	ШаблонДоговор = ДоговорДУ_Шаблон.ПолучитьОбъект();
	Если ШаблонДоговор = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось прочитать объект договора-шаблона.");
		Возврат;
	КонецЕсли;
	ШаблонУчетнаяПолитика = УчетнаяПолитика_Шаблон.ПолучитьОбъект();
	Если ШаблонУчетнаяПолитика = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось прочитать объект документа Учетная политика - шаблон.");
		Возврат;
	КонецЕсли;
	СозданоДоговоров = 0;
	СозданоДокументов = 0;
	Для НомерКопии = 1 По КолКопий Цикл
		Попытка
			НовыйДоговор = СоздатьДоговорДУПоШаблону(ШаблонДоговор, НомерКопии);
			Если ЗначениеЗаполнено(НовыйДоговор) Тогда
				СозданоДоговоров = СозданоДоговоров + 1;
				НовыйДокумент = СоздатьУчетнуюПолитикуПоШаблону(ШаблонУчетнаяПолитика, НовыйДоговор, ДатаУстановки);
				Если НовыйДокумент <> Неопределено Тогда
					СозданоДокументов = СозданоДокументов + 1;
				КонецЕсли;
			КонецЕсли;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ОбщегоНазначения.СообщитьПользователю("Ошибка при создании копии " + НомерКопии + ": " + ТекстОшибки);
		КонецПопытки;
	КонецЦикла;
	ОбщегоНазначения.СообщитьПользователю("Создано договоров: " + СозданоДоговоров + ", документов Учетная политика: " + СозданоДокументов + ".");
КонецПроцедуры

// Создает новый элемент справочника ДоговорДУ по шаблону.
// Наименование = шаблон.Наименование + " " + НомерКопии.
// Код не задается - устанавливается автоматически при записи.
//
// Параметры:
//   ШаблонДоговор - СправочникОбъект.ДоговорДУ - объект договора-шаблона
//   НомерКопии    - Число - номер копии для суффикса в наименовании
//
// Возвращаемое значение:
//   СправочникСсылка.ДоговорДУ - ссылка на созданный договор или пустая ссылка при ошибке
//
&НаСервере
Функция СоздатьДоговорДУПоШаблону(ШаблонДоговор, НомерКопии)
	Менеджер = Справочники.ДоговорДУ;
	НовыйДоговор = Менеджер.СоздатьЭлемент();
	// ЗаполнитьЗначенияСвойств(Приемник, Источник, СписокСвойств, ИсключаяСвойства)
	// СписокСвойств = "" — копируем все; ИсключаяСвойства — не копировать эти свойства
	ЗаполнитьЗначенияСвойств(НовыйДоговор, ШаблонДоговор, , "Ссылка, Код, ПометкаУдаления, Родитель");
	НовыйДоговор.Наименование = "_" + НомерКопии + "_ " + СокрЛП(ШаблонДоговор.Наименование);
	НовыйДоговор.Записать();
	Возврат НовыйДоговор.Ссылка;
КонецФункции

// Создает и проводит документ Учетная политика по шаблону для указанного договора ДУ.
// Дата документа и период движений по периодическим регистрам задаются ДатаУстановки.
//
// Параметры:
//   ШаблонУчетнаяПолитика - ДокументОбъект.УчетнаяПолитика - объект документа-шаблона
//   НовыйДоговор          - СправочникСсылка.ДоговорДУ - договор для новой учетной политики
//   ДатаУстановки        - Дата - дата документа и период для движений по регистрам
//
// Возвращаемое значение:
//   ДокументСсылка.УчетнаяПолитика, Неопределено - ссылка на созданный документ или Неопределено при ошибке
//
&НаСервере
Функция СоздатьУчетнуюПолитикуПоШаблону(ШаблонУчетнаяПолитика, НовыйДоговор, ДатаУстановки)
	НовыйДокумент = Документы.УчетнаяПолитика.СоздатьДокумент();
	// ЗаполнитьЗначенияСвойств(Приемник, Источник, СписокСвойств, ИсключаяСвойства)
	ЗаполнитьЗначенияСвойств(НовыйДокумент, ШаблонУчетнаяПолитика, , "Номер, Дата, Ссылка");
	НовыйДокумент.ДоговорДУ = НовыйДоговор;
	НовыйДокумент.Дата = ДатаУстановки;
	Для Каждого ТабЧасть Из Метаданные.Документы.УчетнаяПолитика.ТабличныеЧасти Цикл
		НовыйДокумент[ТабЧасть.Имя].Загрузить(ШаблонУчетнаяПолитика[ТабЧасть.Имя].Выгрузить());
	КонецЦикла;
	// Дата установлена выше; номер — автоматически при записи
	НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ОбщегоНазначения.СообщитьПользователю("Документ Учетная политика создан, но не проведен: " + ТекстОшибки);
	КонецПопытки;
	Возврат НовыйДокумент.Ссылка;
КонецФункции

#КонецОбласти
