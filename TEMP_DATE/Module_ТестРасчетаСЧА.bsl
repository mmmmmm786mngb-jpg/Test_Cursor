// Описание: Модуль формы тестирования сверки типового и нового алгоритма расчёта СЧА/РСА.
//
// Назначение:
//  Для каждого ДоговорДУ из документов НачислениеВознаграждения за указанный день
//  вызывается функция СреднееСЧА_РСА двумя способами:
//    1) Типовой  -- через РегистрыСведений.РегистрРСА_СЧА.ТЗ_СЧА_РСА_НаДаты
//    2) Новый    -- через локальную копию алгоритма из расширения rvu
//  Результаты (структуры) сравниваются построчно. Расхождений быть не должно.
//
// Реквизиты формы:
//   ДатаТеста              - Дата   - дата для поиска документов НачислениеВознаграждения
//   ДатаНачалаПериода      - Дата   - начало периода расчёта (по умолчанию: начало квартала)
//   ДатаОкончанияПериода   - Дата   - окончание периода расчёта (по умолчанию: дата теста)
//   ТипДня                 - Строка - "КалендарныйТип" или "РабочийТип"
//   РезультатыТеста        - Строка - многострочный текст с результатами тестирования (неограниченная длина)
//
// Команды формы:
//   ТестРасчетаСЧА - кнопка запуска теста
//

// ============================================================================
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ
// ============================================================================

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    ТипДня = "КалендарныйТип";
    
КонецПроцедуры

&НаКлиенте
Процедура ДатаТестаПриИзменении(Элемент)
    
    Если ЗначениеЗаполнено(ДатаТеста) Тогда
        ДатаНачалаПериода    = НачалоКвартала(ДатаТеста);
        ДатаОкончанияПериода = ДатаТеста;
    КонецЕсли;
    
КонецПроцедуры

// ============================================================================
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ
// ============================================================================

&НаКлиенте
Процедура ТестРасчетаСЧА(Команда)
    
    Если Не ЗначениеЗаполнено(ДатаТеста) Тогда
        ПоказатьПредупреждение(, "Укажите дату теста!");
        Возврат;
    КонецЕсли;
    
    РезультатыТеста = "Выполняется тест...";
    ВыполнитьТестРасчетаСЧАНаСервере();
    
КонецПроцедуры

// ============================================================================
// ОСНОВНАЯ ЛОГИКА ТЕСТА (СЕРВЕР)
// ============================================================================

// Описание: Основная процедура теста. Ищет все ДоговорДУ из проведённых документов
// НачислениеВознаграждения за указанную дату, для каждого вызывает расчёт типовым
// и новым алгоритмом, сравнивает результаты.
//
&НаСервере
Процедура ВыполнитьТестРасчетаСЧАНаСервере()
    
    // Установка значений по умолчанию
    Если Не ЗначениеЗаполнено(ДатаНачалаПериода) Тогда
        ДатаНачалаПериода = НачалоКвартала(ДатаТеста);
    КонецЕсли;
    
    Если Не ЗначениеЗаполнено(ДатаОкончанияПериода) Тогда
        ДатаОкончанияПериода = ДатаТеста;
    КонецЕсли;
    
    Если Не ЗначениеЗаполнено(ТипДня) Тогда
        ТипДня = "КалендарныйТип";
    КонецЕсли;
    
    // Поиск всех уникальных ДоговорДУ из проведённых документов НачислениеВознаграждения за дату
    ЗапросДоговоров = Новый Запрос;
    ЗапросДоговоров.Текст =
    "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |    НВ.ДоговорДУ КАК ДоговорДУ
    |ИЗ
    |    Документ.НачислениеВознаграждения КАК НВ
    |ГДЕ
    |    НВ.Дата МЕЖДУ &НачалоДня И &КонецДня
    |    И НВ.Проведен";
    ЗапросДоговоров.УстановитьПараметр("НачалоДня", НачалоДня(ДатаТеста));
    ЗапросДоговоров.УстановитьПараметр("КонецДня",  КонецДня(ДатаТеста));
    
    РезультатЗапроса = ЗапросДоговоров.Выполнить();
    ВыборкаДоговоров = РезультатЗапроса.Выбрать();
    
    КоличествоДоговоров = 0;
    КоличествоОшибок    = 0;
    ТекстЛог            = "";
    
    Пока ВыборкаДоговоров.Следующий() Цикл
        
        ТекущийДоговорДУ = ВыборкаДоговоров.ДоговорДУ;
        КоличествоДоговоров = КоличествоДоговоров + 1;
        
        Попытка
            
            // Вызов 1: типовой алгоритм (РегистрыСведений.РегистрРСА_СЧА.ТЗ_СЧА_РСА_НаДаты)
            РезультатТиповой = СреднееСЧА_РСА(
                ТекущийДоговорДУ, ДатаНачалаПериода, ДатаОкончанияПериода, ТипДня, Ложь);
            
            // Вызов 2: новый алгоритм (локальная копия из расширения rvu)
            РезультатНовый = СреднееСЧА_РСА(
                ТекущийДоговорДУ, ДатаНачалаПериода, ДатаОкончанияПериода, ТипДня, Истина);
            
            // Сравнение результатов
            ТекстСравнения = СравнитьРезультатыСЧА_РСА(
                ТекущийДоговорДУ, РезультатТиповой, РезультатНовый);
            
            Если ТекстСравнения = "" Тогда
                ТекстЛог = ТекстЛог
                    + "[OK] " + Строка(ТекущийДоговорДУ)
                    + " | СЧА=" + Формат(РезультатТиповой.СЧА, "ЧДЦ=2")
                    + " | РСА=" + Формат(РезультатТиповой.РСА, "ЧДЦ=2")
                    + " | Дней=" + Строка(РезультатТиповой.КоличествоДней)
                    + Символы.ПС;
            Иначе
                КоличествоОшибок = КоличествоОшибок + 1;
                ТекстЛог = ТекстЛог
                    + "[РАСХОЖДЕНИЕ] " + Строка(ТекущийДоговорДУ) + Символы.ПС
                    + ТекстСравнения + Символы.ПС;
            КонецЕсли;
            
        Исключение
            КоличествоОшибок = КоличествоОшибок + 1;
            ТекстЛог = ТекстЛог
                + "[ОШИБКА] " + Строка(ТекущийДоговорДУ)
                + ": " + ОписаниеОшибки() + Символы.ПС;
        КонецПопытки;
        
    КонецЦикла;
    
    // Формирование итогового отчёта
    РезультатыТеста =
        "=== РЕЗУЛЬТАТЫ ТЕСТА СВЕРКИ СЧА/РСА ===" + Символы.ПС
        + "Дата документов:    " + Формат(ДатаТеста, "ДФ=dd.MM.yyyy") + Символы.ПС
        + "Период расчёта:     " + Формат(ДатаНачалаПериода, "ДФ=dd.MM.yyyy")
            + " - " + Формат(ДатаОкончанияПериода, "ДФ=dd.MM.yyyy") + Символы.ПС
        + "Тип дня:            " + ТипДня + Символы.ПС
        + "---------------------------------------------" + Символы.ПС
        + "Договоров проверено: " + Строка(КоличествоДоговоров) + Символы.ПС
        + "Расхождений:         " + Строка(КоличествоОшибок) + Символы.ПС
        + "---------------------------------------------" + Символы.ПС
        + Символы.ПС
        + ТекстЛог;
    
КонецПроцедуры

// ============================================================================
// РАСЧЁТ СЧА/РСА
// Копия функции СреднееСЧА_РСА из внMFРасчетВознаграждения_0/Ext/ObjectModule.bsl
// Параметр ИспользоватьНовыйАлгоритм переключает способ получения таблицы:
//   Ложь  -- РегистрыСведений.РегистрРСА_СЧА.ТЗ_СЧА_РСА_НаДаты (типовой)
//   Истина -- Локальная_ТЗ_СЧА_РСА_НаДаты (новый, из расширения rvu)
// ============================================================================

// Описание: Вычисляет среднее СЧА и РСА за период по данным календаря.
//
// Параметры:
//  ДоговорДУ                 - СправочникСсылка.ДоговорДУ - договор доверительного управления
//  ДатаНачала                - Дата   - начало периода
//  ДатаОкончания             - Дата   - окончание периода
//  ТипДня                    - Строка - "КалендарныйТип" или "РабочийТип"
//  ИспользоватьНовыйАлгоритм - Булево - Истина = локальная копия (rvu), Ложь = типовой
//  ДатаОбнуления             - Дата   - дата обнуления СЧА/РСА (необязательный)
//
// Возвращаемое значение:
//  Структура - ключи: СЧА (Число), РСА (Число), ТаблицаСЧА_РСА (ТаблицаЗначений), КоличествоДней (Число)
//
&НаСервере
Функция СреднееСЧА_РСА(ДоговорДУ, ДатаНачала, ДатаОкончания, ТипДня, ИспользоватьНовыйАлгоритм, ДатаОбнуления = Неопределено)
    
    СтруктураВозврата = Новый Структура;
    СтруктураВозврата.Вставить("СЧА", 0);
    СтруктураВозврата.Вставить("РСА", 0);
    СтруктураВозврата.Вставить("ТаблицаСЧА_РСА", Новый ТаблицаЗначений);
    СтруктураВозврата.Вставить("КоличествоДней", 0);
    
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("ДоговорДУ",     ДоговорДУ);
    Запрос.УстановитьПараметр("ДатаНачала",    ДатаНачала);
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
    
    ТекстЗапроса =
    "ВЫБРАТЬ
    |    КалендарныеГрафики.ДатаГрафика КАК Дата
    |ИЗ
    |    РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
    |ГДЕ
    |    КалендарныеГрафики.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.РегламентированныйКалендарь)
    |    И КалендарныеГрафики.ДатаГрафика МЕЖДУ &ДатаНачала И &ДатаОкончания
    |    И КалендарныеГрафики.ДеньВключенВГрафик";
    
    Если ТипДня = "КалендарныйТип" Тогда
        ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
            "КалендарныеГрафики.ДеньВключенВГрафик", "ИСТИНА");
    КонецЕсли;
    
    Запрос.Текст = ТекстЗапроса;
    ТаблицаДат = Запрос.Выполнить().Выгрузить();
    
    Если ИспользоватьНовыйАлгоритм Тогда
        // Новый алгоритм: локальная копия из расширения rvu
        ТаблицаСЧА_РСА = Локальная_ТЗ_СЧА_РСА_НаДаты(ТаблицаДат, ДоговорДУ);
    Иначе
        // Типовой алгоритм: менеджер регистра сведений
        ТаблицаСЧА_РСА = РегистрыСведений.РегистрРСА_СЧА.ТЗ_СЧА_РСА_НаДаты(ТаблицаДат, ДоговорДУ);
    КонецЕсли;
    
    // Обнуление до указанной даты (MPazhukov IMDEV-3861)
    Если ДатаОбнуления <> Неопределено Тогда
        Для Каждого СтрСЧА Из ТаблицаСЧА_РСА Цикл
            Если СтрСЧА.Дата < ДатаОбнуления Тогда
                СтрСЧА.СЧА = 0;
                СтрСЧА.РСА = 0;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    
    КоличествоДней = ТаблицаСЧА_РСА.Количество();
    Если Не КоличествоДней = 0 Тогда
        СтруктураВозврата.СЧА             = ТаблицаСЧА_РСА.Итог("СЧА") / КоличествоДней;
        СтруктураВозврата.РСА             = ТаблицаСЧА_РСА.Итог("РСА") / КоличествоДней;
        СтруктураВозврата.ТаблицаСЧА_РСА  = ТаблицаСЧА_РСА;
        СтруктураВозврата.КоличествоДней  = КоличествоДней;
    КонецЕсли;
    
    Возврат СтруктураВозврата;
    
КонецФункции

// ============================================================================
// ЛОКАЛЬНАЯ КОПИЯ НОВОГО АЛГОРИТМА
// Источник: rvu/InformationRegisters/РегистрРСА_СЧА/Ext/ManagerModule.bsl
// Функция rvu_ТЗ_СЧА_РСА_НаДаты (заменяет типовой ТЗ_СЧА_РСА_НаДаты)
// ============================================================================

// Описание: Возвращает таблицу значений РСА и СЧА на каждую дату из переданной таблицы дат
// по данным регистра сведений РегистрРСА_СЧА для указанного договора ДУ.
// Для каждой даты берётся ближайший снизу период (Период <= Дата).
//
// Алгоритм: обе таблицы отсортированы по убыванию дат, два указателя идут сверху вниз.
// Один простой запрос к регистру, без временных таблиц, без JOIN.
// Сложность: O(N + M) -- один проход по обеим таблицам.
//
// Параметры:
//  ТаблицаДат - ТаблицаЗначений - таблица с колонкой "Дата" (~90 дат за квартал)
//  ДоговорДУ  - СправочникСсылка.ДоговорДУ - договор доверительного управления
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: Дата, РСА, СЧА (упорядочена по Дата)
//
&НаСервере
Функция Локальная_ТЗ_СЧА_РСА_НаДаты(ТаблицаДат, ДоговорДУ)
    
    КоличествоДат = ТаблицаДат.Количество();
    
    Если КоличествоДат = 0 Тогда
        Возврат ЛокальнаяНоваяТаблицаРезультата();
    КонецЕсли;
    
    // Сортируем даты по убыванию; максимальная дата -- в нулевой строке
    ТаблицаДат.Сортировать("Дата Убыв");
    МаксДата = ТаблицаДат[0].Дата;
    
    // Один запрос: выгружаем записи регистра по убыванию периода
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
    Запрос.УстановитьПараметр("МаксДата",  МаксДата);
    Запрос.Текст =
    "ВЫБРАТЬ
    |    РегистрРСА_СЧА.Период КАК Период,
    |    РегистрРСА_СЧА.РСА КАК РСА,
    |    РегистрРСА_СЧА.СЧА КАК СЧА
    |ИЗ
    |    РегистрСведений.РегистрРСА_СЧА КАК РегистрРСА_СЧА
    |ГДЕ
    |    РегистрРСА_СЧА.ДоговорДУ = &ДоговорДУ
    |    И РегистрРСА_СЧА.Период <= &МаксДата
    |
    |УПОРЯДОЧИТЬ ПО
    |    Период УБЫВ";
    
    ТаблицаРегистра = Запрос.Выполнить().Выгрузить();
    
    // Слияние двух таблиц, обе отсортированы по убыванию.
    //
    // Пример: Даты (убыв): 30, 28, 25.  Регистр (убыв): 29, 26, 20.
    //
    //  Шаг | ИндДаты | Дата | ИндРег | Пропуск      | Период | Результат
    //  ----+---------+------+--------+--------------+--------+------------------
    //   1  |    0    |  30  |   0    | -            |   29   | Дата=30, Период=29
    //   2  |    1    |  28  |   0    | 29>28 -> +1  |   26   | Дата=28, Период=26
    //   3  |    2    |  25  |   1    | 26>25 -> +1  |   20   | Дата=25, Период=20
    //
    // Указатель регистра не откатывается: каждая запись проверяется максимум один раз.
    Результат = ЛокальнаяНоваяТаблицаРезультата();
    КоличествоЗаписей = ТаблицаРегистра.Количество();
    ИндексРегистра = 0;
    
    Для ИндексДаты = 0 По КоличествоДат - 1 Цикл
        
        ТекущаяДата = ТаблицаДат[ИндексДаты].Дата;
        
        // Пропускаем записи регистра, у которых Период > текущей даты
        Пока ИндексРегистра < КоличествоЗаписей
            И ТаблицаРегистра[ИндексРегистра].Период > ТекущаяДата Цикл
            ИндексРегистра = ИндексРегистра + 1;
        КонецЦикла;
        
        // Текущая запись регистра -- первая с Период <= ТекущаяДата (ближайшая снизу)
        НоваяСтрока = Результат.Добавить();
        НоваяСтрока.Дата = ТекущаяДата;
        
        Если ИндексРегистра < КоличествоЗаписей Тогда
            НоваяСтрока.РСА = ТаблицаРегистра[ИндексРегистра].РСА;
            НоваяСтрока.СЧА = ТаблицаРегистра[ИндексРегистра].СЧА;
        КонецЕсли;
        
    КонецЦикла;
    
    Результат.Сортировать("Дата Возр");
    Возврат Результат;
    
КонецФункции

// Описание: Создаёт пустую таблицу результата с типизированными колонками.
//
// Возвращаемое значение:
//  ТаблицаЗначений - пустая таблица с колонками Дата, РСА, СЧА
//
&НаСервере
Функция ЛокальнаяНоваяТаблицаРезультата()
    
    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
    Результат.Колонки.Добавить("РСА",  Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 2)));
    Результат.Колонки.Добавить("СЧА",  Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 2)));
    Возврат Результат;
    
КонецФункции

// ============================================================================
// СРАВНЕНИЕ РЕЗУЛЬТАТОВ
// ============================================================================

// Описание: Сравнивает два результата расчёта СЧА/РСА (структуры из СреднееСЧА_РСА).
// При отсутствии расхождений возвращает пустую строку.
// При наличии расхождений возвращает текст с описанием различий.
//
// Параметры:
//  ДоговорДУ      - СправочникСсылка.ДоговорДУ - договор (для вывода в лог)
//  Результат1     - Структура - результат типового алгоритма
//  Результат2     - Структура - результат нового алгоритма
//
// Возвращаемое значение:
//  Строка - пустая если расхождений нет, иначе описание расхождений
//
&НаСервере
Функция СравнитьРезультатыСЧА_РСА(ДоговорДУ, Результат1, Результат2)
    
    ТекстОшибок = "";
    
    // Сравнение агрегатов
    Если Результат1.СЧА <> Результат2.СЧА Тогда
        ТекстОшибок = ТекстОшибок
            + "  СЧА: типовой=" + Формат(Результат1.СЧА, "ЧДЦ=6")
            + " | новый=" + Формат(Результат2.СЧА, "ЧДЦ=6")
            + " | разница=" + Формат(Результат1.СЧА - Результат2.СЧА, "ЧДЦ=6")
            + Символы.ПС;
    КонецЕсли;
    
    Если Результат1.РСА <> Результат2.РСА Тогда
        ТекстОшибок = ТекстОшибок
            + "  РСА: типовой=" + Формат(Результат1.РСА, "ЧДЦ=6")
            + " | новый=" + Формат(Результат2.РСА, "ЧДЦ=6")
            + " | разница=" + Формат(Результат1.РСА - Результат2.РСА, "ЧДЦ=6")
            + Символы.ПС;
    КонецЕсли;
    
    Если Результат1.КоличествоДней <> Результат2.КоличествоДней Тогда
        ТекстОшибок = ТекстОшибок
            + "  КоличествоДней: типовой=" + Строка(Результат1.КоличествоДней)
            + " | новый=" + Строка(Результат2.КоличествоДней)
            + Символы.ПС;
    КонецЕсли;
    
    // Построчное сравнение таблиц СЧА_РСА
    ТекстСравненияТаблиц = СравнитьТаблицыСЧА_РСА(
        Результат1.ТаблицаСЧА_РСА, Результат2.ТаблицаСЧА_РСА);
    
    Если ТекстСравненияТаблиц <> "" Тогда
        ТекстОшибок = ТекстОшибок + ТекстСравненияТаблиц;
    КонецЕсли;
    
    Возврат ТекстОшибок;
    
КонецФункции

// Описание: Построчно сравнивает две таблицы значений СЧА/РСА.
// Обе таблицы должны содержать колонки: Дата, СЧА, РСА.
//
// Параметры:
//  Таблица1 - ТаблицаЗначений - таблица от типового алгоритма
//  Таблица2 - ТаблицаЗначений - таблица от нового алгоритма
//
// Возвращаемое значение:
//  Строка - пустая если расхождений нет, иначе описание различий
//
&НаСервере
Функция СравнитьТаблицыСЧА_РСА(Таблица1, Таблица2)
    
    ТекстОшибок = "";
    
    Количество1 = Таблица1.Количество();
    Количество2 = Таблица2.Количество();
    
    Если Количество1 <> Количество2 Тогда
        ТекстОшибок = ТекстОшибок
            + "  Таблица: разное количество строк: типовой=" + Строка(Количество1)
            + " | новый=" + Строка(Количество2) + Символы.ПС;
    КонецЕсли;
    
    // Сравниваем до минимального количества строк
    МинКоличество = Мин(Количество1, Количество2);
    КоличествоРасхождений = 0;
    МаксВыводРасхождений  = 10; // Ограничение вывода для читаемости
    
    Для Индекс = 0 По МинКоличество - 1 Цикл
        
        Строка1 = Таблица1[Индекс];
        Строка2 = Таблица2[Индекс];
        
        ЕстьРасхождение = Ложь;
        ТекстСтроки = "";
        
        Если Строка1.Дата <> Строка2.Дата Тогда
            ЕстьРасхождение = Истина;
            ТекстСтроки = ТекстСтроки
                + "Дата: " + Формат(Строка1.Дата, "ДФ=dd.MM.yyyy")
                + " <> " + Формат(Строка2.Дата, "ДФ=dd.MM.yyyy") + "; ";
        КонецЕсли;
        
        Если Строка1.СЧА <> Строка2.СЧА Тогда
            ЕстьРасхождение = Истина;
            ТекстСтроки = ТекстСтроки
                + "СЧА: " + Формат(Строка1.СЧА, "ЧДЦ=2")
                + " <> " + Формат(Строка2.СЧА, "ЧДЦ=2") + "; ";
        КонецЕсли;
        
        Если Строка1.РСА <> Строка2.РСА Тогда
            ЕстьРасхождение = Истина;
            ТекстСтроки = ТекстСтроки
                + "РСА: " + Формат(Строка1.РСА, "ЧДЦ=2")
                + " <> " + Формат(Строка2.РСА, "ЧДЦ=2") + "; ";
        КонецЕсли;
        
        Если ЕстьРасхождение Тогда
            КоличествоРасхождений = КоличествоРасхождений + 1;
            Если КоличествоРасхождений <= МаксВыводРасхождений Тогда
                ТекстОшибок = ТекстОшибок
                    + "  Строка " + Строка(Индекс + 1) + ": " + ТекстСтроки + Символы.ПС;
            КонецЕсли;
        КонецЕсли;
        
    КонецЦикла;
    
    Если КоличествоРасхождений > МаксВыводРасхождений Тогда
        ТекстОшибок = ТекстОшибок
            + "  ... и ещё " + Строка(КоличествоРасхождений - МаксВыводРасхождений)
            + " расхождений в строках таблицы" + Символы.ПС;
    КонецЕсли;
    
    Возврат ТекстОшибок;
    
КонецФункции
