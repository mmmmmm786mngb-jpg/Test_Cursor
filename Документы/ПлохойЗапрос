Функция СимволыОФР(КодыОФР)
	СимволыОФР = Новый СписокЗначений;
	МассивСимволов = Справочники.СимволыОФР.СимволыОФРПоСтроке(КодыОФР);
	СимволыОФР.ЗагрузитьЗначения(МассивСимволов);
	Возврат СимволыОФР;		
КонецФункции


&НаСервере
Процедура СформироватьОтчетНаСервере()
	
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("НаДату", КонецДня(НаДату));
	Запрос.УстановитьПараметр("Портфель", 	Портфель);

	списЦБ = УчетЕПСПовтИсп.СчетаУчетаДолговыхЦБ();
	
	масАкц = УчетЕПСПовтИсп.СчетаУчетаДолевыхЦБ();
	Для каждого СчетУчета Из масАкц Цикл
		списЦБ.Добавить(СчетУчета);
	КонецЦикла;
	
	списКп = УчетЕПСПовтИсп.СчетаПоложительнойКорректировкиЦенныхБумаг();
	списКм = УчетЕПСПовтИсп.СчетаОтрицательнойКорректировкиЦенныхБумаг();
	списПп = УчетЕПСПовтИсп.СчетаПоложительнойПереоценкиЦенныхБумаг();
	списПм = УчетЕПСПовтИсп.СчетаОтрицательнойПереоценкиЦенныхБумаг();
	
	// VTB-Borisov  - 05.09.2017 { 
	списПп_ЕПС = УчетЕПСПовтИсп.СчетаПоложительнойПереоценкиЦенныхБумагПриПереходеНаЕПС();
	списПм_ЕПС = УчетЕПСПовтИсп.СчетаОтрицательнойПереоценкиЦенныхБумагПриПереходеНаЕПС();
	
	Для каждого СчетУчета Из списПп_ЕПС Цикл
		списПп.Добавить(СчетУчета);
	КонецЦикла;

	Для каждого СчетУчета Из списПм_ЕПС Цикл
		списПм.Добавить(СчетУчета);
	КонецЦикла;
	// VTB-Borisov  - 05.09.2017 }
	
	// VTB-Borisov  - 20.04.2018 { 
	ЧастиЦБ  = новый Массив;
	ЧастиЦБ.Добавить(Перечисления.ЧастиЦенныхБумаг.Премия);
	ЧастиЦБ.Добавить(Перечисления.ЧастиЦенныхБумаг.АмортизацияДисконта);
	// VTB-Borisov  - 20.04.2018 }
	
	// VTB-Borisov  - 16.11.2018 { 
	КодыОФР = "33201,33202,33203,33204";
	СписокЭлементовОФР = СимволыОФР(КодыОФР);
	// VTB-Borisov  - 16.11.2018 }
	
	ЭтаОбработка = РеквизитФормыВЗначение("Отчет");
	Макет = ЭтаОбработка.ПолучитьМакет("Макет");
	
	Запрос.УстановитьПараметр("списЦБ", 	списЦБ);
	Запрос.УстановитьПараметр("списКп", 	списКп);
	Запрос.УстановитьПараметр("списКм", 	списКм);
	Запрос.УстановитьПараметр("списПп", 	списПп);
	Запрос.УстановитьПараметр("списПм", 	списПм);
	Запрос.УстановитьПараметр("с47423",   	ПланыСчетов.ЕПС.Расчеты_47423);
	Запрос.УстановитьПараметр("с47423_01", 	ПланыСчетов.ЕПС.Расчеты_47423_01);
	Запрос.УстановитьПараметр("с47423_02", 	ПланыСчетов.ЕПС.Расчеты_47423_02);
	Запрос.УстановитьПараметр("с47423_03", 	ПланыСчетов.ЕПС.Расчеты_47423_03);
	Запрос.УстановитьПараметр("с71001",   	ПланыСчетов.ЕПС.ФинансовыеРезультаты_71001);
	Запрос.УстановитьПараметр("с71004",   	ПланыСчетов.ЕПС.ФинансовыеРезультаты_71004);
	Запрос.УстановитьПараметр("с00002",   	ПланыСчетов.ЕПС.ВспомогательныйПассивный);
	Запрос.УстановитьПараметр("с61210",   	ПланыСчетов.ЕПС.Имущество_61210);
	Запрос.УстановитьПараметр("с47903",   	ПланыСчетов.ЕПС.Расчеты_47903);
