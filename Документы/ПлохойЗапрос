	|		КОНЕЦ) КАК СуммаУКД,
	|	СУММА(т.КоличествоОстаток) КАК КоличествоОстаток,
	|	т.Субконто3 КАК Партия
	|ПОМЕСТИТЬ втОблигации
	|ИЗ
	|	РегистрБухгалтерии.ЕПС.Остатки(&НаДату, Счет В ИЕРАРХИИ (&списЦБ), , Портфель = &Портфель) КАК т
	|
	|СГРУППИРОВАТЬ ПО
	|	т.Счет.Наименование,
	|	т.Субконто1,
	|	т.Субконто3
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втОблигации.ЦБ КАК ЦБ,
	|	МИНИМУМ(НАЧАЛОПЕРИОДА(ОфертыОблигаций.Период, ДЕНЬ)) КАК МинПериод
	|ПОМЕСТИТЬ втСрезПервых
	|ИЗ
	|	втОблигации КАК втОблигации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыОфертОблигаций КАК ОфертыОблигаций
	|		ПО втОблигации.ЦБ = ОфертыОблигаций.Актив
	|ГДЕ
	|	ОфертыОблигаций.Период >= &НаДату
	|	И ОфертыОблигаций.Период <> ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	втОблигации.ЦБ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втОблигации.СчетНаименование КАК СчетНаименование,
	|	втОблигации.ЦБ КАК ЦБ,
	|	втОблигации.ЦБ.Объект.Эмитент КАК Эмитент,
	|	втОблигации.ЦБ.Объект.ISIN КАК ISIN,
	|	втОблигации.ЦБ.Объект.НомерГосРегистрацииВыпуска КАК НомерГосРег,
	|	втОблигации.НомСтоимость КАК СуммаНоминал,
	|	втОблигации.СуммаЦеннаяБумага КАК СуммаЦеннаяБумага,
	|	втОблигации.Премия КАК СуммаПремия,
	|	втОблигации.СуммаКД КАК НКД,
	|	втОблигации.СуммаУКД КАК УКД,
	|	ЕСТЬNULL(тКоррПлюс.СуммаОстаток, 0) КАК СуммаПоложитКорректировки,
	|	ЕСТЬNULL(тКоррМинус.СуммаОстаток, 0) КАК СуммаОтрицательнойКорректировки,
	|	ЕСТЬNULL(тПереоцПлюс.СуммаОстаток, 0) КАК СуммаПоложительнойПереоценки,
	|	ЕСТЬNULL(тПереоцМинус.СуммаОстаток, 0) КАК СуммаОтрицательнойПереоценки,
	|	ЕСТЬNULL(тАмортПремии.СуммаОборот, 0) - ЕСТЬNULL(тРеализованнаяАмортПремии.СуммаОборот, 0) КАК СуммаАмортизацииПремии,
	|	втОблигации.АмортизацияДисконта КАК СуммаАмортизацииДисконта,
	|	втОблигации.КоличествоОстаток КАК КоличествоОстаток,
	|	втОблигации.ЦБ.Объект.Амортизационная КАК Амортизационная,
	|	втОблигации.ЦБ.Объект.НоминальнаяСтоимость КАК Номинал,
	|	втОблигации.Партия КАК Партия,
	|	втОблигации.Партия.Номер КАК ПартияНомер,
	|	втОблигации.Партия.Дата КАК ПартияДата1,
	|	НАЧАЛОПЕРИОДА(втОблигации.Партия.Дата, ДЕНЬ) КАК ПартияДата,
	|	ЕСТЬNULL(табЭСП.ЭСП, 0) КАК ЭСП,
	|	НАЧАЛОПЕРИОДА(втОблигации.ЦБ.Объект.ДатаПогашения, ДЕНЬ) КАК ДатаПогашения,
	|	Оферты.МинПериод КАК ДатаОферты,
	|	втОблигации.ЦБ.Объект.КоличествоВВыпуске КАК печКолВоВыпуск,
	|	ЕСТЬNULL(ИндексацияНоминала_Доход.СуммаОборотКт, 0) - ЕСТЬNULL(ИндексацияНоминала_Расходы.СуммаОборотДт, 0) КАК ИндексацияНоминала_Доход_СуммаОборотКт,
	|	ЕСТЬNULL(ИндексацияНоминала_Доход.СуммаНУОборотКт, 0) - ЕСТЬNULL(ИндексацияНоминала_Расходы.СуммаНУОборотДт, 0) КАК ИндексацияНоминала_Доход_СуммаНУОборотКт
	|ИЗ
	|	втОблигации КАК втОблигации
