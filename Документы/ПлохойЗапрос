	|			И втОблигации.Партия = тКоррПлюс.Субконто2
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕПС.Остатки(&НаДату, Счет В ИЕРАРХИИ (&списКм), , Портфель = &Портфель) КАК тКоррМинус
	|		ПО втОблигации.ЦБ = тКоррМинус.Субконто1
	|			И втОблигации.Партия = тКоррМинус.Субконто2
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕПС.Остатки(&НаДату, Счет В ИЕРАРХИИ (&списПп), , Портфель = &Портфель) КАК тПереоцПлюс
	|		ПО втОблигации.ЦБ = тПереоцПлюс.Субконто1
	|			И втОблигации.Партия = тПереоцПлюс.Субконто2
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕПС.Остатки(&НаДату, Счет В ИЕРАРХИИ (&списПм), , Портфель = &Портфель) КАК тПереоцМинус
	|		ПО втОблигации.ЦБ = тПереоцМинус.Субконто1
	|			И втОблигации.Партия = тПереоцМинус.Субконто2
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕПС.Обороты(
	|				,
	|				&НаДату,
	|				,
	|				Счет В ИЕРАРХИИ (&списЦБ),
	|				,
	|				Портфель = &Портфель
	|					И Субконто2 = ЗНАЧЕНИЕ(Перечисление.ЧастиЦенныхБумаг.Премия),
	|				КорСчет В ИЕРАРХИИ (&с71004),
	|				) КАК тАмортПремии
	|		ПО втОблигации.ЦБ = тАмортПремии.Субконто1
	|			И втОблигации.Партия = тАмортПремии.Субконто3
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕПС.Обороты(
	|				,
	|				&НаДату,
	|				,
	|				Счет В ИЕРАРХИИ (&списЦБ),
	|				,
	|				Портфель = &Портфель
	|					И Субконто2 = ЗНАЧЕНИЕ(Перечисление.ЧастиЦенныхБумаг.Премия),
	|				КорСчет В ИЕРАРХИИ (&с61210)
	|					ИЛИ КорСчет В ИЕРАРХИИ (&с47903),
	|				) КАК тРеализованнаяАмортПремии
	|		ПО втОблигации.ЦБ = тРеализованнаяАмортПремии.Субконто1
	|			И втОблигации.Партия = тРеализованнаяАмортПремии.Субконто3
