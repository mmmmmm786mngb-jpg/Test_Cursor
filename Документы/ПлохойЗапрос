	|		ПО втОблигации.ЦБ = табЭСП.Актив
	|			И втОблигации.Партия = табЭСП.Партия
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСрезПервых КАК Оферты
	|		ПО втОблигации.ЦБ = Оферты.ЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕПС.Обороты(
	|				,
	|				&НаДату,
	|				,
	|				Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.ЕПС.ФинансовыеРезультаты_71503)),
	|				,
	|				Портфель = &Портфель
	|					И Субконто1 В (&СписокЭлементовОФР)
	|					И КорСубконто1.Объект.ИндексируемыйНоминал = ИСТИНА
	|					И КорСубконто2 = ЗНАЧЕНИЕ(Перечисление.ЧастиЦенныхБумаг.ИндексацияНоминала),
	|				КорСчет В ИЕРАРХИИ (&списЦБ),
	|				) КАК ИндексацияНоминала_Доход
	|		ПО втОблигации.ЦБ = ИндексацияНоминала_Доход.КорСубконто1
	|			И втОблигации.Партия = ИндексацияНоминала_Доход.КорСубконто3
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕПС.Обороты(
	|				,
	|				&НаДату,
	|				,
	|				Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.ЕПС.ФинансовыеРезультаты_71504) , ЗНАЧЕНИЕ(ПланСчетов.ЕПС.Имущество_61210)),
	|				,
	|				Портфель = &Портфель
	|					И НЕ Субконто1 В (&СписокЭлементовОФР)
	|					И КорСубконто1.Объект.ИндексируемыйНоминал = ИСТИНА
	|					И КорСубконто2 = ЗНАЧЕНИЕ(Перечисление.ЧастиЦенныхБумаг.ИндексацияНоминала),
	|				КорСчет В ИЕРАРХИИ (&списЦБ),
	|				) КАК ИндексацияНоминала_Расходы
	|		ПО втОблигации.ЦБ = ИндексацияНоминала_Расходы.КорСубконто1
	|			И втОблигации.Партия = ИндексацияНоминала_Расходы.КорСубконто3
	|
	|УПОРЯДОЧИТЬ ПО
	|	втОблигации.Партия.МоментВремени
