&НаСервере
// Описание: Формирует отчет "Расшифровка финансовых вложений" на сервере
//           Выполняет оптимизированный запрос, обрабатывает результаты и выводит отчет
//           Накапливает итоги по группам и общие итоги
//
// Особенности оптимизированной версии:
//   - Использует функцию ПодготовитьПараметрыЗапроса для подготовки параметров
//   - Использует функцию ПолучитьТекстЗапроса для получения текста запроса
//   - Использует функцию ОбработатьГруппуЦенныхБумаг для обработки групп
//   - Использует функцию РассчитатьФинансовыеПоказатели для расчета показателей
//   - Использует функцию ОбработатьСтрокуОтчета для обработки строк
//
// Пример:
//   СформироватьОтчетНаСервереОптимизированный();
//
Процедура СформироватьОтчетНаСервереОптимизированный()
	
	ПараметрыЗапроса = ПодготовитьПараметрыЗапроса(НаДату, Портфель);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаДату", ПараметрыЗапроса.НаДату);
	Запрос.УстановитьПараметр("Портфель", ПараметрыЗапроса.Портфель);
	Запрос.УстановитьПараметр("СписокЭлементовОФР", ПараметрыЗапроса.СписокЭлементовОФР);
	Запрос.УстановитьПараметр("СписокСчетовЦенныхБумаг", ПараметрыЗапроса.СписокСчетовЦенныхБумаг);
	Запрос.УстановитьПараметр("СписокСчетовПоложительнойКорректировки", ПараметрыЗапроса.СписокСчетовПоложительнойКорректировки);
	Запрос.УстановитьПараметр("СписокСчетовОтрицательнойКорректировки", ПараметрыЗапроса.СписокСчетовОтрицательнойКорректировки);
	Запрос.УстановитьПараметр("СписокСчетовПоложительнойПереоценки", ПараметрыЗапроса.СписокСчетовПоложительнойПереоценки);
	Запрос.УстановитьПараметр("СписокСчетовОтрицательнойПереоценки", ПараметрыЗапроса.СписокСчетовОтрицательнойПереоценки);
	Запрос.УстановитьПараметр("ОбщийСписокСчетовКорректировок", ПараметрыЗапроса.ОбщийСписокСчетовКорректировок);
	Запрос.УстановитьПараметр("ВидыСубконтоЕПС", ПараметрыЗапроса.ВидыСубконтоЕПС);
	Запрос.УстановитьПараметр("ВидыСубконтоЕПСКорректировок", ПараметрыЗапроса.ВидыСубконтоЕПСКорректировок);
	Запрос.УстановитьПараметр("СчетФинансовыеРезультаты71004", ПараметрыЗапроса.СчетФинансовыеРезультаты71004);
	Запрос.УстановитьПараметр("СчетВспомогательныйПассивный", ПараметрыЗапроса.СчетВспомогательныйПассивный);
	Запрос.УстановитьПараметр("СчетИмущество61210", ПараметрыЗапроса.СчетИмущество61210);
	Запрос.УстановитьПараметр("СчетРасчеты47903", ПараметрыЗапроса.СчетРасчеты47903);
	Запрос.УстановитьПараметр("СчетФинансовыеРезультаты71503", ПараметрыЗапроса.СчетФинансовыеРезультаты71503);
	Запрос.УстановитьПараметр("СчетФинансовыеРезультаты71504", ПараметрыЗапроса.СчетФинансовыеРезультаты71504);
	Запрос.УстановитьПараметр("СписокКорреспондирующихСчетовРеализацииПремии", ПараметрыЗапроса.СписокКорреспондирующихСчетовРеализацииПремии);
	
	Запрос.Текст = ПолучитьТекстЗапроса();
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаИтогов = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТипОблигация = Тип("СправочникСсылка.Облигации");
	ТипНота = Тип("СправочникСсылка.СтруктурныеНоты");
	ТипАкция = Тип("СправочникСсылка.Акции");
	ТипДР = Тип("СправочникСсылка.ДепозитарныеРасписки");
	
	КонстантаСекундВДне = 86400;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("НаДату", НаДату);
	ПараметрыРасчета.Вставить("КонстантаСекундВДне", КонстантаСекундВДне);
	ПараметрыРасчета.Вставить("ТипОблигация", ТипОблигация);
	ПараметрыРасчета.Вставить("ТипНота", ТипНота);
	ПараметрыРасчета.Вставить("ТипАкция", ТипАкция);
	ПараметрыРасчета.Вставить("ТипДР", ТипДР);
	
	НаДатуФорматированная = Формат(НаДату, "ДФ=dd.MM.yyyy");
	
	ВсегоИтого = Новый Структура;
	ВсегоИтого.Вставить("ИтогоСуммаНоминал", 0);
	ВсегоИтого.Вставить("ИтогоДисконт", 0);
	ВсегоИтого.Вставить("ИтогоПремия", 0);
	ВсегоИтого.Вставить("ИтогоУКД", 0);
	ВсегоИтого.Вставить("ИтогоАмортизацияДисконта", 0);
	ВсегоИтого.Вставить("ИтогоАмортизацияПремии", 0);
	ВсегоИтого.Вставить("ИтогоНКД", 0);
	ВсегоИтого.Вставить("ИтогоСуммаПоложительнойКорректировки", 0);
	ВсегоИтого.Вставить("ИтогоСуммаОтрицательнойКорректировки", 0);
	ВсегоИтого.Вставить("ИтогоСуммаПоложительнойПереоценки", 0);
	ВсегоИтого.Вставить("ИтогоСуммаОтрицательнойПереоценки", 0);
	ВсегоИтого.Вставить("ИтогоИндексацияНоминалаДоходСуммаОборотКт", 0);
	ВсегоИтого.Вставить("ИтогоВсегоБаланс", 0);
	
	ЭтаОбработка = РеквизитФормыВЗначение("Отчет");
	Макет = ЭтаОбработка.ПолучитьМакет("Макет");
	
	ПолеРезультат.Очистить();
	ОбластьДанных = Макет.ПолучитьОбласть("Шапка");
	ОбластьДанных.Параметры.Портфель = Портфель;
	ОбластьДанных.Параметры.НаДату = НаДатуФорматированная;
	ПолеРезультат.Вывести(ОбластьДанных);
	ПолеРезультат.ФиксацияСверху = ПолеРезультат.ВысотаТаблицы;
	
	Пока ВыборкаИтогов.Следующий() Цикл
		
		ОбластьДанных = Макет.ПолучитьОбласть("Группа");
		ОбластьДанных.Параметры.ТипАктива = ВыборкаИтогов.СчетНаименование;
		ПолеРезультат.Вывести(ОбластьДанных);
		
		ИтогиГруппы = ОбработатьГруппуЦенныхБумаг(ВыборкаИтогов, Макет, ПолеРезультат, ПараметрыРасчета);
		
		ОбластьДанных = Макет.ПолучитьОбласть("ИтогоГруппа");
		ПараметрыОбласти = ОбластьДанных.Параметры;
		ПараметрыОбласти.Заполнить(ВыборкаИтогов);
		
		ПараметрыОбласти.ТипАктива = ВыборкаИтогов.СчетНаименование + " итого:";
		ПараметрыОбласти.Дисконт = ИтогиГруппы.ИтогоДисконт;
		ПараметрыОбласти.Премия = ИтогиГруппы.ИтогоПремия;
		ПараметрыОбласти.АмортизацияДисконта = ИтогиГруппы.ИтогоАмортизацияДисконта;
		ПараметрыОбласти.АмортизацияПремии = ИтогиГруппы.ИтогоАмортизацияПремии;
		ПараметрыОбласти.СуммаНоминал = ИтогиГруппы.ИтогоСуммаНоминал;
		ПараметрыОбласти.ИтБаланс = ИтогиГруппы.ИтогоБаланс;
		
		ПолеРезультат.Вывести(ОбластьДанных);
		
		ВсегоИтого.ИтогоДисконт = ВсегоИтого.ИтогоДисконт + ИтогиГруппы.ИтогоДисконт;
		ВсегоИтого.ИтогоПремия = ВсегоИтого.ИтогоПремия + ИтогиГруппы.ИтогоПремия;
		ВсегоИтого.ИтогоАмортизацияДисконта = ВсегоИтого.ИтогоАмортизацияДисконта + ИтогиГруппы.ИтогоАмортизацияДисконта;
		ВсегоИтого.ИтогоАмортизацияПремии = ВсегоИтого.ИтогоАмортизацияПремии + ИтогиГруппы.ИтогоАмортизацияПремии;
		ВсегоИтого.ИтогоСуммаНоминал = ВсегоИтого.ИтогоСуммаНоминал + ИтогиГруппы.ИтогоСуммаНоминал;
		ВсегоИтого.ИтогоВсегоБаланс = ВсегоИтого.ИтогоВсегоБаланс + ИтогиГруппы.ИтогоБаланс;
		ВсегоИтого.ИтогоУКД = ВсегоИтого.ИтогоУКД + ВыборкаИтогов.УКД;
		ВсегоИтого.ИтогоНКД = ВсегоИтого.ИтогоНКД + ВыборкаИтогов.НКД;
		ВсегоИтого.ИтогоСуммаПоложительнойКорректировки = ВсегоИтого.ИтогоСуммаПоложительнойКорректировки + ВыборкаИтогов.СуммаПоложительнойКорректировки;
		ВсегоИтого.ИтогоСуммаОтрицательнойКорректировки = ВсегоИтого.ИтогоСуммаОтрицательнойКорректировки + ВыборкаИтогов.СуммаОтрицательнойКорректировки;
