&НаСервере
// Описание: Рассчитывает финансовые показатели для одной строки отчета
//           Определяет тип ценной бумаги и рассчитывает номинал, дисконт, премию, баланс
//           Для амортизационных облигаций получает номинал на дату отчета
//
// Параметры:
//   Выборка - Структура - строка результата запроса с данными о ценной бумаге
//   ПараметрыРасчета - Структура - параметры для расчета:
//     * НаДату - Дата - дата отчета для расчета номинала амортизационных облигаций
//     * ТипОблигация - Тип - тип справочника Облигации
//     * ТипНота - Тип - тип справочника СтруктурныеНоты
//     * ТипАкция - Тип - тип справочника Акции
//     * ТипДР - Тип - тип справочника ДепозитарныеРасписки
//
// Возвращаемое значение:
//   Структура - структура с рассчитанными показателями:
//     * Номинал - Число - номинальная стоимость одной ценной бумаги
//     * СуммаНоминал - Число - суммарная номинальная стоимость
//     * Дисконт - Число - дисконт (разница между стоимостью и номиналом)
//     * АмортизацияДисконта - Число - накопленная амортизация дисконта
//     * Премия - Число - премия за вычетом амортизации
//     * АмортизацияПремии - Число - накопленная амортизация премии
//     * Баланс - Число - балансовая стоимость
//     * ЯвляетсяАкциейИлиДР - Булево - признак долевой ценной бумаги
//
Функция РассчитатьФинансовыеПоказатели(Выборка, ПараметрыРасчета)
	ТипЦБ = ТипЗнч(Выборка.ЦБ.Объект);
	ЯвляетсяОблигациейИлиНотой = (ТипЦБ = ПараметрыРасчета.ТипОблигация ИЛИ ТипЦБ = ПараметрыРасчета.ТипНота);
	ЯвляетсяАкциейИлиДР = (ТипЦБ = ПараметрыРасчета.ТипАкция ИЛИ ТипЦБ = ПараметрыРасчета.ТипДР);
	
	Если ЯвляетсяОблигациейИлиНотой Тогда
		Если Выборка.Амортизационная = Истина Тогда
			Номинал = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(Выборка.ЦБ.Объект, ПараметрыРасчета.НаДату);
			СуммаНоминал = Номинал * Выборка.КоличествоОстаток;
		Иначе
			Номинал = Выборка.Номинал;
			СуммаНоминал = Выборка.СуммаНоминал;
		КонецЕсли;
	Иначе
		Номинал = 0;
		СуммаНоминал = Выборка.СуммаНоминал;
	КонецЕсли;
	
	Дисконт = Выборка.СуммаЦеннаяБумага - СуммаНоминал;
	АмортизацияДисконта = Выборка.СуммаАмортизацииДисконта;
	Премия = Выборка.СуммаПремия - Выборка.СуммаАмортизацииПремии;
	АмортизацияПремии = Выборка.СуммаАмортизацииПремии;
	
	Баланс = СуммаНоминал
		+ Премия
		+ Дисконт
		+ АмортизацияДисконта
		+ АмортизацияПремии
		+ Выборка.УКД
		+ Выборка.НКД
		+ Выборка.СуммаПоложительнойКорректировки
		+ Выборка.СуммаОтрицательнойКорректировки
		+ Выборка.СуммаПоложительнойПереоценки
		+ Выборка.СуммаОтрицательнойПереоценки
		+ Выборка.ИндексацияНоминала_Доход_СуммаОборотКт;
	
	Результат = Новый Структура;
	Результат.Вставить("Номинал", Номинал);
	Результат.Вставить("СуммаНоминал", СуммаНоминал);
	Результат.Вставить("Дисконт", Дисконт);
	Результат.Вставить("АмортизацияДисконта", АмортизацияДисконта);
	Результат.Вставить("Премия", Премия);
	Результат.Вставить("АмортизацияПремии", АмортизацияПремии);
	Результат.Вставить("Баланс", Баланс);
	Результат.Вставить("ЯвляетсяАкциейИлиДР", ЯвляетсяАкциейИлиДР);
	
	Возврат Результат;
КонецФункции

&НаСервере
// Описание: Обрабатывает одну строку отчета и заполняет параметры области макета
//           Рассчитывает финансовые показатели, форматирует даты и рассчитывает количество дней
//
// Параметры:
//   Выборка - Структура - строка результата запроса с данными о ценной бумаге
//   ОбластьДанных - ОбластьМакета - область макета для заполнения
//   ПараметрыРасчета - Структура - параметры для расчета:
//     * НаДату - Дата - дата отчета
//     * КонстантаСекундВДне - Число - количество секунд в дне (86400)
//     * ТипОблигация - Тип - тип справочника Облигации
//     * ТипНота - Тип - тип справочника СтруктурныеНоты
//     * ТипАкция - Тип - тип справочника Акции
//     * ТипДР - Тип - тип справочника ДепозитарныеРасписки
//
Процедура ОбработатьСтрокуОтчета(Выборка, ОбластьДанных, ПараметрыРасчета)
	ПараметрыОбласти = ОбластьДанных.Параметры;
	ПараметрыОбласти.Заполнить(Выборка);
	
	ФинансовыеПоказатели = РассчитатьФинансовыеПоказатели(Выборка, ПараметрыРасчета);
	
	ПараметрыОбласти.Номинал = ФинансовыеПоказатели.Номинал;
	
	Если ФинансовыеПоказатели.ЯвляетсяАкциейИлиДР Тогда
		ПараметрыОбласти.СуммаНоминал = ФинансовыеПоказатели.СуммаНоминал + ФинансовыеПоказатели.Дисконт;
	Иначе
		ПараметрыОбласти.СуммаНоминал = ФинансовыеПоказатели.СуммаНоминал;
		ПараметрыОбласти.Дисконт = ФинансовыеПоказатели.Дисконт;
	КонецЕсли;
	
	ПараметрыОбласти.Премия = ФинансовыеПоказатели.Премия;
	ПараметрыОбласти.АмортизацияДисконта = ФинансовыеПоказатели.АмортизацияДисконта;
	ПараметрыОбласти.АмортизацияПремии = ФинансовыеПоказатели.АмортизацияПремии;
	ПараметрыОбласти.ИтБаланс = ФинансовыеПоказатели.Баланс;
	ПараметрыОбласти.ЭСП = Формат(Выборка.ЭСП, "ЧДЦ=15");
	
	ПараметрыОбласти.ПечДатаПогашения = Формат(Выборка.ДатаПогашения, "ДЛФ=Д");
	ПараметрыОбласти.печДатаОферты = Формат(Выборка.ДатаОферты, "ДЛФ=Д");
	
	ПартияДатаЗаполнена = ЗначениеЗаполнено(Выборка.ПартияДата);
	Если ПартияДатаЗаполнена И ЗначениеЗаполнено(Выборка.ДатаПогашения) Тогда
		ПараметрыОбласти.печДнейДоПогашения = (Выборка.ДатаПогашения - Выборка.ПартияДата) / ПараметрыРасчета.КонстантаСекундВДне;
	КонецЕсли;
	
	Если ПартияДатаЗаполнена И ЗначениеЗаполнено(Выборка.ДатаОферты) Тогда
		ПараметрыОбласти.печДнейДоОферты = (Выборка.ДатаОферты - Выборка.ПартияДата) / ПараметрыРасчета.КонстантаСекундВДне;
	КонецЕсли;
КонецПроцедуры

&НаСервере
// Описание: Обрабатывает группу ценных бумаг одного типа счета
//           Выводит строки отчета для каждой ценной бумаги и накапливает итоги группы
//
// Параметры:
//   ВыборкаГруппы - РезультатЗапроса - результат запроса, сгруппированный по типу счета
//   Макет - Макет - макет отчета
//   ПолеРезультат - ПолеФормы - поле формы для вывода результата
//   ПараметрыРасчета - Структура - параметры для расчета:
//     * НаДату - Дата - дата отчета
//     * КонстантаСекундВДне - Число - количество секунд в дне (86400)
//     * ТипОблигация - Тип - тип справочника Облигации
//     * ТипНота - Тип - тип справочника СтруктурныеНоты
//     * ТипАкция - Тип - тип справочника Акции
//     * ТипДР - Тип - тип справочника ДепозитарныеРасписки
//
// Возвращаемое значение:
//   Структура - структура с итогами группы:
//     * ИтогоДисконт - Число
//     * ИтогоПремия - Число
//     * ИтогоАмортизацияДисконта - Число
//     * ИтогоАмортизацияПремии - Число
//     * ИтогоСуммаНоминал - Число
//     * ИтогоБаланс - Число
//
Функция ОбработатьГруппуЦенныхБумаг(ВыборкаГруппы, Макет, ПолеРезультат, ПараметрыРасчета)
	ИтогиГруппы = Новый Структура;
	ИтогиГруппы.Вставить("ИтогоДисконт", 0);
	ИтогиГруппы.Вставить("ИтогоПремия", 0);
	ИтогиГруппы.Вставить("ИтогоАмортизацияДисконта", 0);
	ИтогиГруппы.Вставить("ИтогоАмортизацияПремии", 0);
	ИтогиГруппы.Вставить("ИтогоСуммаНоминал", 0);
	ИтогиГруппы.Вставить("ИтогоБаланс", 0);
	
	ВыборкаЦенныхБумаг = ВыборкаГруппы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЦенныхБумаг.Следующий() Цикл
		
		Если ВыборкаЦенныхБумаг.КоличествоОстаток = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ВыборкаСтрок = ВыборкаЦенныхБумаг.Выбрать();
		ОбластьДанных = Макет.ПолучитьОбласть("Строка");
		
		Пока ВыборкаСтрок.Следующий() Цикл
			
			ОбработатьСтрокуОтчета(ВыборкаСтрок, ОбластьДанных, ПараметрыРасчета);
			
			ПолеРезультат.Вывести(ОбластьДанных);
			
			ФинансовыеПоказатели = РассчитатьФинансовыеПоказатели(ВыборкаСтрок, ПараметрыРасчета);
			
			ИтогиГруппы.ИтогоПремия = ИтогиГруппы.ИтогоПремия + ФинансовыеПоказатели.Премия;
			ИтогиГруппы.ИтогоАмортизацияДисконта = ИтогиГруппы.ИтогоАмортизацияДисконта + ФинансовыеПоказатели.АмортизацияДисконта;
			ИтогиГруппы.ИтогоАмортизацияПремии = ИтогиГруппы.ИтогоАмортизацияПремии + ФинансовыеПоказатели.АмортизацияПремии;
			ИтогиГруппы.ИтогоБаланс = ИтогиГруппы.ИтогоБаланс + ФинансовыеПоказатели.Баланс;
			
			Если ФинансовыеПоказатели.ЯвляетсяАкциейИлиДР Тогда
				ИтогиГруппы.ИтогоСуммаНоминал = ИтогиГруппы.ИтогоСуммаНоминал + ФинансовыеПоказатели.СуммаНоминал + ФинансовыеПоказатели.Дисконт;
			Иначе
				ИтогиГруппы.ИтогоДисконт = ИтогиГруппы.ИтогоДисконт + ФинансовыеПоказатели.Дисконт;
				ИтогиГруппы.ИтогоСуммаНоминал = ИтогиГруппы.ИтогоСуммаНоминал + ФинансовыеПоказатели.СуммаНоминал;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ИтогиГруппы;
КонецФункции

#КонецОбласти

