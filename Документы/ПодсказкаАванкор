Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Выполнена") Тогда
    // На случай, если документ был помечен вручную.
    Если ДокументОбъект.ПометкаУдаления Тогда
        ДокументОбъект.ПометкаУдаления = Ложь;
        ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
    КонецЕсли;
    
    // ДОБАВЛЕНО: Проверка необходимости проведения
    ТребуетсяПроведение = Не (ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.Сделка") 
        И ДокументОбъект.Проведен 
        И ДополнительныеСвойства.Количество() = 0);
    
    Если ТребуетсяПроведение Тогда
        Попытка
            ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДокументОбъект.ДополнительныеСвойства, ДополнительныеСвойства, Истина);
            
            Если ДокументОбъект.Метаданные().Проведение = Метаданные.СвойстваОбъектов.Проведение.Запретить Тогда
                ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
            Иначе
                ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
            КонецЕсли;
        Исключение
            Отказ = Истина;
            ОбщегоНазначенияДУКлиентСервер.СообщитьОбОшибке(ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
КонецЕсли;
