Запрос.Текст = 
	"// ДОБАВЛЕНО: поле Счет в выборку ВТ_ЕПС (в оригинале не было, но использовалось в итоговом запросе)
	|// ДОБАВЛЕНО: индекс ИНДЕКСИРОВАТЬ ПО ДокументОплаты для оптимизации JOIN (в оригинале индексов не было)
	|// ДОБАВЛЕНО: третий параметр &ВидыСубконтоЕПС в вызов Остатки ЕПС (в оригинале был пустой параметр)
	|// ИЗМЕНЕНО: ВТ_ЕПС теперь содержит только остатки, без полей из ВТ_СделкиРЕПО
	|ВЫБРАТЬ
	|	ЕПСОстатки.Субконто3 КАК ДокументОплаты,
	|	ЕПСОстатки.ВалютнаяСуммаОстаток КАК ОстатокЕПС,
	|	ЕПСОстатки.Валюта               КАК Валюта,
	|	ЕПСОстатки.Субконто1            КАК Контрагент,
	|	ЕПСОстатки.Субконто2            КАК Договор,
	|	ЕПСОстатки.Счет                 КАК Счет
	|ПОМЕСТИТЬ ВТ_ЕПС
	|ИЗ
	|	РегистрБухгалтерии.ЕПС.Остатки(
	|		&ДатаДок,
	|		Счет В (&Счета19),
	|		&ВидыСубконтоЕПС,
	|		Портфель = &Портфель И &ЕПС
	|	) КАК ЕПСОстатки
	|ГДЕ
	|	ЕПСОстатки.Субконто3 ССЫЛКА Документ.ОперацияПоСчетуБрокера
	|ИНДЕКСИРОВАТЬ ПО ДокументОплаты;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ДОБАВЛЕНО: поле Счет в выборку ВТ_БУ (в оригинале не было, но использовалось в итоговом запросе)
	|// ДОБАВЛЕНО: индекс ИНДЕКСИРОВАТЬ ПО ДокументОплаты для оптимизации JOIN (в оригинале индексов не было)
	|// ДОБАВЛЕНО: третий параметр &ВидыСубконтоХозрасчетные в вызов Остатки Хозрасчетный (в оригинале был пустой параметр)
	|// ИЗМЕНЕНО: ВТ_БУ теперь содержит только остатки, без полей из ВТ_СделкиРЕПО
	|ВЫБРАТЬ
	|	БУОстатки.Субконто3 КАК ДокументОплаты,
	|	БУОстатки.ВалютнаяСуммаОстаток КАК ОстатокБУ,
	|	БУОстатки.Валюта               КАК Валюта,
	|	БУОстатки.Субконто1            КАК Контрагент,
	|	БУОстатки.Субконто2            КАК Договор,
	|	БУОстатки.Счет                 КАК Счет
	|ПОМЕСТИТЬ ВТ_БУ
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|		&ДатаДок,
	|		Счет = &Счет_76_15,
	|		&ВидыСубконтоХозрасчетные,
	|		Портфель = &Портфель И &БУ
	|	) КАК БУОстатки
	|ГДЕ
	|	БУОстатки.Субконто3 ССЫЛКА Документ.ОперацияПоСчетуБрокера
	|ИНДЕКСИРОВАТЬ ПО ДокументОплаты;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ДОБАВЛЕНО: промежуточная таблица ВТ_ОперацияПоСчетуБрокера — объединяет все уникальные ссылки Субконто3 из ВТ_ЕПС и ВТ_БУ
	|// Используется вместо прямого обращения к Документ.ОперацияПоСчетуБрокера в ВТ_Сделки
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(ВТ_ЕПС.ДокументОплаты, ВТ_БУ.ДокументОплаты) КАК Операция
	|ПОМЕСТИТЬ ВТ_ОперацияПоСчетуБрокера
	|ИЗ
	|	ВТ_ЕПС КАК ВТ_ЕПС
	|	ПОЛНОЕ СОЕДИНЕНИЕ ВТ_БУ КАК ВТ_БУ
	|		ПО ВТ_ЕПС.ДокументОплаты = ВТ_БУ.ДокументОплаты
	|ИНДЕКСИРОВАТЬ ПО Операция;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ИЗМЕНЕНО: ВТ_Сделки теперь строится не из Документ.ОперацияПоСчетуБрокера, а из ВТ_ОперацияПоСчетуБрокера
	|// Это гарантирует, что в выборку попадут ВСЕ документы, имеющие остатки в ЕПС или БУ
	|// ИЗНАЧАЛЬНО: была таблица ВТ_СделкиРЕПО — только документы с привязкой к СделкиРЕПО
	|ВЫБРАТЬ
	|	ОперацияПоСчетуБрокера.Ссылка                                      КАК Операция,
	|	ОперацияПоСчетуБрокера.СуммаДокумента                              КАК НачальнаяСуммаКомиссии,
	|	ОперацияПоСчетуБрокера.Дата                                        КАК ДатаОплатыКомиссии,
	|	СделкиРЕПО.ДатаПеререгистрацииВторойЧастиСделкиРЕПО                КАК ДатаПеререгистрацииВторойЧасти,
	|	СделкиРЕПО.Ссылка                                                  КАК СделкаРЕПО,
	|	ОперацияПоСчетуБрокера.СтатьяЗатрат                                КАК СтатьяЗатрат,
	|	РАЗНОСТЬДАТ(ОперацияПоСчетуБрокера.Дата, СделкиРЕПО.ДатаПеререгистрацииВторойЧастиСделкиРЕПО, ДЕНЬ) КАК КоличествоДнейВсего,
	|	ВЫБОР
	|		КОГДА РАЗНОСТЬДАТ(ОперацияПоСчетуБрокера.Дата, &ДатаДок, ДЕНЬ) < РАЗНОСТЬДАТ(ОперацияПоСчетуБрокера.Дата, СделкиРЕПО.ДатаПеререгистрацииВторойЧастиСделкиРЕПО, ДЕНЬ)
	|			ТОГДА РАЗНОСТЬДАТ(ОперацияПоСчетуБрокера.Дата, &ДатаДок, ДЕНЬ)
	|		ИНАЧЕ РАЗНОСТЬДАТ(ОперацияПоСчетуБрокера.Дата, СделкиРЕПО.ДатаПеререгистрацииВторойЧастиСделкиРЕПО, ДЕНЬ)
	|	КОНЕЦ                                                              КАК КоличествоДней
	|ПОМЕСТИТЬ ВТ_Сделки
	|ИЗ
	|	ВТ_ОперацияПоСчетуБрокера КАК УникальныеОперации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОперацияПоСчетуБрокера КАК ОперацияПоСчетуБрокера
	|			ПО УникальныеОперации.Операция = ОперацияПоСчетуБрокера.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ БизнесПроцесс.СделкиРЕПО КАК СделкиРЕПО
	|			ПО ОперацияПоСчетуБрокера.БизнесПроцесс = СделкиРЕПО.Ссылка
	|ГДЕ
	|	ОперацияПоСчетуБрокера.Портфель = &Портфель
	|ИНДЕКСИРОВАТЬ ПО Операция;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// ИЗМЕНЕНО: структура финального запроса — начинается с ВТ_Сделки, затем ЛЕВОЕ СОЕДИНЕНИЕ к ВТ_ЕПС и ВТ_БУ
	|// (в оригинале: ПОЛНОЕ СОЕДИНЕНИЕ между ВТ_ЕПС и ВТ_БУ)
	|// ИЗМЕНЕНО: поля СчетЕПС и СчетБУ используют ЗНАЧЕНИЕ(...) вместо пустой строки (правильная типизация)
	|// ДОБАВЛЕНО: вычисление СуммаАмортизации в SQL с использованием КоличествоДней и КоличествоДнейВсего
	|// (в оригинале: вычисление в цикле через КоличествоПериодов и Мин)
	|// ДОБАВЛЕНО: явное указание типа ВЫРАЗИТЬ(... КАК ЧИСЛО(15,2))
	|// ДОБАВЛЕНО: проверка Если КоличествоДней * КоличествоДнейВсего <= 0 Тогда СуммаАмортизации = 0
	|// ИЗМЕНЕНО: СуммаАмортизации вынесена сразу после СтатьяЗатрат для соответствия порядку полей старого запроса
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЕПС.Валюта, БУ.Валюта)                                      КАК ВалютаКомиссии,
	|	ЕСТЬNULL(ЕПС.Контрагент, БУ.Контрагент)                              КАК Контрагент,
	|	ЕСТЬNULL(ЕПС.Договор, БУ.Договор)                                    КАК ДоговорКонтрагента,
	|	Сделки.Операция                                                      КАК ДокументОплаты,
	|	Сделки.ДатаОплатыКомиссии                                            КАК ДатаОплатыКомиссии,
	|	Сделки.ДатаПеререгистрацииВторойЧасти                               КАК ДатаПеререгистрацииВторойЧасти,
	|	Сделки.СделкаРЕПО                                                    КАК СделкаРЕПО,
	|	Сделки.НачальнаяСуммаКомиссии                                        КАК НачальнаяСуммаКомиссии,
	|	ЕСТЬNULL(ЕПС.Счет, ЗНАЧЕНИЕ(ПланСчетов.ЕПС.ПустаяСсылка))            КАК СчетЕПС,
	|	ЕСТЬNULL(БУ.Счет, ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка))    КАК СчетБУ,
	|	Сделки.СтатьяЗатрат                                                  КАК СтатьяЗатрат,
	|	ВЫРАЗИТЬ(
	|		ВЫБОР
	|			КОГДА Сделки.КоличествоДней * Сделки.КоличествоДнейВсего <= 0
	|				ТОГДА 0
	|			ИНАЧЕ Сделки.НачальнаяСуммаКомиссии * Сделки.КоличествоДней / Сделки.КоличествоДнейВсего
	|		КОНЕЦ КАК ЧИСЛО(15,2)
	|	)                                                                    КАК СуммаАмортизации,
	|	ЕСТЬNULL(БУ.ОстатокБУ, 0)                                            КАК ОстатокКомиссииБУ,
	|	ЕСТЬNULL(ЕПС.ОстатокЕПС, 0)                                          КАК ОстатокКомиссииЕПС
	|ИЗ
	|	ВТ_Сделки КАК Сделки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЕПС КАК ЕПС
	|			ПО Сделки.Операция = ЕПС.ДокументОплаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БУ КАК БУ
	|			ПО Сделки.Операция = БУ.ДокументОплаты";
