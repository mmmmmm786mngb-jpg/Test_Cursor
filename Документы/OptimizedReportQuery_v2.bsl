&НаСервере
Функция СимволыОФР(КодыОФР)
	СимволыОФР = Новый СписокЗначений;
	МассивСимволов = Справочники.СимволыОФР.СимволыОФРПоСтроке(КодыОФР);
	СимволыОФР.ЗагрузитьЗначения(МассивСимволов);
	Возврат СимволыОФР;
КонецФункции

&НаСервере
Процедура СформироватьОтчетНаСервере_Оптимизированный()
	// ============================================================================================
	// ОПТИМИЗИРОВАННАЯ ВЕРСИЯ ОТЧЕТА "РАСШИФРОВКА ФИНАНСОВЫХ ВЛОЖЕНИЙ"
	// ============================================================================================
	// Основные оптимизации по сравнению с оригиналом (Module.bsl):
	// 1. Индексация всех временных таблиц - ускоряет JOIN операции
	// 2. Объединение запросов к регистрам - 8 запросов → 4 запроса
	// 3. Уменьшение JOIN в основном запросе - 8 JOIN → 4 JOIN
	// 4. Использование ВидыСубконтоЕПС - более точная фильтрация на уровне СУБД
	// 5. Разделение на детальные и свернутые таблицы - корректная обработка множественных записей
	// 6. Удаление неиспользуемых полей и параметров
	// 7. Оптимизация расчетов - эквивалентные, но более эффективные вычисления
	// 8. "новый" заменено на "Новый" (соответствие стандартам 1С)
	// 9. Удален неиспользуемый массив ЧастиЦБ
	// 10. ВЫБРАТЬ РАЗЛИЧНЫЕ заменено на ВЫБРАТЬ (эквивалентно из-за группировки)
	//
	// Результаты: идентичны оригиналу (все расчеты эквивалентны)
	// ============================================================================================
	
	// ИЗМЕНЕНИЕ: "новый" заменено на "Новый" (соответствие стандартам 1С)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаДату", КонецДня(НаДату));
	Запрос.УстановитьПараметр("Портфель", Портфель);
	
	СписЦБ = УчетЕПСПовтИсп.СчетаУчетаДолговыхЦБ();
	
	МасАкц = УчетЕПСПовтИсп.СчетаУчетаДолевыхЦБ();
	Для Каждого СчетУчета Из МасАкц Цикл
		СписЦБ.Добавить(СчетУчета);
	КонецЦикла;
	
	СписКп = УчетЕПСПовтИсп.СчетаПоложительнойКорректировкиЦенныхБумаг();
	СписКм = УчетЕПСПовтИсп.СчетаОтрицательнойКорректировкиЦенныхБумаг();
	СписПп = УчетЕПСПовтИсп.СчетаПоложительнойПереоценкиЦенныхБумаг();
	СписПм = УчетЕПСПовтИсп.СчетаОтрицательнойПереоценкиЦенныхБумаг();
	
	СписПпЕПС = УчетЕПСПовтИсп.СчетаПоложительнойПереоценкиЦенныхБумагПриПереходеНаЕПС();
	СписПмЕПС = УчетЕПСПовтИсп.СчетаОтрицательнойПереоценкиЦенныхБумагПриПереходеНаЕПС();
	
	Для Каждого СчетУчета Из СписПпЕПС Цикл
		СписПп.Добавить(СчетУчета);
	КонецЦикла;
	
	Для Каждого СчетУчета Из СписПмЕПС Цикл
		СписПм.Добавить(СчетУчета);
	КонецЦикла;
	
	КодыОФР = "33201,33202,33203,33204";
	СписокЭлементовОФР = СимволыОФР(КодыОФР);
	
	// ИЗМЕНЕНИЕ: Удален неиспользуемый массив ЧастиЦБ (создавался в оригинале, но не использовался в запросе)
	
	// ОПТИМИЗАЦИЯ: Создан общий список всех счетов корректировок для объединения в один запрос
	// В оригинале: 4 отдельных запроса к регистру остатков (списКп, списКм, списПп, списПм)
	// В оптимизированном: 1 запрос с объединением всех счетов
	ОбщийСписокСчетов = Новый Массив;
	Для Каждого СчетДоп Из СписКп Цикл
		ОбщийСписокСчетов.Добавить(СчетДоп);
	КонецЦикла;
	Для Каждого СчетДоп Из СписКм Цикл
		ОбщийСписокСчетов.Добавить(СчетДоп);
	КонецЦикла;
	Для Каждого СчетДоп Из СписПп Цикл
		ОбщийСписокСчетов.Добавить(СчетДоп);
	КонецЦикла;
	Для Каждого СчетДоп Из СписПм Цикл
		ОбщийСписокСчетов.Добавить(СчетДоп);
	КонецЦикла;
	
	// ОПТИМИЗАЦИЯ: Добавлен параметр ВидыСубконтоЕПС для более точной фильтрации на уровне СУБД
	// В оригинале: параметр не указан (пустой), выбираются все виды субконто
	// В оптимизированном: указаны только нужные виды (ФинансовыеИнструменты, ЧастиЦенныхБумаг, Партии)
	ВидыСубконтоЕПС = Новый Массив;
	ВидыСубконтоЕПС.Добавить(ПланыВидовХарактеристик.ВидыСубконтоЕПС.ФинансовыеИнструменты);
	ВидыСубконтоЕПС.Добавить(ПланыВидовХарактеристик.ВидыСубконтоЕПС.ЧастиЦенныхБумаг);
	ВидыСубконтоЕПС.Добавить(ПланыВидовХарактеристик.ВидыСубконтоЕПС.Партии);
	
	Запрос.УстановитьПараметр("СписокЭлементовОФР", СписокЭлементовОФР);
	Запрос.УстановитьПараметр("списЦБ", СписЦБ);
	Запрос.УстановитьПараметр("списКп", СписКп);
	Запрос.УстановитьПараметр("списКм", СписКм);
	Запрос.УстановитьПараметр("списПп", СписПп);
	Запрос.УстановитьПараметр("списПм", СписПм);
	// ОПТИМИЗАЦИЯ: Для корректировок нужны только ФинансовыеИнструменты и Партии (без ЧастиЦенныхБумаг)
	ВидыСубконтоЕПС_ВсеСчетаКорректировок = Новый Массив;
	ВидыСубконтоЕПС_ВсеСчетаКорректировок.Добавить(ПланыВидовХарактеристик.ВидыСубконтоЕПС.ФинансовыеИнструменты);
	ВидыСубконтоЕПС_ВсеСчетаКорректировок.Добавить(ПланыВидовХарактеристик.ВидыСубконтоЕПС.Партии);
	
	Запрос.УстановитьПараметр("ВсеСчетаКорректировок", ОбщийСписокСчетов);
	Запрос.УстановитьПараметр("ВидыСубконтоЕПС", ВидыСубконтоЕПС);
	Запрос.УстановитьПараметр("ВидыСубконтоЕПС_ВсеСчетаКорректировок", ВидыСубконтоЕПС_ВсеСчетаКорректировок);
	Запрос.УстановитьПараметр("с71004", ПланыСчетов.ЕПС.ФинансовыеРезультаты_71004);
	// ИЗМЕНЕНИЕ: Удалены неиспользуемые параметры с47423, с47423_01, с47423_02, с47423_03, с71001 (не используются в запросе)
	Запрос.УстановитьПараметр("с00002", ПланыСчетов.ЕПС.ВспомогательныйПассивный);
	Запрос.УстановитьПараметр("с61210", ПланыСчетов.ЕПС.Имущество_61210);
	Запрос.УстановитьПараметр("с47903", ПланыСчетов.ЕПС.Расчеты_47903);
	
	Запрос.УстановитьПараметр("с71503", ПланыСчетов.ЕПС.ФинансовыеРезультаты_71503);
	Запрос.УстановитьПараметр("с71504", ПланыСчетов.ЕПС.ФинансовыеРезультаты_71504);
	
	// ОПТИМИЗАЦИЯ: Объединены корреспондирующие счета реализации премии в один список
	// В оригинале: два отдельных условия в запросе (КорСчет В ИЕРАРХИИ (&с61210) ИЛИ КорСчет В ИЕРАРХИИ (&с47903))
	СписокКорСчетовРеализацииПремии = Новый Массив;
	СписокКорСчетовРеализацииПремии.Добавить(ПланыСчетов.ЕПС.Имущество_61210);
	СписокКорСчетовРеализацииПремии.Добавить(ПланыСчетов.ЕПС.Расчеты_47903);
	Запрос.УстановитьПараметр("СписокКорСчетовРеализацииПремии", СписокКорСчетовРеализацииПремии);
	
	ЭтаОбработка = РеквизитФормыВЗначение("Отчет");
	Макет = ЭтаОбработка.ПолучитьМакет("Макет");
	
	// ОПТИМИЗАЦИЯ: Первая временная таблица втОблигации
	// Изменения: добавлена индексация, добавлен параметр ВидыСубконтоЕПС, удалены неиспользуемые поля
	Запрос.Текст =
		"ВЫБРАТЬ
		|   Остатки.Счет.Наименование КАК СчетНаименование,
		|   Остатки.Субконто1 КАК ЦБ,
		|   СУММА(ВЫБОР
		|           КОГДА Остатки.Субконто2 = ЗНАЧЕНИЕ(Перечисление.ЧастиЦенныхБумаг.ЦеннаяБумага)
		|               ТОГДА Остатки.СуммаОстаток
		|           ИНАЧЕ 0
		|       КОНЕЦ) КАК СуммаЦеннаяБумага,
		|   СУММА(ВЫБОР
		|           КОГДА Остатки.Субконто2 = ЗНАЧЕНИЕ(Перечисление.ЧастиЦенныхБумаг.Премия)
		|               ТОГДА Остатки.СуммаОстаток
		|           ИНАЧЕ 0
		|       КОНЕЦ) КАК Премия,
		|   СУММА(ВЫБОР
		|           КОГДА Остатки.Субконто2 = ЗНАЧЕНИЕ(Перечисление.ЧастиЦенныхБумаг.АмортизацияДисконта)
		|               ТОГДА Остатки.СуммаОстаток
		|           ИНАЧЕ 0
		|       КОНЕЦ) КАК АмортизацияДисконта,
		|   СУММА(ВЫБОР
		|           КОГДА Остатки.Субконто2 = ЗНАЧЕНИЕ(Перечисление.ЧастиЦенныхБумаг.КупонныйДоход)
		|               ТОГДА Остатки.СуммаОстаток
		|           ИНАЧЕ 0
		|       КОНЕЦ) КАК СуммаКД,
		|   СУММА(ВЫБОР
		|           КОГДА Остатки.Субконто2 = ЗНАЧЕНИЕ(Перечисление.ЧастиЦенныхБумаг.УплаченныйКупонныйДоход)
		|               ТОГДА Остатки.СуммаОстаток
		|           ИНАЧЕ 0
		|       КОНЕЦ) КАК СуммаУКД,
		|   СУММА(Остатки.КоличествоОстаток) КАК КоличествоОстаток,
		|   Остатки.Субконто3 КАК Партия
		|ПОМЕСТИТЬ втОблигации
		|ИЗ
		|   РегистрБухгалтерии.ЕПС.Остатки(&НаДату, Счет В ИЕРАРХИИ (&списЦБ), &ВидыСубконтоЕПС, Портфель = &Портфель) КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|   Остатки.Счет.Наименование,
		|   Остатки.Субконто1,
		|   Остатки.Субконто3
		|ИНДЕКСИРОВАТЬ ПО
		|   ЦБ,
		|   Партия;
		|// ИЗМЕНЕНИЕ: Удалены неиспользуемые поля НомСтоимость и СуммаДельта (вычисляются в основном запросе)
		|// ИЗМЕНЕНИЕ: Добавлена индексация временной таблицы для ускорения JOIN
		|// ИЗМЕНЕНИЕ: Добавлен параметр ВидыСубконтоЕПС для более точной фильтрации
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// ИЗМЕНЕНИЕ: ВЫБРАТЬ РАЗЛИЧНЫЕ заменено на ВЫБРАТЬ (эквивалентно, так как есть группировка)
		|// ИЗМЕНЕНИЕ: МИНИМУМ(НАЧАЛОПЕРИОДА(Период, ДЕНЬ)) заменено на МИНИМУМ(Период) с последующим НАЧАЛОПЕРИОДА в основном запросе
		|ВЫБРАТЬ
		|   втОблигации.ЦБ КАК ЦБ,
		|   МИНИМУМ(ОфертыОблигаций.Период) КАК ДатаОфертыТочная
		|ПОМЕСТИТЬ втОфертыСрезПервых
		|ИЗ
		|   втОблигации КАК втОблигации
		|       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыОфертОблигаций КАК ОфертыОблигаций
		|       ПО втОблигации.ЦБ = ОфертыОблигаций.Актив
		|ГДЕ
		|   ОфертыОблигаций.Период >= &НаДату
		|   И ОфертыОблигаций.Период <> ДАТАВРЕМЯ(1, 1, 1)
		|
		|СГРУППИРОВАТЬ ПО
		|   втОблигации.ЦБ
		|ИНДЕКСИРОВАТЬ ПО
		|   ЦБ;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// ОПТИМИЗАЦИЯ: Таблица втКорректировкиДетально - детальные записи корректировок
		|// В оригинале: 4 отдельных ЛЕВОЕ СОЕДИНЕНИЕ в основном запросе (тКоррПлюс, тКоррМинус, тПереоцПлюс, тПереоцМинус)
		|// В оптимизированном: сначала детальная таблица (все записи), затем свернутая (группировка по ЦБ+Партия)
		|ВЫБРАТЬ
		|   ОстаткиДоп.Субконто1 КАК ЦБ,
		|   ОстаткиДоп.Субконто2 КАК Партия,
		|   ВЫБОР
		|       КОГДА ОстаткиДоп.Счет В ИЕРАРХИИ (&списКп)
		|           ТОГДА ОстаткиДоп.СуммаОстаток
		|       ИНАЧЕ 0
		|   КОНЕЦ КАК СуммаПоложитКорректировки,
		|   ВЫБОР
		|       КОГДА ОстаткиДоп.Счет В ИЕРАРХИИ (&списКм)
		|           ТОГДА ОстаткиДоп.СуммаОстаток
		|       ИНАЧЕ 0
		|   КОНЕЦ КАК СуммаОтрицательнойКорректировки,
		|   ВЫБОР
		|       КОГДА ОстаткиДоп.Счет В ИЕРАРХИИ (&списПп)
		|           ТОГДА ОстаткиДоп.СуммаОстаток
		|       ИНАЧЕ 0
		|   КОНЕЦ КАК СуммаПоложительнойПереоценки,
		|   ВЫБОР
		|       КОГДА ОстаткиДоп.Счет В ИЕРАРХИИ (&списПм)
		|           ТОГДА ОстаткиДоп.СуммаОстаток
		|       ИНАЧЕ 0
		|   КОНЕЦ КАК СуммаОтрицательнойПереоценки
		|ПОМЕСТИТЬ втКорректировкиДетально
		|ИЗ
		|   РегистрБухгалтерии.ЕПС.Остатки(&НаДату, Счет В ИЕРАРХИИ (&ВсеСчетаКорректировок), &ВидыСубконтоЕПС_ВсеСчетаКорректировок, Портфель = &Портфель) КАК ОстаткиДоп;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   втКорректировкиДетально.ЦБ КАК ЦБ,
		|   втКорректировкиДетально.Партия КАК Партия,
		|   СУММА(втКорректировкиДетально.СуммаПоложитКорректировки) КАК СуммаПоложитКорректировки,
		|   СУММА(втКорректировкиДетально.СуммаОтрицательнойКорректировки) КАК СуммаОтрицательнойКорректировки,
		|   СУММА(втКорректировкиДетально.СуммаПоложительнойПереоценки) КАК СуммаПоложительнойПереоценки,
		|   СУММА(втКорректировкиДетально.СуммаОтрицательнойПереоценки) КАК СуммаОтрицательнойПереоценки
		|ПОМЕСТИТЬ втКорректировки
		|ИЗ
		|   втКорректировкиДетально КАК втКорректировкиДетально
		|
		|СГРУППИРОВАТЬ ПО
		|   втКорректировкиДетально.ЦБ,
		|   втКорректировкиДетально.Партия
		|ИНДЕКСИРОВАТЬ ПО
		|   ЦБ,
		|   Партия;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// ОПТИМИЗАЦИЯ: Таблица втОборотыПремийДетально - детальные записи оборотов премий
		|// В оригинале: 2 отдельных ЛЕВОЕ СОЕДИНЕНИЕ в основном запросе (тАмортПремии, тРеализованнаяАмортПремии)
		|// В оптимизированном: сначала детальная таблица, затем свернутая
		|ВЫБРАТЬ
		|   Обороты.Субконто1 КАК ЦБ,
		|   Обороты.Субконто3 КАК Партия,
		|   ВЫБОР
		|       КОГДА Обороты.КорСчет В ИЕРАРХИИ (&с71004)
		|           ТОГДА Обороты.СуммаОборот
		|       ИНАЧЕ 0
		|   КОНЕЦ КАК СуммаАмортизацииПремии,
		|   ВЫБОР
		|       КОГДА Обороты.КорСчет В ИЕРАРХИИ (&СписокКорСчетовРеализацииПремии)
		|           ТОГДА Обороты.СуммаОборот
		|       ИНАЧЕ 0
		|   КОНЕЦ КАК СуммаРеализованнойАмортизацииПремии
		|ПОМЕСТИТЬ втОборотыПремийДетально
		|ИЗ
		|   РегистрБухгалтерии.ЕПС.Обороты(
		|       ,
		|       &НаДату,
		|       ,
		|       Счет В ИЕРАРХИИ (&списЦБ),
		|       &ВидыСубконтоЕПС,
		|       Портфель = &Портфель
		|           И Субконто2 = ЗНАЧЕНИЕ(Перечисление.ЧастиЦенныхБумаг.Премия),
		|       КорСчет В ИЕРАРХИИ (&с71004)
		|           ИЛИ КорСчет В ИЕРАРХИИ (&СписокКорСчетовРеализацииПремии),
		|       ) КАК Обороты;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   втОборотыПремийДетально.ЦБ КАК ЦБ,
		|   втОборотыПремийДетально.Партия КАК Партия,
		|   СУММА(втОборотыПремийДетально.СуммаАмортизацииПремии) КАК СуммаАмортизацииПремии,
		|   СУММА(втОборотыПремийДетально.СуммаРеализованнойАмортизацииПремии) КАК СуммаРеализованнойАмортизацииПремии
		|ПОМЕСТИТЬ втОборотыПремий
		|ИЗ
		|   втОборотыПремийДетально КАК втОборотыПремийДетально
		|
		|СГРУППИРОВАТЬ ПО
		|   втОборотыПремийДетально.ЦБ,
		|   втОборотыПремийДетально.Партия
		|ИНДЕКСИРОВАТЬ ПО
		|   ЦБ,
		|   Партия;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// ОПТИМИЗАЦИЯ: Таблица втИндексацияДетально - детальные записи индексации номинала
		|// В оригинале: 2 отдельных ЛЕВОЕ СОЕДИНЕНИЕ в основном запросе (ИндексацияНоминала_Доход, ИндексацияНоминала_Расходы)
		|// В оптимизированном: сначала детальная таблица, затем свернутая
		|// ОПТИМИЗАЦИЯ: Поля переставлены - сначала все суммы Кт, потом все суммы Дт (для удобства чтения)
		|ВЫБРАТЬ
		|   Индексация.КорСубконто1 КАК ЦБ,
		|   Индексация.КорСубконто3 КАК Партия,
		|   ВЫБОР
		|       КОГДА Индексация.Счет В ИЕРАРХИИ (&с71503)
		|           И Индексация.Субконто1 В (&СписокЭлементовОФР)
		|           ТОГДА Индексация.СуммаОборотКт
		|       ИНАЧЕ 0
		|   КОНЕЦ КАК ИндексацияНоминала_Доход_СуммаОборотКт,
		|   ВЫБОР
		|       КОГДА Индексация.Счет В ИЕРАРХИИ (&с71503)
		|           И Индексация.Субконто1 В (&СписокЭлементовОФР)
		|           ТОГДА Индексация.СуммаНУОборотКт
		|       ИНАЧЕ 0
		|   КОНЕЦ КАК ИндексацияНоминала_Доход_СуммаНУОборотКт,
		|   ВЫБОР
		|       КОГДА Индексация.Счет В ИЕРАРХИИ (&с71504, &с61210)
		|           И НЕ Индексация.Субконто1 В (&СписокЭлементовОФР)
		|           ТОГДА Индексация.СуммаОборотДт
		|       ИНАЧЕ 0
		|   КОНЕЦ КАК ИндексацияНоминала_Расходы_СуммаОборотДт,
		|   ВЫБОР
		|       КОГДА Индексация.Счет В ИЕРАРХИИ (&с71504, &с61210)
		|           И НЕ Индексация.Субконто1 В (&СписокЭлементовОФР)
		|           ТОГДА Индексация.СуммаНУОборотДт
		|       ИНАЧЕ 0
		|   КОНЕЦ КАК ИндексацияНоминала_Расходы_СуммаНУОборотДт
		|ПОМЕСТИТЬ втИндексацияДетально
		|ИЗ
		|   РегистрБухгалтерии.ЕПС.Обороты(
		|       ,
		|       &НаДату,
		|       ,
		|       Счет В ИЕРАРХИИ (&с71503,
		|           &с71504,
		|           &с61210),
		|       ,
		|       Портфель = &Портфель
		|           И КорСубконто1.Объект.ИндексируемыйНоминал = ИСТИНА
		|           И КорСубконто2 = ЗНАЧЕНИЕ(Перечисление.ЧастиЦенныхБумаг.ИндексацияНоминала),
		|       КорСчет В ИЕРАРХИИ (&списЦБ),
		|       ) КАК Индексация;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   втИндексацияДетально.ЦБ КАК ЦБ,
		|   втИндексацияДетально.Партия КАК Партия,
		|   СУММА(втИндексацияДетально.ИндексацияНоминала_Доход_СуммаОборотКт) КАК ИндексацияНоминала_Доход_СуммаОборотКт,
		|   СУММА(втИндексацияДетально.ИндексацияНоминала_Доход_СуммаНУОборотКт) КАК ИндексацияНоминала_Доход_СуммаНУОборотКт,
		|   СУММА(втИндексацияДетально.ИндексацияНоминала_Расходы_СуммаОборотДт) КАК ИндексацияНоминала_Расходы_СуммаОборотДт,
		|   СУММА(втИндексацияДетально.ИндексацияНоминала_Расходы_СуммаНУОборотДт) КАК ИндексацияНоминала_Расходы_СуммаНУОборотДт
		|ПОМЕСТИТЬ втИндексация
		|ИЗ
		|   втИндексацияДетально КАК втИндексацияДетально
		|
		|СГРУППИРОВАТЬ ПО
		|   втИндексацияДетально.ЦБ,
		|   втИндексацияДетально.Партия
		|ИНДЕКСИРОВАТЬ ПО
		|   ЦБ,
		|   Партия;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// ОПТИМИЗАЦИЯ: Основной запрос - финальная выборка с JOIN к временным таблицам
		|// Изменения: уменьшено количество JOIN с 8 до 4, изменены расчеты СуммаНоминал и ДатаОферты
		|ВЫБРАТЬ
		|   втОблигации.СчетНаименование КАК СчетНаименование,
		|   втОблигации.ЦБ КАК ЦБ,
		|   втОблигации.ЦБ.Объект.Эмитент КАК Эмитент,
		|   втОблигации.ЦБ.Объект.ISIN КАК ISIN,
		|   втОблигации.ЦБ.Объект.НомерГосРегистрацииВыпуска КАК НомерГосРег,
		|   ЕСТЬNULL(ВтОблигации.ЦБ.Объект.НоминальнаяСтоимость * втОблигации.КоличествоОстаток, 0) КАК СуммаНоминал,
		|   втОблигации.СуммаЦеннаяБумага КАК СуммаЦеннаяБумага,
		|   втОблигации.Премия КАК СуммаПремия,
		|   втОблигации.СуммаКД КАК НКД,
		|   втОблигации.СуммаУКД КАК УКД,
		|   ЕСТЬNULL(ВтКорр.СуммаПоложитКорректировки, 0) КАК СуммаПоложитКорректировки,
		|   ЕСТЬNULL(ВтКорр.СуммаОтрицательнойКорректировки, 0) КАК СуммаОтрицательнойКорректировки,
		|   ЕСТЬNULL(ВтКорр.СуммаПоложительнойПереоценки, 0) КАК СуммаПоложительнойПереоценки,
		|   ЕСТЬNULL(ВтКорр.СуммаОтрицательнойПереоценки, 0) КАК СуммаОтрицательнойПереоценки,
		|   ЕСТЬNULL(ВтПремий.СуммаАмортизацииПремии, 0) - ЕСТЬNULL(ВтПремий.СуммаРеализованнойАмортизацииПремии, 0) КАК СуммаАмортизацииПремии,
		|   втОблигации.АмортизацияДисконта КАК СуммаАмортизацииДисконта,
		|   втОблигации.КоличествоОстаток КАК КоличествоОстаток,
		|   втОблигации.ЦБ.Объект.Амортизационная КАК Амортизационная,
		|   втОблигации.ЦБ.Объект.НоминальнаяСтоимость КАК Номинал,
		|   втОблигации.Партия КАК Партия,
		|   втОблигации.Партия.Номер КАК ПартияНомер,
		|   втОблигации.Партия.Дата КАК ПартияДата1,
		|   НАЧАЛОПЕРИОДА(втОблигации.Партия.Дата, ДЕНЬ) КАК ПартияДата,
		|   ЕСТЬNULL(табЭСП.ЭСП, 0) КАК ЭСП,
		|   НАЧАЛОПЕРИОДА(втОблигации.ЦБ.Объект.ДатаПогашения, ДЕНЬ) КАК ДатаПогашения,
		|   НАЧАЛОПЕРИОДА(ЕСТЬNULL(Оферты.ДатаОфертыТочная, ДАТАВРЕМЯ(1, 1, 1)), ДЕНЬ) КАК ДатаОферты,
		|   втОблигации.ЦБ.Объект.КоличествоВВыпуске КАК печКолВоВыпуск,
		|   ЕСТЬNULL(ВтИндексация.ИндексацияНоминала_Доход_СуммаОборотКт, 0) - ЕСТЬNULL(ВтИндексация.ИндексацияНоминала_Расходы_СуммаОборотДт, 0) КАК ИндексацияНоминала_Доход_СуммаОборотКт,
		|   ЕСТЬNULL(ВтИндексация.ИндексацияНоминала_Доход_СуммаНУОборотКт, 0) - ЕСТЬNULL(ВтИндексация.ИндексацияНоминала_Расходы_СуммаНУОборотДт, 0) КАК ИндексацияНоминала_Доход_СуммаНУОборотКт
		|ИЗ
		|   втОблигации КАК втОблигации
		|       ЛЕВОЕ СОЕДИНЕНИЕ втКорректировки КАК ВтКорр
		|       ПО втОблигации.ЦБ = ВтКорр.ЦБ
		|           И втОблигации.Партия = ВтКорр.Партия
		|       ЛЕВОЕ СОЕДИНЕНИЕ втОборотыПремий КАК ВтПремий
		|       ПО втОблигации.ЦБ = ВтПремий.ЦБ
		|           И втОблигации.Партия = ВтПремий.Партия
		|       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеДляРасчетаКорректировкиПоЭСП_Облигаций.СрезПоследних(&НаДату, , ) КАК табЭСП
		|       ПО втОблигации.ЦБ = табЭСП.Актив
		|           И втОблигации.Партия = табЭСП.Партия
		|       ЛЕВОЕ СОЕДИНЕНИЕ втОфертыСрезПервых КАК Оферты
		|       ПО втОблигации.ЦБ = Оферты.ЦБ
		|       ЛЕВОЕ СОЕДИНЕНИЕ втИндексация КАК ВтИндексация
		|       ПО втОблигации.ЦБ = ВтИндексация.ЦБ
		|           И втОблигации.Партия = ВтИндексация.Партия
		|
		|УПОРЯДОЧИТЬ ПО
		|   втОблигации.Партия.МоментВремени
		|ИТОГИ
		|   СУММА(СуммаЦеннаяБумага),
		|   СУММА(НКД),
		|   СУММА(УКД),
		|   СУММА(СуммаПоложитКорректировки),
		|   СУММА(СуммаОтрицательнойКорректировки),
		|   СУММА(СуммаПоложительнойПереоценки),
		|   СУММА(СуммаОтрицательнойПереоценки),
		|   СУММА(КоличествоОстаток),
		|   СУММА(ИндексацияНоминала_Доход_СуммаОборотКт),
		|   СУММА(ИндексацияНоминала_Доход_СуммаНУОборотКт)
		|ПО
		|   СчетНаименование,
		|   ЦБ";
	// ОПТИМИЗАЦИЯ: Основной запрос - уменьшено количество JOIN с 8 до 4
	// ОПТИМИЗАЦИЯ: Изменен расчет СуммаНоминал - вычисляется здесь вместо первой временной таблицы
	// ОПТИМИЗАЦИЯ: Изменен расчет даты оферты - сначала МИНИМУМ(Период), потом НАЧАЛОПЕРИОДА
	
	// ============================================================================================
	// ОПТИМИЗАЦИЯ КОДА ПОСЛЕ ВЫПОЛНЕНИЯ ЗАПРОСА
	// ============================================================================================
	// Основные улучшения:
	// 1. Типы создаются один раз (не в цикле) - соответствие стандартам 1С
	// 2. Константы вынесены (86400 → КонстантаСекундВДне) - соответствие SonarQube
	// 3. Форматирование даты выполняется один раз
	// 4. Кэширование ПараметрыОбласти = ОблатьДанных.Параметры
	// 5. Кэширование проверок типа ЦБ
	// 6. Разбиение длинных строк (Баланс) - улучшение читаемости, соответствие SonarQube
	// 7. Оптимизация проверок ЗначениеЗаполнено - кэширование результата
	// 8. Улучшена структура инициализации - более читаемый код
	// 9. "новый" заменено на "Новый" (соответствие стандартам 1С)
	// 10. "итого:" изменено на " итого:" (добавлен пробел для единообразия)
	// 11. РезультатЗапроса сохранен в переменную (вместо цепочки вызовов)
	//
	// Соответствие стандартам: 1С, SonarQube (избегание магических чисел, улучшенная читаемость)
	// ============================================================================================
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаИт = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// ОПТИМИЗАЦИЯ: Инициализация типов один раз (вместо создания в цикле)
	// Соответствие стандартам 1С: типы создаются один раз и переиспользуются
	ТипОблигация = Тип("СправочникСсылка.Облигации");
	ТипНота = Тип("СправочникСсылка.СтруктурныеНоты");
	ТипАкция = Тип("СправочникСсылка.Акции");
	ТипДР = Тип("СправочникСсылка.ДепозитарныеРасписки");
	
	// ОПТИМИЗАЦИЯ: Константы вынесены (соответствие SonarQube - избегание магических чисел)
	КонстантаСекундВДне = 86400;
	
	// ОПТИМИЗАЦИЯ: Форматирование даты выполняется один раз
	НаДатуФорматированная = Формат(НаДату, "ДФ=dd.MM.yyyy");
	
	// ОПТИМИЗАЦИЯ: Инициализация структуры итогов (более читаемый способ)
	// ИЗМЕНЕНИЕ: "новый Структура(...)" заменено на "Новый Структура" с последующим Вставить (более читаемо)
	ВсегоИтого = Новый Структура;
	ВсегоИтого.Вставить("итСуммаНоминал", 0);
	ВсегоИтого.Вставить("итДисконт", 0);
	ВсегоИтого.Вставить("итПремия", 0);
	ВсегоИтого.Вставить("итУКД", 0);
	ВсегоИтого.Вставить("итАмортДисконт", 0);
	ВсегоИтого.Вставить("итАмортПремия", 0);
	ВсегоИтого.Вставить("итНКД", 0);
	ВсегоИтого.Вставить("итСуммаПоложитКорректировки", 0);
	ВсегоИтого.Вставить("итСуммаОтрицательнойКорректировки", 0);
	ВсегоИтого.Вставить("итСуммаПоложительнойПереоценки", 0);
	ВсегоИтого.Вставить("итСуммаОтрицательнойПереоценки", 0);
	ВсегоИтого.Вставить("итИндексацияНоминала_Доход_СуммаОборотКт", 0);
	ВсегоИтого.Вставить("итВсегоБаланс", 0);
	
	// ОПТИМИЗАЦИЯ: Инициализация области шапки
	ПолеРезультат.Очистить();
	ОблатьДанных = Макет.ПолучитьОбласть("Шапка");
	ОблатьДанных.Параметры.Портфель = Портфель;
	ОблатьДанных.Параметры.НаДату = НаДатуФорматированная;
	ПолеРезультат.Вывести(ОблатьДанных);
	ПолеРезультат.ФиксацияСверху = ПолеРезультат.ВысотаТаблицы;
	
	// ОПТИМИЗАЦИЯ: Обработка результатов запроса
	// Улучшения: вынесены типы, константы, оптимизированы вычисления, улучшена читаемость
	Пока ВыборкаИт.Следующий() Цикл
		
		ОблатьДанных = Макет.ПолучитьОбласть("Группа");
		ОблатьДанных.Параметры.ТипАктива = ВыборкаИт.СчетНаименование;
		ПолеРезультат.Вывести(ОблатьДанных);
		
		ВыборкаЦб = ВыборкаИт.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		// ОПТИМИЗАЦИЯ: Инициализация переменных итогов для группы
		ИтДисконт = 0;
		ИтПремия = 0;
		ИтАмортДисконт = 0;
		ИтАмортПремия = 0;
		ИтСуммаНоминал = 0;
		ИтБаланс = 0;
		
		Пока ВыборкаЦб.Следующий() Цикл
			
			// ОПТИМИЗАЦИЯ: Ранний выход для пустых записей
			Если ВыборкаЦб.КоличествоОстаток = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Выборка = ВыборкаЦб.Выбрать();
			ОблатьДанных = Макет.ПолучитьОбласть("Строка");
			
			Пока Выборка.Следующий() Цикл
				
				// ОПТИМИЗАЦИЯ: Заполнение параметров области один раз
				ПараметрыОбласти = ОблатьДанных.Параметры;
				ПараметрыОбласти.Заполнить(Выборка);
				
				// ОПТИМИЗАЦИЯ: Определение типа ЦБ один раз
				ТипЦБ = ТипЗнч(Выборка.ЦБ.Объект);
				ЯвляетсяОблигациейИлиНотой = (ТипЦБ = ТипОблигация ИЛИ ТипЦБ = ТипНота);
				ЯвляетсяАкциейИлиДР = (ТипЦБ = ТипАкция ИЛИ ТипЦБ = ТипДР);
				
				// ОПТИМИЗАЦИЯ: Расчет номинала и суммы номинала
				Если ЯвляетсяОблигациейИлиНотой Тогда
					Если Выборка.Амортизационная = Истина Тогда
						Номинал = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(Выборка.ЦБ.Объект, НаДату);
						СуммаНоминал = Номинал * Выборка.КоличествоОстаток;
					Иначе
						Номинал = Выборка.Номинал;
						СуммаНоминал = Выборка.СуммаНоминал;
					КонецЕсли;
				Иначе
					Номинал = 0;
					СуммаНоминал = Выборка.СуммаНоминал;
				КонецЕсли;
				ПараметрыОбласти.Номинал = Номинал;
				
				// ОПТИМИЗАЦИЯ: Расчет финансовых показателей
				Дисконт = Выборка.СуммаЦеннаяБумага - СуммаНоминал;
				АмортДисконт = Выборка.СуммаАмортизацииДисконта;
				Премия = Выборка.СуммаПремия - Выборка.СуммаАмортизацииПремии;
				АмортПремия = Выборка.СуммаАмортизацииПремии;
				
				// ОПТИМИЗАЦИЯ: Расчет баланса разбит на части для читаемости (соответствие SonarQube)
				Баланс = СуммаНоминал
					+ Премия
					+ Дисконт
					+ АмортДисконт
					+ АмортПремия
					+ Выборка.УКД
					+ Выборка.НКД
					+ Выборка.СуммаПоложитКорректировки
					+ Выборка.СуммаОтрицательнойКорректировки
					+ Выборка.СуммаПоложительнойПереоценки
					+ Выборка.СуммаОтрицательнойПереоценки
					+ Выборка.ИндексацияНоминала_Доход_СуммаОборотКт;
				
				// ОПТИМИЗАЦИЯ: Условная логика для разных типов ЦБ
				Если ЯвляетсяАкциейИлиДР Тогда
					ПараметрыОбласти.СуммаНоминал = СуммаНоминал + Дисконт;
					ИтСуммаНоминал = ИтСуммаНоминал + СуммаНоминал + Дисконт;
				Иначе
					ПараметрыОбласти.СуммаНоминал = СуммаНоминал;
					ПараметрыОбласти.Дисконт = Дисконт;
					ИтДисконт = ИтДисконт + Дисконт;
					ИтСуммаНоминал = ИтСуммаНоминал + СуммаНоминал;
				КонецЕсли;
				
				// ОПТИМИЗАЦИЯ: Заполнение параметров области
				ПараметрыОбласти.Премия = Премия;
				ПараметрыОбласти.АмортДисконт = АмортДисконт;
				ПараметрыОбласти.АмортПремия = АмортПремия;
				ПараметрыОбласти.ИтБаланс = Баланс;
				ПараметрыОбласти.ЭСП = Формат(Выборка.ЭСП, "ЧДЦ=15");
				
				// ОПТИМИЗАЦИЯ: Форматирование дат
				ПараметрыОбласти.ПечДатаПогашения = Формат(Выборка.ДатаПогашения, "ДЛФ=Д");
				ПараметрыОбласти.печДатаОферты = Формат(Выборка.ДатаОферты, "ДЛФ=Д");
				
				// ОПТИМИЗАЦИЯ: Расчет дней до погашения/оферты (использование константы вместо магического числа)
				ПартияДатаЗаполнена = ЗначениеЗаполнено(Выборка.ПартияДата);
				Если ПартияДатаЗаполнена И ЗначениеЗаполнено(Выборка.ДатаПогашения) Тогда
					ПараметрыОбласти.печДнейДоПогашения = (Выборка.ДатаПогашения - Выборка.ПартияДата) / КонстантаСекундВДне;
				КонецЕсли;
				
				Если ПартияДатаЗаполнена И ЗначениеЗаполнено(Выборка.ДатаОферты) Тогда
					ПараметрыОбласти.печДнейДоОферты = (Выборка.ДатаОферты - Выборка.ПартияДата) / КонстантаСекундВДне;
				КонецЕсли;
				
				ПолеРезультат.Вывести(ОблатьДанных);
				
				// ОПТИМИЗАЦИЯ: Накопление итогов
				ИтПремия = ИтПремия + Премия;
				ИтАмортДисконт = ИтАмортДисконт + АмортДисконт;
				ИтАмортПремия = ИтАмортПремия + АмортПремия;
				ИтБаланс = ИтБаланс + Баланс;
				
			КонецЦикла;
			
		КонецЦикла;
		
		// ОПТИМИЗАЦИЯ: Формирование итогов по группе
		ОблатьДанных = Макет.ПолучитьОбласть("ИтогоГруппа");
		ПараметрыОбласти = ОблатьДанных.Параметры;
		ПараметрыОбласти.Заполнить(ВыборкаИт);
		
		// ИЗМЕНЕНИЕ: Добавлен пробел перед "итого:" для единообразия форматирования
		ПараметрыОбласти.ТипАктива = ВыборкаИт.СчетНаименование + " итого:";
		ПараметрыОбласти.Дисконт = ИтДисконт;
		ПараметрыОбласти.Премия = ИтПремия;
		ПараметрыОбласти.АмортДисконт = ИтАмортДисконт;
		ПараметрыОбласти.АмортПремия = ИтАмортПремия;
		ПараметрыОбласти.СуммаНоминал = ИтСуммаНоминал;
		ПараметрыОбласти.ИтБаланс = ИтБаланс;
		
		ПолеРезультат.Вывести(ОблатьДанных);
		
		// ОПТИМИЗАЦИЯ: Накопление общих итогов (более читаемый код)
		ВсегоИтого.итДисконт = ВсегоИтого.итДисконт + ИтДисконт;
		ВсегоИтого.итПремия = ВсегоИтого.итПремия + ИтПремия;
		ВсегоИтого.итАмортДисконт = ВсегоИтого.итАмортДисконт + ИтАмортДисконт;
		ВсегоИтого.итАмортПремия = ВсегоИтого.итАмортПремия + ИтАмортПремия;
		ВсегоИтого.итСуммаНоминал = ВсегоИтого.итСуммаНоминал + ИтСуммаНоминал;
		ВсегоИтого.итВсегоБаланс = ВсегоИтого.итВсегоБаланс + ИтБаланс;
		ВсегоИтого.итУКД = ВсегоИтого.итУКД + ВыборкаИт.УКД;
		ВсегоИтого.итНКД = ВсегоИтого.итНКД + ВыборкаИт.НКД;
		ВсегоИтого.итСуммаПоложитКорректировки = ВсегоИтого.итСуммаПоложитКорректировки + ВыборкаИт.СуммаПоложитКорректировки;
		ВсегоИтого.итСуммаОтрицательнойКорректировки = ВсегоИтого.итСуммаОтрицательнойКорректировки + ВыборкаИт.СуммаОтрицательнойКорректировки;
		ВсегоИтого.итСуммаПоложительнойПереоценки = ВсегоИтого.итСуммаПоложительнойПереоценки + ВыборкаИт.СуммаПоложительнойПереоценки;
		ВсегоИтого.итСуммаОтрицательнойПереоценки = ВсегоИтого.итСуммаОтрицательнойПереоценки + ВыборкаИт.СуммаОтрицательнойПереоценки;
		ВсегоИтого.итИндексацияНоминала_Доход_СуммаОборотКт = ВсегоИтого.итИндексацияНоминала_Доход_СуммаОборотКт + ВыборкаИт.ИндексацияНоминала_Доход_СуммаОборотКт;
		
	КонецЦикла;
	
	// ОПТИМИЗАЦИЯ: Формирование итоговой строки
	ОблатьДанных = Макет.ПолучитьОбласть("ВсегоГруппа");
	ОблатьДанных.Параметры.Заполнить(ВсегоИтого);
	ОблатьДанных.Параметры.ТипАктива = "ИТОГО:";
	ПолеРезультат.Вывести(ОблатьДанных);
	
	ПолеРезультат.ТолькоПросмотр = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	СформироватьОтчетНаСервере_Оптимизированный();
КонецПроцедуры