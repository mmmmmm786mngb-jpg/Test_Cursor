// Описание: Формирует условие для запроса с учетом ВЫРАЗИТЬ для ссылочных типов субконто
//
// Параметры:
//  Параметры - Структура - Параметры с отбором аналитики
//  Запрос - Запрос - Объект запроса для установки параметров
//
// Возвращаемое значение:
//  Строка - Сформированное условие для подстановки в текст запроса
//
Функция СформироватьУсловиеСВыразить(Параметры, Запрос) Экспорт
	
	Условие = "Портфель = &Портфель";
	Если НЕ Параметры.ЗаполнениеПоОперациямЗаДень Тогда
		Если ЗначениеЗаполнено(Параметры.Отбор.Аналитика) Тогда
			Для Каждого КлючЗначение Из Параметры.Отбор.Аналитика Цикл
				ИмяСубконто = КлючЗначение.Ключ;
				ЗначениеСубконто = КлючЗначение.Значение;
				
				Если НЕ ВозможноВыразить(ЗначениеСубконто) Тогда
					Условие = Условие + " И " + ИмяСубконто + " В (&" + ИмяСубконто + ")";
					Запрос.УстановитьПараметр(ИмяСубконто, ЗначениеСубконто);
					Продолжить;
				КонецЕсли;
				
				БазовоеЗначение = ?(ТипЗнч(ЗначениеСубконто) = Тип("Массив") И ЗначениеСубконто.Количество() > 0,
						ЗначениеСубконто[0], ЗначениеСубконто);
				
				ТипМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(БазовоеЗначение));
				СтрокаТипа = ?(ТипМетаданных = Неопределено, "Неопределено", ТипМетаданных.ПолноеИмя());
				
				НужноВыразить = СтрНайти(СтрокаТипа, "Справочник") > 0
					ИЛИ СтрНайти(СтрокаТипа, "Документ") > 0
					ИЛИ СтрНайти(СтрокаТипа, "Перечисление") > 0;
				
				Если НужноВыразить Тогда
					Условие = Условие + " И ВЫРАЗИТЬ(" + ИмяСубконто + " КАК " + СтрокаТипа + ") В (&" + ИмяСубконто + ")";
				Иначе
					Условие = Условие + " И " + ИмяСубконто + " В (&" + ИмяСубконто + ")";
				КонецЕсли;
				
				Запрос.УстановитьПараметр(ИмяСубконто, ЗначениеСубконто);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Условие;
	
КонецФункции

// Описание: Проверяет возможность применения ВЫРАЗИТЬ для значения
//
// Параметры:
//   Значение - Произвольный - Значение для проверки
//
// Возвращаемое значение:
//   Булево - Истина, если можно применять ВЫРАЗИТЬ; Ложь, если нельзя
//
Функция ВозможноВыразить(Значение) Экспорт
	
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Истина;
	КонецЕсли;
	
	КоличествоЭлементов = Значение.Количество();
	
	Если КоличествоЭлементов = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТипПервогоЭлемента = ТипЗнч(Значение[0]);
	
	Для Индекс = 1 По КоличествоЭлементов - 1 Цикл
		ТекущийЭлемент = Значение[Индекс];
		ТипТекущегоЭлемента = ТипЗнч(ТекущийЭлемент);
		
		Если ТипТекущегоЭлемента <> ТипПервогоЭлемента Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции