// Описание: Функция ПланРеглОпераций() для оптимизации - Вариант 2
//           Раннее применение всех условий фильтрации на этапе ВТ_НастройкиПериодичности
//           Модуль: РегистрСведений.НастройкиЗакрытияПериода.МодульМенеджера
//           Файл: ../src/cf/InformationRegisters/НастройкиЗакрытияПериода/Ext/ManagerModule.bsl
//           Функция начинается со строки: 157
//           Проблемная строка: 324 - Результат = Запрос.Выполнить()
//
// Параметры:
//   РеглПериод - СправочникСсылка.РегламентныеПериоды, Дата - период закрытия
//   СписокПортфелей - Массив - массив портфелей для обработки
//   Группа - СправочникСсылка.ВидыОперацийЗакрытияПериода, Неопределено - группа операций (опционально, по умолчанию Неопределено)
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с планом регламентных операций с полями:
//     Портфель - Портфель - портфель для операции
//     ВидОперации - ВидОперации - вид операции закрытия периода
//     Выполнять - Число - признак выполнения (1 или 0)
//     ВремяРеглОперации - Время - время выполнения регламентной операции
//     Родитель - ВидыОперацийЗакрытияПериода, Неопределено - родительская операция
//
Функция ПланРеглОпераций(Знач РеглПериод, СписокПортфелей, Группа = Неопределено) Экспорт
	
	Если ТипЗнч(РеглПериод) = Тип("СправочникСсылка.РегламентныеПериоды") Тогда
		ДатаПериода = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеглПериод, "ДатаПериода");
	Иначе
		ДатаПериода = РеглПериод;
	КонецЕсли;
	
	ТаблицаДополнительныхОпераций = Справочники.НастройкиДополнительныхРегламентныхОпераций.ДополнительныеРегламентныеОперации(СписокПортфелей, ДатаПериода);
	
	ОперацииВДатуЗакрытия = Новый Массив;
	ОперацииВДатуЗакрытия.Добавить(Справочники.ВидыОперацийЗакрытияПериода.ЗакрытиеСчета90_БУ);
	ОперацииВДатуЗакрытия.Добавить(Справочники.ВидыОперацийЗакрытияПериода.ЗакрытиеСчета90_НУ);
	ОперацииВДатуЗакрытия.Добавить(Справочники.ВидыОперацийЗакрытияПериода.ЗакрытиеСчета91_БУ);
	ОперацииВДатуЗакрытия.Добавить(Справочники.ВидыОперацийЗакрытияПериода.ЗакрытиеСчета91_НУ);
	ОперацииВДатуЗакрытия.Добавить(Справочники.ВидыОперацийЗакрытияПериода.ОпределениеФинансовогоРезультата_БУ);
	ОперацииВДатуЗакрытия.Добавить(Справочники.ВидыОперацийЗакрытияПериода.ОпределениеФинансовогоРезультата_НУ);
	ОперацииВДатуЗакрытия.Добавить(Справочники.ВидыОперацийЗакрытияПериода.РеинвестированиеПриЗакрытииГода_БУ);
	ОперацииВДатуЗакрытия.Добавить(Справочники.ВидыОперацийЗакрытияПериода.СписаниеНаНераспределеннуюПрибыльНепокрытыйУбыток);
	
	ПериодичностиИсключения = Новый Массив;
	ПериодичностиИсключения.Добавить(Справочники.НастройкиПериодичности.ПустаяСсылка());
	ПериодичностиИсключения.Добавить(Справочники.НастройкиПериодичности.Никогда);
	
	// ОПТИМИЗАЦИЯ: Предвычисление даты начала периода дня
	ДатаПериодаДень = НачалоДня(ДатаПериода);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаАктуальности", ДатаПериода);
	Запрос.УстановитьПараметр("ДатаПериодаДень", ДатаПериодаДень);
	Запрос.УстановитьПараметр("СписокПортфелей", СписокПортфелей);
	Запрос.УстановитьПараметр("Группа", Группа);
	Запрос.УстановитьПараметр("ОперацииВДатуЗакрытия", ОперацииВДатуЗакрытия);
	Запрос.УстановитьПараметр("ПериодичностиИсключения", ПериодичностиИсключения);
	Запрос.УстановитьПараметр("ТаблицаДополнительныхОпераций", ТаблицаДополнительныхОпераций);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаДополнительныхОпераций.Портфель КАК Портфель,
		|	ТаблицаДополнительныхОпераций.ВидОперации КАК ВидОперации
		|ПОМЕСТИТЬ ВТ_ДополнительныеОперации
		|ИЗ
		|	&ТаблицаДополнительныхОпераций КАК ТаблицаДополнительныхОпераций
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// ОПТИМИЗАЦИЯ: Предварительная подготовка временных таблиц для эффективных JOIN
		|// ВТ_ВсеВидыПериодичности - все различные ВидПериодичности из регистра
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КэшВидовПериодичности.ВидПериодичности КАК ВидПериодичности
		|ПОМЕСТИТЬ ВТ_ВсеВидыПериодичности
		|ИЗ
		|	РегистрСведений.КэшВидовПериодичности КАК КэшВидовПериодичности
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ВидПериодичности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// ВТ_ВидыПериодичностиНаДату - ВидПериодичности отфильтрованные по дате
		|ВЫБРАТЬ
		|	КэшВидовПериодичности.ВидПериодичности КАК ВидПериодичности
		|ПОМЕСТИТЬ ВТ_ВидыПериодичностиНаДату
		|ИЗ
		|	РегистрСведений.КэшВидовПериодичности КАК КэшВидовПериодичности
		|ГДЕ
		|	КэшВидовПериодичности.ДатаПериодичности = &ДатаПериодаДень
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ВидПериодичности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// ОПТИМИЗАЦИЯ: Ранняя фильтрация на этапе ВТ_НастройкиПериодичности
		|// Учитываем оба варианта: либо периодичность на дату, либо операции в дату закрытия
		|ВЫБРАТЬ
		|	НастройкиЗакрытияПериодаСрезПоследних.Регламент КАК Регламент,
		|	НастройкиЗакрытияПериодаСрезПоследних.Портфель КАК Портфель,
		|	НастройкиЗакрытияПериодаСрезПоследних.ВидОперации КАК ВидОперации,
		|	НастройкиЗакрытияПериодаСрезПоследних.Периодичность КАК Периодичность
		|ПОМЕСТИТЬ ВТ_НастройкиПериодичности
		|ИЗ
		|	РегистрСведений.НастройкиЗакрытияПериода.СрезПоследних(&ДатаАктуальности, Портфель В (&СписокПортфелей)) КАК НастройкиЗакрытияПериодаСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВсеВидыПериодичности КАК ВТ_ВсеВидыПериодичности
		|		ПО НастройкиЗакрытияПериодаСрезПоследних.Периодичность = ВТ_ВсеВидыПериодичности.ВидПериодичности
		|			И НЕ НастройкиЗакрытияПериодаСрезПоследних.Периодичность В (&ПериодичностиИсключения)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВидыПериодичностиНаДату КАК ВТ_ВидыПериодичностиНаДату
		|		ПО НастройкиЗакрытияПериодаСрезПоследних.Периодичность = ВТ_ВидыПериодичностиНаДату.ВидПериодичности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыОперацийЗакрытияПериода КАК ВидыОперацийЗакрытияПериода
		|		ПО НастройкиЗакрытияПериодаСрезПоследних.ВидОперации = ВидыОперацийЗакрытияПериода.Ссылка
		|			И ВидыОперацийЗакрытияПериода.Родитель <> ЗНАЧЕНИЕ(Справочник.ВидыОперацийЗакрытияПериода.КУдалению)
		|			И &ОтборПоГруппе
		|ГДЕ
		|	// Условие 1: Периодичность попадает на дату (есть в ВТ_ВидыПериодичностиНаДату)
		|	// ИЛИ
		|	// Условие 2: Операция в дату закрытия (ВидОперации В ОперацииВДатуЗакрытия И Портфель.ДатаОкончания = ДатаПериодаДень)
		|	(ВТ_ВидыПериодичностиНаДату.ВидПериодичности ЕСТЬ НЕ NULL
		|		ИЛИ (НастройкиЗакрытияПериодаСрезПоследних.ВидОперации В (&ОперацииВДатуЗакрытия)
		|			И НастройкиЗакрытияПериодаСрезПоследних.Портфель.ДатаОкончания = &ДатаПериодаДень))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Регламент,
		|	Портфель,
		|	ВидОперации
		|;
		|// Порядок индекса соответствует JOIN (Регламент, Портфель, ВидОперации - строки 148-150)
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_НастройкиПериодичности.Портфель КАК Портфель,
		|	ВТ_НастройкиПериодичности.ВидОперации КАК ВидОперации,
		|	МАКСИМУМ(ВТ_НастройкиПериодичности.Регламент) КАК Регламент
		|ПОМЕСТИТЬ ВТ_НастройкиПериодичностиПоРегламенту
		|ИЗ
		|	ВТ_НастройкиПериодичности КАК ВТ_НастройкиПериодичности
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_НастройкиПериодичности.Портфель,
		|	ВТ_НастройкиПериодичности.ВидОперации
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Регламент,
		|	Портфель,
		|	ВидОперации
		|;
		|// Порядок индекса соответствует JOIN (Регламент, Портфель, ВидОперации - строки 148-150)
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_НастройкиПериодичности.Регламент КАК Регламент,
		|	ВТ_НастройкиПериодичности.Портфель КАК Портфель,
		|	ВТ_НастройкиПериодичности.ВидОперации КАК ВидОперации,
		|	ВТ_НастройкиПериодичности.Периодичность КАК Периодичность
		|ПОМЕСТИТЬ ВТ_АктуальныеВидыОпераций
		|ИЗ
		|	ВТ_НастройкиПериодичности КАК ВТ_НастройкиПериодичности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НастройкиПериодичностиПоРегламенту КАК ВТ_НастройкиПериодичностиПоРегламенту
		|		ПО ВТ_НастройкиПериодичности.Регламент = ВТ_НастройкиПериодичностиПоРегламенту.Регламент
		|			И ВТ_НастройкиПериодичности.Портфель = ВТ_НастройкиПериодичностиПоРегламенту.Портфель
		|			И ВТ_НастройкиПериодичности.ВидОперации = ВТ_НастройкиПериодичностиПоРегламенту.ВидОперации
		|// УСЛОВИЯ ФИЛЬТРАЦИИ ПЕРЕНЕСЕНЫ ВЫШЕ: фильтрация по Родителю выполнена на этапе ВТ_НастройкиПериодичности (строка 108-110)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Периодичность,
		|	Портфель,
		|	ВидОперации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// ОПТИМИЗАЦИЯ: Единый запрос без разделения на части, так как фильтрация уже выполнена на этапе ВТ_НастройкиПериодичности
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ВТ_АктуальныеВидыОпераций.Регламент
		|				ИЛИ ВидыОперацийЗакрытияПериода.ИспользоватьВнешнююОбработку = ИСТИНА
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Выполнять,
		|	ВТ_АктуальныеВидыОпераций.Портфель КАК Портфель,
		|	ВТ_АктуальныеВидыОпераций.ВидОперации КАК ВидОперации,
		|	ВидыОперацийЗакрытияПериода.Родитель.ВремяРеглОпераций КАК ВремяРеглОпераций,
		|	ВЫБОР
		|		КОГДА ВидыОперацийЗакрытияПериода.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыОперацийЗакрытияПериода.РегламентныеОперацииДУ)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ВидыОперацийЗакрытияПериода.Родитель
		|	КОНЕЦ КАК Родитель
		|ПОМЕСТИТЬ ВТ_ОбъединенныеВидыОпераций
		|ИЗ
		|	ВТ_АктуальныеВидыОпераций КАК ВТ_АктуальныеВидыОпераций
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыОперацийЗакрытияПериода КАК ВидыОперацийЗакрытияПериода
		|		ПО ВТ_АктуальныеВидыОпераций.ВидОперации = ВидыОперацийЗакрытияПериода.Ссылка
		|// УСЛОВИЯ ПЕРЕНЕСЕНЫ ВЫШЕ: фильтрация выполнена на этапе ВТ_АктуальныеВидыОпераций (строка 156-157)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	1,
		|	ВТ_ДополнительныеОперации.Портфель,
		|	ВТ_ДополнительныеОперации.ВидОперации,
		|	ВидыОперацийЗакрытияПериода.Родитель.ВремяРеглОпераций,
		|	ВЫБОР
		|		КОГДА ВидыОперацийЗакрытияПериода.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыОперацийЗакрытияПериода.РегламентныеОперацииДУ)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ВидыОперацийЗакрытияПериода.Родитель
		|	КОНЕЦ
		|ИЗ
		|	ВТ_ДополнительныеОперации КАК ВТ_ДополнительныеОперации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыОперацийЗакрытияПериода КАК ВидыОперацийЗакрытияПериода
		|		ПО ВТ_ДополнительныеОперации.ВидОперации = ВидыОперацийЗакрытияПериода.Ссылка
		|			И ВидыОперацийЗакрытияПериода.Родитель <> ЗНАЧЕНИЕ(Справочник.ВидыОперацийЗакрытияПериода.КУдалению)
		|			И &ОтборПоГруппе
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Портфель,
		|	ВидОперации,
		|	ВремяРеглОпераций,
		|	Родитель
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ВТ_ОбъединенныеВидыОпераций.Выполнять) КАК Выполнять,
		|	ВТ_ОбъединенныеВидыОпераций.Портфель КАК Портфель,
		|	ВТ_ОбъединенныеВидыОпераций.ВидОперации КАК ВидОперации,
		|	ВТ_ОбъединенныеВидыОпераций.ВремяРеглОпераций КАК ВремяРеглОпераций,
		|	ВТ_ОбъединенныеВидыОпераций.Родитель КАК Родитель
		|ИЗ
		|	ВТ_ОбъединенныеВидыОпераций КАК ВТ_ОбъединенныеВидыОпераций
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ОбъединенныеВидыОпераций.Портфель,
		|	ВТ_ОбъединенныеВидыОпераций.ВидОперации,
		|	ВТ_ОбъединенныеВидыОпераций.ВремяРеглОпераций,
		|	ВТ_ОбъединенныеВидыОпераций.Родитель";
	
	ОтборПоГруппеТекст = ?(ЗначениеЗаполнено(Группа), "ВидыОперацийЗакрытияПериода.Родитель = &Группа", "Истина");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоГруппе", ОтборПоГруппеТекст);
	
	Результат = Запрос.Выполнить();
	
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "НастройкиЗакрытияПериода - План регламентных операций.");
	
	Возврат Результат.Выгрузить();
	
КонецФункции
