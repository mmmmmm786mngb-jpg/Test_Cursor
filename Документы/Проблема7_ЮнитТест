Процедура Тест_СравнениеЗапросов_АмортизацияКомиссийРЕПО() Экспорт
	
	// === 1. Подготовка параметров ===
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Портфель", Портфель);
	Запрос.УстановитьПараметр("ДатаДок", Дата);
	Запрос.УстановитьПараметр("ЕПС", Истина);
	Запрос.УстановитьПараметр("БУ", Истина);
	
	Счета19 = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Счета19, ПланыСчетов.ЕПС.СчетаУчетаКомиссийПоСделкамОбратныйРЕПО());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Счета19, ПланыСчетов.ЕПС.СчетаУчетаКомиссийПоСделкамПрямойРЕПО());
	Запрос.УстановитьПараметр("Счета19", Счета19);
	Запрос.УстановитьПараметр("Счет_76_15", ПланыСчетов.Хозрасчетный.КомиссииПоСделкамРЕПО);
	Запрос.УстановитьПараметр("ВидыСубконтоЕПС", Новый Массив);
	Запрос.УстановитьПараметр("ВидыСубконтоХозрасчетные", Новый Массив);
	
	// === 2. СТАРЫЙ ЗАПРОС + ЦИКЛ ===
	Запрос.Текст = ЗаполнитьСделкиРЕПО_ТекстЗапроса(); // ← старая функция
	ТаблицаСтарая = Запрос.Выполнить().Выгрузить();
	
	// ← ИМИТИРУЕМ СТАРЫЙ ЦИКЛ
	Для Каждого ТекСтрока Из ТаблицаСтарая Цикл
		КоличествоДнейВсего = ОбщегоНазначенияДУ.КоличествоПериодов(ТекСтрока.ДатаОплатыКомиссии, ТекСтрока.ДатаПеререгистрацииВторойЧасти, "День") - 1;
		КоличествоДней = Мин(ОбщегоНазначенияДУ.КоличествоПериодов(ТекСтрока.ДатаОплатыКомиссии, Дата, "День") - 1, КоличествоДнейВсего);
		
		Если КоличествоДней * КоличествоДнейВсего <= 0 Тогда
			ТекСтрока.СуммаАмортизации = 0;
		Иначе
			ТекСтрока.СуммаАмортизации = ТекСтрока.НачальнаяСуммаКомиссии * КоличествоДней / КоличествоДнейВсего;
		КонецЕсли;
	КонецЦикла;
	
	// === 3. НОВЫЙ ЗАПРОС ===
	Запрос.Текст = 
		"// [ВСТАВЬ СЮДА ПОЛНЫЙ ТЕКСТ НОВОГО ЗАПРОСА С -1 В РАЗНОСТЬДАТ]";
	ТаблицаНовая = Запрос.Выполнить().Выгрузить();
	
	// === 4. СРАВНЕНИЕ ===
	
	// 4.1. Количество строк
	Если ТаблицаСтарая.Количество() <> ТаблицаНовая.Количество() Тогда
		Сообщить("ОШИБКА: Количество строк не совпадает! Старая: " + ТаблицаСтарая.Количество() + ", Новая: " + ТаблицаНовая.Количество());
		Возврат;
	КонецЕсли;
	
	// 4.2. Сравнение по ключу (на случай разного порядка)
	ТаблицаСтарая.Индексы.Добавить("ДокументОплаты");
	ТаблицаНовая.Индексы.Добавить("ДокументОплаты");
	
	Различия = 0;
	
	Для Каждого СтрокаСтарая Из ТаблицаСтарая Цикл
		СтрокиНовые = ТаблицаНовая.НайтиСтроки(Новый Структура("ДокументОплаты", СтрокаСтарая.ДокументОплаты));
		Если СтрокиНовые.Количество() = 0 Тогда
			Сообщить("ОШИБКА: Документ не найден в новом запросе: " + СтрокаСтарая.ДокументОплаты);
			Различия = Различия + 1;
			Продолжить;
		КонецЕсли;
		
		СтрокаНовая = СтрокиНовые[0];
		
		// Сравниваем ключевые поля
		Если Не ПоляРавны(СтрокаСтарая.НачальнаяСуммаКомиссии, СтрокаНовая.НачальнаяСуммаКомиссии, "НачальнаяСуммаКомиссии") Тогда Различия = Различия + 1; КонецЕсли;
		Если Не ПоляРавны(СтрокаСтарая.СуммаАмортизации, СтрокаНовая.СуммаАмортизации, "СуммаАмортизации", 0.01) Тогда Различия = Различия + 1; КонецЕсли;
		Если Не ПоляРавны(СтрокаСтарая.ОстатокКомиссииЕПС, СтрокаНовая.ОстатокКомиссииЕПС, "ОстатокЕПС") Тогда Различия = Различия + 1; КонецЕсли;
		Если Не ПоляРавны(СтрокаСтарая.ОстатокКомиссииБУ, СтрокаНовая.ОстатокКомиссииБУ, "ОстатокБУ") Тогда Различия = Различия + 1; КонецЕсли;
		Если Не ПоляРавны(СтрокаСтарая.СтатьяЗатрат, СтрокаНовая.СтатьяЗатрат, "СтатьяЗатрат") Тогда Различия = Различия + 1; КонецЕсли;
	КонецЦикла;
	
	// === 5. РЕЗУЛЬТАТ ===
	Если Различия = 0 Тогда
		Сообщить("УСПЕХ: Данные полностью идентичны! (" + ТаблицаСтарая.Количество() + " строк)");
	Иначе
		Сообщить("ОШИБКА: Найдено " + Различия + " различий.");
	КонецЕсли;
	
КонецПроцедуры

// Вспомогательная функция
Функция ПоляРавны(Знач1, Знач2, Имя, Допуск = 0)
	Если ТипЗнч(Знач1) = Тип("Число") И ТипЗнч(Знач2) = Тип("Число") Тогда
		Если Окр(Знач1 - Знач2, 6) <> 0 И Допуск = 0 Тогда
			Сообщить("   Различие в " + Имя + ": " + Знач1 + " ≠ " + Знач2);
			Возврат Ложь;
		ИначеЕсли Math.Abs(Знач1 - Знач2) > Допуск Тогда
			Сообщить("   Различие в " + Имя + " (допуск " + Допуск + "): " + Знач1 + " ≠ " + Знач2);
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли Знач1 <> Знач2 Тогда
		Сообщить("   Различие в " + Имя + ": " + Знач1 + " ≠ " + Знач2);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции
