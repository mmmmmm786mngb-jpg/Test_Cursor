// Функция - Отфильтровать обороты
//
// Описание: Фильтрует таблицу оборотов по заданным условиям, используя Запрос к временной таблице.
//           Поддерживает условия через точку (напр. "КорСубконто1.ВидАктива") и различные виды сравнения.
//
// Параметры:
//  ТаблицаОборотов - ТаблицаЗначений - Исходная таблица оборотов
//  Условия         - Структура или Массив - Условия отбора
//
// Возвращаемое значение:
//  ТаблицаЗначений - Отфильтрованная таблица оборотов
//
Функция ОтфильтроватьОбороты(ТаблицаОборотов, Условия)
	
	// Создаем структуру результирующей таблицы (копируем колонки)
	Результат = ТаблицаОборотов.СкопироватьКолонки();
	
	// Нормализуем условия в массив
	МассивУсловий = Условия;
	Если ТипЗнч(Условия) = Тип("Структура") Тогда
		МассивУсловий = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Условия);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	// 1. Помещаем исходную таблицу в ВТ
	Запрос.УстановитьПараметр("ТЗ_Исходная", ТаблицаОборотов);
	Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Обороты ИЗ &ТЗ_Исходная КАК ТЗ";
	Запрос.Выполнить();
	
	// 2. Итерируемся по наборам условий (логика ИЛИ между элементами массива условий)
	Для Каждого Условие Из МассивУсловий Цикл
		
		ТекстГде = "";
		СчетчикПараметров = 0;
		
		Для Каждого Элемент Из Условие.Отборы Цикл
			
			// Пропускаем пустые значения
			Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяПоля = Элемент.Ключ;
			ЗначениеОтбора = Элемент.Значение;
			ВидСравненияОтбора = ВидСравнения.Равно; // По умолчанию
			
			// Определение значения и вида сравнения (работает и для ЗначениеСВидомСравнения, т.к. это Структура)
			Если ТипЗнч(ЗначениеОтбора) = Тип("Структура") Тогда
				Если ЗначениеОтбора.Свойство("ВидСравнения") Тогда
					ВидСравненияОтбора = ЗначениеОтбора.ВидСравнения;
				КонецЕсли;
				Если ЗначениеОтбора.Свойство("Значение") Тогда
					ЗначениеОтбора = ЗначениеОтбора.Значение;
				КонецЕсли;
			КонецЕсли;
			
			// Формируем уникальное имя параметра для запроса
			ИмяПараметра = "П_" + СтрЗаменить(ИмяПоля, ".", "_") + "_" + Формат(СчетчикПараметров, "ЧГ=0");
			
			Если ТекстГде <> "" Тогда
				ТекстГде = ТекстГде + " И ";
			КонецЕсли;
			
			// Генерация условия WHERE в зависимости от ВидаСравнения
			Если ВидСравненияОтбора = ВидСравнения.Равно Тогда
				ТекстГде = ТекстГде + "Т." + ИмяПоля + " = &" + ИмяПараметра;
				
			ИначеЕсли ВидСравненияОтбора = ВидСравнения.НеРавно Тогда
				ТекстГде = ТекстГде + "Т." + ИмяПоля + " <> &" + ИмяПараметра;
				
			ИначеЕсли ВидСравненияОтбора = ВидСравнения.Больше Тогда
				ТекстГде = ТекстГде + "Т." + ИмяПоля + " > &" + ИмяПараметра;
				
			ИначеЕсли ВидСравненияОтбора = ВидСравнения.БольшеИлиРавно Тогда
				ТекстГде = ТекстГде + "Т." + ИмяПоля + " >= &" + ИмяПараметра;
				
			ИначеЕсли ВидСравненияОтбора = ВидСравнения.Меньше Тогда
				ТекстГде = ТекстГде + "Т." + ИмяПоля + " < &" + ИмяПараметра;
				
			ИначеЕсли ВидСравненияОтбора = ВидСравнения.МеньшеИлиРавно Тогда
				ТекстГде = ТекстГде + "Т." + ИмяПоля + " <= &" + ИмяПараметра;
				
			ИначеЕсли ВидСравненияОтбора = ВидСравнения.ВСписке Тогда
				ТекстГде = ТекстГде + "Т." + ИмяПоля + " В (&" + ИмяПараметра + ")";
				
			ИначеЕсли ВидСравненияОтбора = ВидСравнения.НеВСписке Тогда
				ТекстГде = ТекстГде + " НЕ Т." + ИмяПоля + " В (&" + ИмяПараметра + ")";
				
			ИначеЕсли ВидСравненияОтбора = ВидСравнения.ВИерархии Или ВидСравненияОтбора = ВидСравнения.ВСпискеПоИерархии Тогда
				ТекстГде = ТекстГде + "Т." + ИмяПоля + " В ИЕРАРХИИ (&" + ИмяПараметра + ")";
				
			ИначеЕсли ВидСравненияОтбора = ВидСравнения.НеВИерархии Или ВидСравненияОтбора = ВидСравнения.НеВСпискеПоИерархии Тогда
				ТекстГде = ТекстГде + " НЕ Т." + ИмяПоля + " В ИЕРАРХИИ (&" + ИмяПараметра + ")";
				
			ИначеЕсли ВидСравненияОтбора = ВидСравнения.Содержит Тогда
				ТекстГде = ТекстГде + "Т." + ИмяПоля + " ПОДОБНО &" + ИмяПараметра;
				Если ТипЗнч(ЗначениеОтбора) = Тип("Строка") И СтрНайти(ЗначениеОтбора, "%") = 0 Тогда
					ЗначениеОтбора = "%" + ЗначениеОтбора + "%";
				КонецЕсли;
				
			ИначеЕсли ВидСравненияОтбора = ВидСравнения.НеСодержит Тогда
				ТекстГде = ТекстГде + " НЕ Т." + ИмяПоля + " ПОДОБНО &" + ИмяПараметра;
				Если ТипЗнч(ЗначениеОтбора) = Тип("Строка") И СтрНайти(ЗначениеОтбора, "%") = 0 Тогда
					ЗначениеОтбора = "%" + ЗначениеОтбора + "%";
				КонецЕсли;
				
			Иначе
				ТекстГде = ТекстГде + "Т." + ИмяПоля + " = &" + ИмяПараметра;
			КонецЕсли;
			
			Запрос.УстановитьПараметр(ИмяПараметра, ЗначениеОтбора);
			СчетчикПараметров = СчетчикПараметров + 1;
			
		КонецЦикла;
		
		Запрос.Текст = "ВЫБРАТЬ Т.* ИЗ ВТ_Обороты КАК Т";
		Если ЗначениеЗаполнено(ТекстГде) Тогда
			Запрос.Текст = Запрос.Текст + " ГДЕ " + ТекстГде;
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
