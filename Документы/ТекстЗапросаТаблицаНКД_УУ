Функция ТекстЗапросаТаблицаНКД_УУ()
Возврат
"ВЫБРАТЬ
| ТаблицаДанных.Актив КАК Актив,
| ТаблицаДанных.Облигация КАК Облигация,
| ТаблицаДанных.КупонныйПериод КАК КупонныйПериод,
| ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ТаблицаДанных.УУ) = ТИП(Число) ТОГДА ТаблицаДанных.УУ = 1 ИНАЧЕ ТаблицаДанных.УУ = ИСТИНА КОНЕЦ КАК УУ,
| &ДоговорДУВТаблицеАктивов
|ПОМЕСТИТЬ ТаблицаАктивов
|ИЗ
| &ТаблицаДанных КАК ТаблицаДанных
|ГДЕ
| ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ТаблицаДанных.УУ) = ТИП(Число) ТОГДА ТаблицаДанных.УУ = 1 ИНАЧЕ ТаблицаДанных.УУ = ИСТИНА КОНЕЦ
|
|ИНДЕКСИРОВАТЬ ПО
| Облигация,
| КупонныйПериод,
| ДоговорДУ  // Добавлено: индексация по ДоговорДУ для ускорения соединения
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
| НКД_УУ.ДоговорДУ КАК ДоговорДУ,  // Добавлено: выбор ДоговорДУ
| НКД_УУ.Облигация КАК Облигация,
| НКД_УУ.КупонныйПериод КАК КупонныйПериод,
| ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка) КАК Партия,
| НКД_УУ.Валюта,
| СУММА(НКД_УУ.ВалютнаяСуммаОстаток) КАК ВалютнаяСумма,
| СУММА(НКД_УУ.СуммаОстаток) КАК Сумма,
| ""НачисленныйКупонныйДоходУправленческий"" КАК ИмяРегистра
|ПОМЕСТИТЬ ВТ_ОстаткиНКД
|ИЗ
| РегистрНакопления.НачисленныйКупонныйДоходУправленческий.Остатки(
| &Граница,
| &УсловиеПоДоговору
| И КупонныйПериод В (&КупонныеПериоды)
| И Облигация В (&Облигации)) КАК НКД_УУ
|ГДЕ
| НАЧАЛОПЕРИОДА(НКД_УУ.КупонныйПериод.ДатаОкончанияКупонногоПериода, ДЕНЬ) <= НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
|
|СГРУППИРОВАТЬ ПО
| НКД_УУ.ДоговорДУ,  // Добавлено: группировка по ДоговорДУ
| НКД_УУ.Облигация,
| НКД_УУ.КупонныйПериод,
| НКД_УУ.Валюта
|
|ОБЪЕДИНИТЬ ВСЕ
|
|ВЫБРАТЬ
| УУ_НКДПоЦеннымБумагамHTMОстатки.ДоговорДУ КАК ДоговорДУ,  // Добавлено: выбор ДоговорДУ
| УУ_НКДПоЦеннымБумагамHTMОстатки.Облигация,
| УУ_НКДПоЦеннымБумагамHTMОстатки.КупонныйПериод,
| УУ_НКДПоЦеннымБумагамHTMОстатки.Партия,
| УУ_НКДПоЦеннымБумагамHTMОстатки.Валюта,
| СУММА(УУ_НКДПоЦеннымБумагамHTMОстатки.ВалютнаяСуммаОстаток),
| СУММА(УУ_НКДПоЦеннымБумагамHTMОстатки.СуммаОстаток),
| ""УУ_НКДПоЦеннымБумагамHTM""
|ИЗ
| РегистрНакопления.УУ_НКДПоЦеннымБумагамHTM.Остатки(
| &Граница,
| &УсловиеПоДоговору
| И КупонныйПериод В (&КупонныеПериоды)
| И Облигация В (&Облигации)) КАК УУ_НКДПоЦеннымБумагамHTMОстатки
|ГДЕ
| НАЧАЛОПЕРИОДА(УУ_НКДПоЦеннымБумагамHTMОстатки.КупонныйПериод.ДатаОкончанияКупонногоПериода, ДЕНЬ) <= НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
|
|СГРУППИРОВАТЬ ПО
| УУ_НКДПоЦеннымБумагамHTMОстатки.ДоговорДУ,  // Добавлено: группировка по ДоговорДУ
| УУ_НКДПоЦеннымБумагамHTMОстатки.Облигация,
| УУ_НКДПоЦеннымБумагамHTMОстатки.КупонныйПериод,
| УУ_НКДПоЦеннымБумагамHTMОстатки.Валюта,
| УУ_НКДПоЦеннымБумагамHTMОстатки.Партия
|
|ИНДЕКСИРОВАТЬ ПО
| Облигация,
| КупонныйПериод,
| ДоговорДУ  // Добавлено: индексация по ДоговорДУ
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
| ВТ_ОстаткиНКД.Облигация,
| ВТ_ОстаткиНКД.КупонныйПериод,
| ВТ_ОстаткиНКД.Партия,
| ВТ_ОстаткиНКД.Валюта КАК Валюта,
| ВТ_ОстаткиНКД.ВалютнаяСумма КАК ВалютнаяСумма,
| ВТ_ОстаткиНКД.Сумма КАК Сумма,
| ТаблицаАктивов.УУ КАК УУ,
| ВТ_ОстаткиНКД.ИмяРегистра КАК ИмяРегистра,
| ТаблицаАктивов.ДоговорДУ КАК ДоговорДУ
|ИЗ
| ВТ_ОстаткиНКД КАК ВТ_ОстаткиНКД
| ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаАктивов КАК ТаблицаАктивов
| ПО ВТ_ОстаткиНКД.Облигация = ТаблицаАктивов.Облигация
| И ВТ_ОстаткиНКД.КупонныйПериод = ТаблицаАктивов.КупонныйПериод
| И ВТ_ОстаткиНКД.ДоговорДУ = ТаблицаАктивов.ДоговорДУ  // Добавлено: соединение по ДоговорДУ
";
КонецФункции
