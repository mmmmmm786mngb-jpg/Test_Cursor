{
  // ====================================================================
  // НАСТРОЙКИ BSL LANGUAGE SERVER С ВСТРОЕННЫМ СЕРВЕРОМ
  // Используйте эти настройки, если внешний JAR не работает
  // Версия: 1.0
  // Дата создания: 2025-01-27
  // ====================================================================
  // === АССОЦИАЦИИ ФАЙЛОВ ===
  "files.associations": {
    "*.bsl": "bsl",
    "*.os": "bsl"
  },
  // === НАСТРОЙКИ ЗАПУСКА BSL LANGUAGE SERVER ===
  // ВАРИАНТ: Использование встроенного сервера (автоматическая загрузка)
  // Это может помочь, если внешний JAR не работает
  "language-1c-bsl.downloadLanguageServer": true,
  "language-1c-bsl.server.mode": "auto",
  // === ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ BSL ===
  "language-1c-bsl.completion.enable": true,
  "language-1c-bsl.format.enable": true,
  "language-1c-bsl.diagnostics.enable": false,
  "language-1c-bsl.diagnostics.parameters": {
    "computeDiagnostics": "never"
  },
  // === ЛОГИ И ОТЛАДКА ===
  "language-1c-bsl.trace.client": "off",
  "language-1c-bsl.diagnosticLanguage": "ru",
  "language-1c-bsl.language": "ru"
}








