&НаСервере
Функция КолвоЯдерНаСервере() Экспорт
    Попытка
        // Создаём COM-объект для запуска PowerShell
        WshShell = Новый COMОбъект("WScript.Shell");

        // Команда PowerShell, которая возвращает сумму всех ядер
        Команда = "powershell -Command ""(Get-CimInstance Win32_Processor | Measure-Object -Property NumberOfCores -Sum).Sum""";

        // Запуск процесса
        Процесс = WshShell.Exec(Команда);

        // Чтение стандартного вывода
        Вывод = "";
        Пока Не Процесс.StdOut.AtEndOfStream Цикл
            Вывод = Вывод + Процесс.StdOut.ReadLine();
        КонецЦикла;

        // Убираем пробелы и невидимые символы
        Вывод = СокрЛП(Вывод);
        Вывод = СтрЗаменить(Вывод, Символ(13), ""); // удаляем возврат каретки

        // Преобразуем в число
        Если Вывод <> "" Тогда
            Возврат Число(Вывод);
        Иначе
            Сообщить("Не удалось получить число ядер из PowerShell");
            Возврат Неопределено;
        КонецЕсли;

    Исключение
        Сообщить("Ошибка при получении количества ядер: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
КонецФункции
&НаКлиенте
Процедура КолвоЯдер(Команда)
    Колво = КолвоЯдерНаСервере();
    Если Колво <> Неопределено Тогда
        Сообщить("Количество ядер на сервере: " + Колво);
    Иначе
        Сообщить("Не удалось определить количество ядер.");
    КонецЕсли;
КонецПроцедуры
